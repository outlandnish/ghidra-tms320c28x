#
# Portions adapted from mwdmwd/ghidra-c28x (Apache-2.0): the ST0/ST1 pack/unpack
# macros (packst0/unpackst0/packst1/unpackst1) and their wiring on PUSH|POP ST0|ST1,
# the per-flag SETC|CLRC #imm8 bodies, the decoded-signed PM convention used by SPM,
# and the three-variant LB *XAR7 split dispatched by the ffc_return /
# switch_canonical context bits; the @AH / @AL destination split on PREAD and XPREAD
# that gives SPRU430F's exact N/Z rule; and the 0x3F program page on XPREAD / XMAC /
# XMACD. See THIRD-PARTY.md.
#
# Additional C28x instructions seen in the real firmware (DIR/PM) but not in the
# core families. Encodings verified against docs/c28x/ch6_instruction_detail.txt.
# Included by tms320c28x.sinc.
#
# Identified from the dis2000 ground-truth mnemonic histogram of DIR: LC/LB (long
# call/branch, absolute 22-bit), MOVZ, MOVDL, MOVAD, DMOV, SUBU/SUBB/ADDB, SUBCU,
# MPYXU, XMACD, MOVB byte stores.

# --- 22-bit absolute call/branch target -------------------------------------
# LC/LB 22bit: word1 low 6 bits (loc_off6) = addr[21:16], word2 (imm16) = addr[15:0].
# Same full-instruction destination-subtable idiom as LCR/FFC in flow.sinc (see the long
# pattern-size comment there): the subtable matches the WHOLE 2-word instruction (opcode
# discriminator + loc_off6 ; imm16) and exports a ram varnode at the constant address, so
# Ghidra records a real CALL/JUMP reference. The parent constructor just references it.
lcdest: reloc  is op_hi8=0x00 & op_lo_76=0b10 & loc_off6 ; imm16  [ reloc = (loc_off6 << 16) | imm16; ] { export *[ram]:4 reloc; }
lbdest: reloc  is op_hi8=0x00 & op_lo_76=0b01 & loc_off6 ; imm16  [ reloc = (loc_off6 << 16) | imm16; ] { export *[ram]:4 reloc; }
# Both LC forms invalidate ctx_DP at inst_next -- see flow.sinc LCR for the ABI note.
# LC is a SOFTWARE-STACK call, NOT an RPC call. SPRU430F p.219 is explicit:
#   temp(21:0) = PC + 2; [SP] = temp(15:0); SP += 1; [SP] = temp(21:16); SP += 1
# RPC is never touched -- that is the whole difference between LC/LRET and LCR/LRETR,
# and TI's own note recommends LCR/LRETR instead when OBJMODE=1.
#
# This used to set RPC and leave SP alone, copied from LCR. It did not compose with
# LRET, which pops a 32-bit return address off SP (flow.sinc): the pushed word was
# never written, so LRET returned to whatever happened to sit at the top of the frame.
# The two 16-bit stores are one little-endian 32-bit store here, matching LRET's
# 32-bit read and the PUSH RPC / POP RPC pair below.
:LC lcdest  is rpt_phase=1 & lcdest
        [ ctx_DP_valid = 0; globalset(inst_next, ctx_DP_valid); ] {
    local ret:4 = inst_next >> 1;
    local a:4 = SP;
    *[ram]:4 a = ret;
    SP = SP + 2;
    call lcdest;
}
:LB lbdest  is rpt_phase=1 & lbdest {
    goto lbdest;
}

# LC *XAR7   0111 0110 0000 0100   (indirect call via XAR7)
# Same software-stack mechanism as LC #22bit above (SPRU430F p.218: "the return PC
# value is pushed onto the software stack"); only the target differs. `inst_next`
# already accounts for this form being one word, so the shift is the same.
:LC "*XAR7"  is rpt_phase=1 & op16=0x7604
        [ ctx_DP_valid = 0; globalset(inst_next, ctx_DP_valid); ] {
    local ret:4 = inst_next >> 1;
    local a:4 = SP;
    *[ram]:4 a = ret;
    SP = SP + 2;
    call [XAR7];
}

# LB *XAR7   0111 0110 0010 0000   (indirect branch via XAR7)
# The same opcode is used for BOTH the FFC-helper return sequence AND for switch-table
# dispatch (MOVL XAR7,#table; ADDB XAR7,idx; LB *XAR7). SLEIGH can't tell them apart on
# its own, so this splits into three variants dispatched by two analyzer-set context bits:
#   - switch_canonical=1: set by TMS320C28xSwitchAnalyzer on validated switch dispatches.
#     Leave XAR7 on BRANCHIND directly so Ghidra's generic Decompiler Switch Analysis sees
#     the data dependency and recovers case targets.
#   - ffc_return=1: set by TMS320C28xFfcReturnAnalyzer on the terminal LB of a bounded,
#     exclusive FFC helper whose body never rewrites XAR7. Emit a real `return`.
#   - both clear (default): plain indirect branch; only the low 22 bits are architecturally
#     valid PC, so mask XAR7 before jumping (avoids spurious out-of-map targets in the CFG).
# The three patterns are pairwise exclusive on the (ffc_return, switch_canonical) pair.
# Adapted from mwdmwd/ghidra-c28x (Apache-2.0). See THIRD-PARTY.md.
:LB "*XAR7"  is rpt_phase=1 & ffc_return=0 & switch_canonical=1 & op16=0x7620  {
    goto [XAR7];
}
:LB "*XAR7"  is rpt_phase=1 & ffc_return=1 & switch_canonical=0 & op16=0x7620  {
    local target:4 = XAR7 & 0x003fffff;
    return [target];
}
:LB "*XAR7"  is rpt_phase=1 & ffc_return=0 & switch_canonical=0 & op16=0x7620  {
    local target:4 = XAR7 & 0x003fffff;
    goto [target];
}

# --- MOVZ ARn, loc16 : load AR, clear ARH (zero-extend) ----------------------
# AR0..5: 0101 1nnn LLLL LLLL  (nnn via arsel3); AR6/AR7 have distinct opcodes.
# Display the 16-bit AR (arsel3) but WRITE the full 32-bit XARn (arsel3x) zero-extended,
# so ARnH is cleared as MOVZ requires. (Writing only the 16-bit AR left ARnH stale and
# the decompiler rebuilt XARn as CONCAT22(stale_hi, lo) at every pointer use.)
#
# NOTE: arsel3 must be constrained to 0..5. The 0x5E/0x5F op_hi8 slots are the MOV
# AR6/AR7 partial-write instructions (below), NOT MOVZ. Before the constraint this
# constructor matched op_hi8=0x5E/0x5F too and MOV AR6/AR7 rendered as MOVZ -- silent
# WRONG in the fw-parity sweep, and semantically different (MOVZ clears ARnH, MOV
# doesn't).
:MOVZ arsel3, loc16  is rpt_phase=1 & op_hi5=0b01011 & arsel3 & arsel3x & loc16
                     & arsel3n!=0b110 & arsel3n!=0b111  {
    arsel3x = zext(loc16);
}
:MOVZ "AR6", loc16   is rpt_phase=1 & op_hi8=0x88 & loc16  { XAR6 = zext(loc16); }
:MOVZ "AR7", loc16   is rpt_phase=1 & op_hi8=0x80 & loc16  { XAR7 = zext(loc16); }

# --- MOV ARn, loc16 : PARTIAL write of AR6/AR7 (ARnH preserved). Only n=6/7 have
# this encoding -- asm2000 rejects `MOV AR0..5, @...` as illegal. Writing AR6/AR7
# (the 16-bit view) leaves ARnH intact, which is the defining semantic difference
# from MOVZ. Missed pre-fix because the MOVZ arsel3 pattern above swallowed the
# 0x5E/0x5F slots. Verified against asm2000: 0x5E00 = MOV AR6,@0, 0x5F00 = MOV AR7,@0.
:MOV "AR6", loc16    is rpt_phase=1 & op_hi8=0x5E & loc16  { AR6 = loc16; }
:MOV "AR7", loc16    is rpt_phase=1 & op_hi8=0x5F & loc16  { AR7 = loc16; }

# MOVZ DP, #10bit   1011 10CC CCCC CCCC   -- load low 10 bits of DP, clear rest.
# Snapshot to ctx_DP so downstream `@6bit` accesses resolve to constant absolute
# addresses. `MOVZ` writes only the low 10 bits and clears the top 6, so ctx_DP =
# dp10 exactly (no OR with a prior value); see tms320c28x_mov.sinc `MOVW DP,#16bit`.
:MOVZ "DP", "#"dp10  is rpt_phase=1 & op_hi_6=0b101110 & dp10
        [ ctx_DP = dp10; ctx_DP_valid = 1;
          globalset(inst_next, ctx_DP); globalset(inst_next, ctx_DP_valid); ] {
    DP = dp10;
}

# MOV DP, #10bit   1111 10CC CCCC CCCC   -- load low 10 bits of DP, PRESERVE upper 6.
# The load-vs-clear distinction versus MOVZ above is the whole point: MOV DP is a
# partial write, so the resulting DP depends on the prior DP value. We can't compute
# that at SLEIGH decode time, so ctx_DP is INVALIDATED here rather than snapshot to
# `dp10` (which would silently invent the upper-6 bits as zero and mis-resolve every
# downstream @6bit access). DpPropagationAnalyzer can still constant-fold when the
# prior DP is known statically; otherwise @6bit accesses go unresolved from here.
# Missing before issue #118 -- fw-parity sweep flagged `MOV DP, #0x7a` at 0x82e98 as <UNDEF>.
:MOV "DP", "#"dp10  is rpt_phase=1 & op_hi_6=0b111110 & dp10
        [ ctx_DP_valid = 0; globalset(inst_next, ctx_DP_valid); ] {
    DP = (DP & 0xfc00) | dp10;
}

# --- 16-bit / 32-bit moves ---------------------------------------------------
# MOVDL XT,loc32    1010 0110 LLLL LLLL  -- store XT to loc32, then load XT from it
:MOVDL "XT", loc32  is rpt_phase=1 & op_hi8=0xA6 & loc32  { loc32 = XT; XT = loc32; }
# MOVAD T,loc16     1010 0111 LLLL LLLL  -- T=loc16; ACC+=P (like MOVA, addr variant)
# SPRU430F: N/Z/C/V + OVC on the ACC += P step. Also does [loc16+1]=T as a side effect
# (data-move variant of MOVA); we model the register write, not the memory move.
:MOVAD "T", loc16   is rpt_phase=1 & op_hi8=0xA7 & loc16  {
    local b:4 = P;
    $(C) = carry(ACC, b);
    $(V) = scarry(ACC, b);
    ACC = ACC + b;
    setNZ32(ACC);
    applyOvcSigned(ACC);
    T = loc16;
}
# DMOV loc16        1010 0101 LLLL LLLL  -- data move [loc16+1]=[loc16] (delay line)
:DMOV loc16         is rpt_phase=1 & op_hi8=0xA5 & loc16  { }   # decode-only (memory shuffle)

# --- byte moves --------------------------------------------------------------
# MOVB AX.LSB, loc16   1100 011A LLLL LLLL
# Spec: load AX.LSB with the low byte AND CLEAR AX.MSB (zero-extend the byte into the
# full 16-bit AX). Preserving the MSB (the old & 0xFF00 form) was wrong.
# NB: the AR0/AR1-indexed byte forms are BYTE-ADDRESSED (see below) and are excluded here.
:MOVB AX^".LSB", loc16  is rpt_phase=1 & op_hi7=0x63 & AX & loc_mode5!=0b10010 & loc_mode5!=0b10011 & loc16  {
    local b:2 = loc16 & 0xFF;
    AX = b;
    setNZ16(AX);
}
# MOVB AX.MSB, loc16   0011 100A LLLL LLLL  -- load MSB of AX, LSB left unchanged.
# SPRU430F: after the byte load N/Z reflect the FULL AX (both bytes), so they are testable
# even when only one half changes -- see the MOVB AX,#8bit sibling for the same pattern.
:MOVB AX^".MSB", loc16  is rpt_phase=1 & op_hi7=0x1C & AX & loc_mode5!=0b10010 & loc_mode5!=0b10011 & loc16  {
    AX = (AX & 0x00FF) | ((loc16 & 0xFF) << 8);
    setNZ16(AX);
}
# MOVB loc16, AX.LSB   0011 110A LLLL LLLL  -- store low byte of AX into loc16.
# (Spec writes only 8 bits of loc16, the other byte by address parity; we approximate
# with a 16-bit zero-extended store, which is fine for decompilation.)
# NB: the AR0/AR1-indexed byte forms are BYTE-ADDRESSED (see below) and are excluded here.
:MOVB loc16, AX^".LSB"  is rpt_phase=1 & op_hi7=0x1E & AX & loc_mode5!=0b10010 & loc_mode5!=0b10011 & loc16  { loc16 = AX & 0xFF; }
# Byte-addressed store counterparts of the MOVB AX.LSB,*+XARn[ARm] loads above: effective byte
# addr = (XARn<<1)+ARm, byte lane = ARm&1. A whole-word store would clobber the adjacent packed
# byte, so read-modify-write only the target lane (fatal otherwise for a byte-packed array such
# as an AES state/S-box written back a byte at a time). ram is wordsize=2 -> word = byteaddr>>1.
:MOVB "*+"loc_areg"[AR0]", AX^".LSB"  is rpt_phase=1 & op_hi7=0x1E & AX & ctx_AMODE=0 & loc_mode5=0b10010 & loc_areg {
    local ba:4 = (loc_areg << 1) + zext(AR0);
    local wa:4 = ba >> 1;
    local sh:2 = zext(ba:1 & 1) << 3;
    local wv:2 = *[ram]:2 wa;
    local mask:2 = ~(0xFF << sh);
    *[ram]:2 wa = (wv & mask) | ((AX & 0xFF) << sh);
}
:MOVB "*+"loc_areg"[AR1]", AX^".LSB"  is rpt_phase=1 & op_hi7=0x1E & AX & ctx_AMODE=0 & loc_mode5=0b10011 & loc_areg {
    local ba:4 = (loc_areg << 1) + zext(AR1);
    local wa:4 = ba >> 1;
    local sh:2 = zext(ba:1 & 1) << 3;
    local wv:2 = *[ram]:2 wa;
    local mask:2 = ~(0xFF << sh);
    *[ram]:2 wa = (wv & mask) | ((AX & 0xFF) << sh);
}

# --- byte moves: register-INDEXED forms are BYTE-ADDRESSED --------------------
# C28x MOVB with *+XARn[ARm] indexing treats ARm as a BYTE offset into a byte-packed
# array: effective byte addr = (XARn<<1)+ARm, byte lane = ARm&1. The generic loc16 path
# above computes a WORD addr (XARn+ARm) and reads the low byte, i.e. byte[2*ARm] (only the
# even entries) -- fatal for a byte-packed table such as an AES S-box (256 packed bytes).
# ram is wordsize=2, so word addr = (byteaddr>>1) and lane picks the high/low byte.
:MOVB AX^".LSB", "*+"loc_areg"[AR0]"  is rpt_phase=1 & op_hi7=0x63 & AX & ctx_AMODE=0 & loc_mode5=0b10010 & loc_areg {
    local ba:4 = (loc_areg << 1) + zext(AR0);
    local wv:2 = *[ram]:2 (ba >> 1);
    local sh:2 = zext(ba:1 & 1) << 3;
    AX = (wv >> sh) & 0xFF;
    setNZ16(AX);
}
:MOVB AX^".LSB", "*+"loc_areg"[AR1]"  is rpt_phase=1 & op_hi7=0x63 & AX & ctx_AMODE=0 & loc_mode5=0b10011 & loc_areg {
    local ba:4 = (loc_areg << 1) + zext(AR1);
    local wv:2 = *[ram]:2 (ba >> 1);
    local sh:2 = zext(ba:1 & 1) << 3;
    AX = (wv >> sh) & 0xFF;
    setNZ16(AX);
}
:MOVB AX^".MSB", "*+"loc_areg"[AR0]"  is rpt_phase=1 & op_hi7=0x1C & AX & ctx_AMODE=0 & loc_mode5=0b10010 & loc_areg {
    local ba:4 = (loc_areg << 1) + zext(AR0);
    local wv:2 = *[ram]:2 (ba >> 1);
    local sh:2 = zext(ba:1 & 1) << 3;
    AX = (AX & 0x00FF) | (((wv >> sh) & 0xFF) << 8);
    setNZ16(AX);
}
:MOVB AX^".MSB", "*+"loc_areg"[AR1]"  is rpt_phase=1 & op_hi7=0x1C & AX & ctx_AMODE=0 & loc_mode5=0b10011 & loc_areg {
    local ba:4 = (loc_areg << 1) + zext(AR1);
    local wv:2 = *[ram]:2 (ba >> 1);
    local sh:2 = zext(ba:1 & 1) << 3;
    AX = (AX & 0x00FF) | (((wv >> sh) & 0xFF) << 8);
    setNZ16(AX);
}

# --- ALU additions -----------------------------------------------------------
# SUBU ACC, loc16   0000 0001 LLLL LLLL   (subtract unsigned)
# SPRU430F: Z/N set from the result, C CLEARED on borrow (set otherwise), V on overflow. Same
# flag-hole class as the ADDB note below -- see SUBB for how it was caught.
:SUBU ACCreg, loc16  is rpt_phase=1 & op_hi8=0x01 & ACCreg & loc16  {
    local b:4 = zext(loc16);
    $(C) = !(ACC < b);
    $(V) = sborrow(ACC, b);
    ACC = ACC - b;
    setNZ32(ACC);
    applyOvcSigned(ACC);
}
# SUBB ACC, #8bit   0001 1001 CCCC CCCC
# Flags used to be missing entirely here (the body was just the subtract), exactly the hole the
# ADDB note below describes -- and this one is worse, because SPRU430F's own example for this
# instruction is the decrement idiom: `MOVL ACC,@VarA ; SUBB ACC,#1`. TI's C runtime builds its
# word-fill loop out of it: `SUBB ACC,#1 ; MOV *XAR6++,AR5 ; SB loop,NEQ`. With no Z update the
# branch reads a stale flag and the loop NEVER TERMINATES regardless of the counter -- so
# EmulateStartup could not replay startup on any image whose runtime uses that fill, spinning
# until the step budget died and then materializing 666k words of garbage RAM. Disassembly
# parity is structurally blind to it: mnemonic and operands were always right. Guarded by
# EmuSubbAccFlagsTest.
:SUBB ACCreg, "#"imm8  is rpt_phase=1 & op_hi8=0x19 & ACCreg & imm8  {
    local b:4 = zext(imm8:1);
    $(C) = !(ACC < b);
    $(V) = sborrow(ACC, b);
    ACC = ACC - b;
    setNZ32(ACC);
    applyOvcSigned(ACC);
}
# ADDB ACC, #8bit   0000 1001 CCCC CCCC
# Flags matter here and used to be missing entirely (the body was just the add). SPRU430F has this
# form affecting Z/N/C/V like any other ACC add, and the C runtime leans on it: TI's startup tests a
# weak linker symbol for the "absent" sentinel with `MOV @AL,#0xffff ; MOV @AH,#0xffff ;
# ADDB ACC,#1 ; SB skip,EQ` -- i.e. it adds 1 to -1 and branches on Z. With no Z update the branch
# read a stale flag, fell through, and _c_int00 "called" the copy-table walker with the 0x3fffff
# absent-pointer, walking garbage. Disassembly parity never saw it: the mnemonic and operands were
# always right. Caught by emulating real startup code (EmulateStartup) -- the flag-order class the
# testing notes warn only emulation catches. Guarded by EmuAddbAccFlagsTest.
:ADDB ACCreg, "#"imm8  is rpt_phase=1 & op_hi8=0x09 & ACCreg & imm8  {
    local b:4 = zext(imm8:1);
    $(C) = carry(ACC, b);
    $(V) = scarry(ACC, b);
    ACC = ACC + b;
    setNZ32(ACC);
    applyOvcSigned(ACC);
}
# ADDB AX, #8bit    1001 110A CCCC CCCC
:ADDB AX, "#"imm8   is rpt_phase=1 & op_hi7=0x4E & AX & imm8  {
    local b:2 = zext(imm8:1);
    $(C) = carry(AX, b); $(V) = scarry(AX, b);
    AX = AX + b; setNZ16(AX);
}
# SUBCU ACC, loc16  0001 1111 LLLL LLLL   (16-bit conditional subtract; unsigned modulus-divide
# step, RPT-able). SPRU430F: temp(32:0) = (ACC<<1) - ([loc16]<<16); if temp>0 ACC=temp[31:0]+1
# else ACC=ACC<<1. With the RPT hardware-loop modeled, RPT #15 || SUBCU now emulates a full
# 16-bit unsigned division (AL=quotient, AH=remainder). Compute in 64-bit so the 33-bit temp and
# its sign are exact; the else path is written first, then overridden when temp>0 (no label).
:SUBCU ACCreg, loc16  is rpt_phase=1 & op_hi8=0x1F & ACCreg & loc16  {
    local num:8 = zext(ACC) << 1;
    local den:8 = zext(loc16) << 16;
    local temp:8 = num - den;
    # SPRU430F: C is CLEARED when the 33-bit temp borrows (num<den), else SET.
    # V and OVC are documented as unaffected. N/Z reflect the FINAL ACC (both branches).
    $(C) = !(num < den);
    ACC = ACC << 1;                 # else: ACC <<= 1
    if (temp s<= 0) goto <done>;
    ACC = temp:4 + 1;               # then: ACC = temp[31:0] + 1
    <done>
    setNZ32(ACC);
}

# --- multiply additions ------------------------------------------------------
# MPYXU ACC,T,loc16   0011 0000 LLLL LLLL  (signed x unsigned -> ACC)
# SPRU430F: N,Z on the ACC write.
:MPYXU ACCreg, Treg, loc16  is rpt_phase=1 & op_hi8=0x30 & ACCreg & Treg & loc16  {
    local a:4 = sext(T); local b:4 = zext(loc16); ACC = a * b;
    setNZ32(ACC);
}
# MPYXU P,T,loc16     0011 0010 LLLL LLLL
:MPYXU Preg, Treg, loc16  is rpt_phase=1 & op_hi8=0x32 & Preg & Treg & loc16  {
    local a:4 = sext(T); local b:4 = zext(loc16); P = a * b;
}
# XMACD P,loc16,*pma  1010 0100 LLLL LLLL : pma   (mac with data move)
# SPRU430F: N/Z/C/V + OVC on the ACC += P step.
:XMACD Preg, loc16, "*("xpmaval")"  is rpt_phase=1 & op_hi8=0xA4 & Preg & loc16 ; imm16 & xpmaval {
    local b:4 = P;
    $(C) = carry(ACC, b);
    $(V) = scarry(ACC, b);
    ACC = ACC + b;
    setNZ32(ACC);
    applyOvcSigned(ACC);
    local pv:2 = xpmaval;
    local a:4 = sext(loc16); local mb:4 = sext(pv);
    P = a * mb;
}

# =============================================================================
# MOVL XARn, #22bit -- load a 32-bit auxiliary register with a 22-bit constant.
# THE pointer-load instruction: this is how code loads peripheral/CAN base
# addresses (e.g. MOVL XAR4,#0x048000 for CANA) into a pointer register.
# word1 low 6 bits = const[21:16], word2 = const[15:0].
# XAR0-3: 1000 1101 nnCC CCCC ; XAR4-5: 1000 1111 0nCC ; XAR6-7: 0111 0110 1xCC
# =============================================================================
:MOVL "XAR0", "#"xar22  is rpt_phase=1 & op_hi8=0x8D & op_lo_76=0b00 & loc_off6 ; imm16
        [ xar22 = (loc_off6 << 16) | imm16; ] { XAR0 = xar22; }
:MOVL "XAR1", "#"xar22  is rpt_phase=1 & op_hi8=0x8D & op_lo_76=0b01 & loc_off6 ; imm16
        [ xar22 = (loc_off6 << 16) | imm16; ] { XAR1 = xar22; }
:MOVL "XAR2", "#"xar22  is rpt_phase=1 & op_hi8=0x8D & op_lo_76=0b10 & loc_off6 ; imm16
        [ xar22 = (loc_off6 << 16) | imm16; ] { XAR2 = xar22; }
:MOVL "XAR3", "#"xar22  is rpt_phase=1 & op_hi8=0x8D & op_lo_76=0b11 & loc_off6 ; imm16
        [ xar22 = (loc_off6 << 16) | imm16; ] { XAR3 = xar22; }
:MOVL "XAR4", "#"xar22  is rpt_phase=1 & op_hi8=0x8F & op_lo_76=0b00 & loc_off6 ; imm16
        [ xar22 = (loc_off6 << 16) | imm16; ] { XAR4 = xar22; }
:MOVL "XAR5", "#"xar22  is rpt_phase=1 & op_hi8=0x8F & op_lo_76=0b01 & loc_off6 ; imm16
        [ xar22 = (loc_off6 << 16) | imm16; ] { XAR5 = xar22; }
:MOVL "XAR6", "#"xar22  is rpt_phase=1 & op_hi8=0x76 & op_lo_76=0b10 & loc_off6 ; imm16
        [ xar22 = (loc_off6 << 16) | imm16; ] { XAR6 = xar22; }
:MOVL "XAR7", "#"xar22  is rpt_phase=1 & op_hi8=0x76 & op_lo_76=0b11 & loc_off6 ; imm16
        [ xar22 = (loc_off6 << 16) | imm16; ] { XAR7 = xar22; }

# =============================================================================
# MOV ACC, loc16 <<#0   1000 0101 LLLL LLLL  -- SINGLE WORD (shift 0; SPRU430F
# Table for MOV ACC,loc16<<#0..16). The <<#1..15 form is the 0x5603 two-word
# variant (in ext56), and <<#16 is 0x25 — NOT a trailing-imm word here. Making
# this 2-word over-consumed the following instruction (caught vs TI dis2000:
# e.g. 0x85a9 MOV ACC,@AL then 0x097f ADDB ACC,#127 were merged).
# XMAC P,loc16,*(pma)   1000 0100 LLLL LLLL : pma  (decode-only MAC variant)
# =============================================================================
:MOV ACCreg, loc16^"<<#0"  is rpt_phase=1 & op_hi8=0x85 & ACCreg & loc16 {
    mov_acc_mext_shift(loc16, 0);
}
# SPRU430F: N/Z/C/V + OVC on the ACC += P step.
:XMAC Preg, loc16, "*("xpmaval")"  is rpt_phase=1 & op_hi8=0x84 & Preg & loc16 ; imm16 & xpmaval {
    local b:4 = P;
    $(C) = carry(ACC, b);
    $(V) = scarry(ACC, b);
    ACC = ACC + b;
    setNZ32(ACC);
    applyOvcSigned(ACC);
    local pv:2 = xpmaval;
    local a:4 = sext(loc16); local mb:4 = sext(pv);
    P = a * mb;
}

# =============================================================================
# Batch 2: common store/stack/program-memory ops found breaking real code runs.
# =============================================================================
# OR loc16, AX     1001 100A LLLL LLLL  (A bit -> AL/AH)
# SPRU430F: N/Z from the result at [loc16]. Was flag-silent -- see issue #108.
:OR loc16, AX     is rpt_phase=1 & op_hi7=0x4C & loc16 & AX  { loc16 = loc16 | AX; setNZ16(loc16); }
# AND loc16, AX    1100 000A LLLL LLLL  (store-side AND: [loc16] &= AX). Was MISSING —
# the truncation point in CAN_rxDispatch (0x9595c = 0xC092). N/Z set per SPRU430F.
:AND loc16, AX    is rpt_phase=1 & op_hi7=0x60 & loc16 & AX  { loc16 = loc16 & AX; setNZ16(loc16); }
# ANDB AX, #8bit   1001 000A CCCC CCCC
:ANDB AX, "#"imm8  is rpt_phase=1 & op_hi7=0x48 & AX & imm8  { AX = AX & zext(imm8:1); setNZ16(AX); }
# PUSH loc16       0010 0010 LLLL LLLL  (push 16-bit value: *SP++ = loc16)
:PUSH loc16  is rpt_phase=1 & op_hi8=0x22 & loc16  {
    local sp:4 = SP; local v:2 = loc16; *[ram]:2 sp = v; SP = SP + 1;
}
# POP loc16        0010 1010 LLLL LLLL
:POP loc16   is rpt_phase=1 & op_hi8=0x2A & loc16  {
    SP = SP - 1; local sp:4 = SP; loc16 = *[ram]:2 sp;
}
# MOV IER, loc16   0010 0011 LLLL LLLL
:MOV "IER", loc16  is rpt_phase=1 & op_hi8=0x23 & loc16  { IER = loc16; }
# PREAD loc16,*XAR7   0010 0100 LLLL LLLL  (read program memory @XAR7 -> loc16)
#
# N/Z are conditioned on the DESTINATION, which is how SPRU430F states the rule: "If (loc16 = @AX)
# and bit 15 of AX is 1, then N is set" -- a memory destination leaves both flags alone. So @AH and
# @AL are their own constructors below and the generic loc16 form writes no flags. This replaces a
# deliberate approximation (N/Z on every destination) that also wrote flags for block-copy forms
# such as `PREAD *XAR6++,*XAR7`, where hardware writes none. The @AX split is adapted from
# mwdmwd/ghidra-c28x; see THIRD-PARTY.md.
#
# The @AX half is load-bearing, and the firmware proves it: TI's inlined .cinit walk in _c_int00
# reads a record's count with `PREAD @AL,*XAR7` and immediately does `SB skip,GEQ` -- a SIGNED test
# on the word just loaded, where a negative count means "this record has a 32-bit destination". With
# no N update the branch read a stale flag, the sign test inverted, and the walk took the count
# 0xffff literally: it copied 65535 words to a destination truncated to 16 bits instead of 1 word
# to the real 32-bit one, scribbling 85k words across M0/LS/GS RAM. Disassembly parity cannot
# see this -- the mnemonic and operand are correct either way. Found by EmulateStartup replaying a
# real F28377D application image.
#
# EmuPreadFlagsTest guards it, and now guards constructor PRECEDENCE with it: the test assembles
# 0x24A9 (`PREAD @AL,*XAR7`), so it fails outright if the flagless generic form ever wins the
# pattern match against the @AL specialisation.
#
# The REPEAT SHADOW (`RPT || PREAD`) is modelled in tms320c28x_rpt.sinc.
:PREAD "@AH", "*XAR7"  is rpt_phase=1 & op_hi8=0x24 & ctx_AMODE=0 & loc_full8=0b10101000  {
    AH = *[ram]:2 XAR7;
    setNZ16(AH);
}
:PREAD "@AL", "*XAR7"  is rpt_phase=1 & op_hi8=0x24 & ctx_AMODE=0 & loc_full8=0b10101001  {
    AL = *[ram]:2 XAR7;
    setNZ16(AL);
}
:PREAD loc16, "*XAR7"  is rpt_phase=1 & op_hi8=0x24 & loc16  {
    loc16 = *[ram]:2 XAR7;
}
# PWRITE *XAR7,loc16  0010 0110 LLLL LLLL  (write loc16 -> program memory @XAR7)
# No flags: the destination is program memory, never an accumulator half. Repeated form (which
# shadows the *XAR7 destination the same way PREAD shadows its source) in tms320c28x_rpt.sinc.
:PWRITE "*XAR7", loc16  is rpt_phase=1 & op_hi8=0x26 & loc16  {
    *[ram]:2 XAR7 = loc16;
}
# LOOPZ  loc16,#16bit  0010 1100 LLLL LLLL : iiii   (SPRU430F p.224)
# LOOPNZ loc16,#16bit  0010 1110 LLLL LLLL : iiii   (SPRU430F p.222)
#
# The 5-cycle poll loop family: repeatedly AND [loc16] with the mask and stay put
# until the AND result changes polarity. LOOPZ loops while AND == 0, LOOPNZ loops
# while AND != 0. Modeled as `if (loop-condition) goto inst_start`, so both the
# disassembler and the emulator see the self-loop that the manual describes; N/Z
# are always set from the AND result per spec, even on the exiting iteration.
#
# LOOPZ was previously MISSING (op 0x2C was claimed by the phantom MOV IERreg,loc16
# in tms320c28x_mov.sinc:70, which was on the wrong opcode -- correct MOV IER,loc16
# is at op_hi8=0x23 in this file). LOOPNZ existed but had a `{ }` decode-only body,
# so every peripheral-wait idiom silently ran with the previous compare's stale
# N/Z. Fixed in issue #114.
:LOOPZ loc16, "#"imm16  is rpt_phase=1 & op_hi8=0x2C & loc16 ; imm16  {
    local v:2 = loc16;
    local r:2 = v & imm16:2;
    setNZ16(r);
    if (r == 0) goto inst_start;
}
:LOOPNZ loc16, "#"imm16  is rpt_phase=1 & op_hi8=0x2E & loc16 ; imm16  {
    local v:2 = loc16;
    local r:2 = v & imm16:2;
    setNZ16(r);
    if (r != 0) goto inst_start;
}

# =============================================================================
# Batch 3: immediate-to-memory ALU (2-word) + XPREAD single-word form.
# These (ADD/AND/OR/XOR loc16,#16bit) are extremely common in init/config code.
# word1 = opcode + loc ; word2 = 16-bit immediate.
# =============================================================================
# ADD loc16,#16bit   0000 1000 LLLL LLLL : iiii
:ADD loc16, "#"imm16  is rpt_phase=1 & op_hi8=0x08 & loc16 ; imm16  { loc16 = loc16 + imm16:2; }
# AND/OR/XOR loc16,#16bit   0001 1sss LLLL LLLL : iiii  (store-side R-M-W). N/Z from
# result per SPRU430F. Were flag-silent -- see issue #108.
:AND loc16, "#"imm16  is rpt_phase=1 & op_hi8=0x18 & loc16 ; imm16  { loc16 = loc16 & imm16:2; setNZ16(loc16); }
:OR loc16, "#"imm16   is rpt_phase=1 & op_hi8=0x1A & loc16 ; imm16  { loc16 = loc16 | imm16:2; setNZ16(loc16); }
:XOR loc16, "#"imm16  is rpt_phase=1 & op_hi8=0x1C & loc16 ; imm16  { loc16 = loc16 ^ imm16:2; setNZ16(loc16); }
# XPREAD loc16,*(pma)  1010 1100 MMMM MMMM : pma  (program-mem read, single-word form)
# Destination-conditioned N/Z, same SPRU430F rule as PREAD above: flags only when the destination
# is an accumulator half, hence the @AH / @AL split. Repeated forms in tms320c28x_rpt.sinc.
#
# `pma` is page-forced to 0x3F -- see the xpmaval sub-table in tms320c28x_flow.sinc. This also
# fixes the rendering: the operand used to be the LITERAL TEXT "*(pma)" (the letters p-m-a), so
# the listing never showed which address was read.
:XPREAD "@AH", "*("xpmaval")"  is rpt_phase=1 & op_hi8=0xAC & ctx_AMODE=0 & loc_full8=0b10101000 ; imm16 & xpmaval  {
    AH = xpmaval;
    setNZ16(AH);
}
:XPREAD "@AL", "*("xpmaval")"  is rpt_phase=1 & op_hi8=0xAC & ctx_AMODE=0 & loc_full8=0b10101001 ; imm16 & xpmaval  {
    AL = xpmaval;
    setNZ16(AL);
}
:XPREAD loc16, "*("xpmaval")"  is rpt_phase=1 & op_hi8=0xAC & loc16 ; imm16 & xpmaval  {
    loc16 = xpmaval;
}

# =============================================================================
# Batch 4: fixed PUSH/POP of registers (function prologue/epilogue). No operands.
# push16(v): *SP = v; SP++.   pop16(dst): SP--; dst = *SP.   (SP is word-addressed)
# =============================================================================
macro push16(v) { local a:4 = SP; *[ram]:2 a = v; SP = SP + 1; }
macro pop16(dst) { SP = SP - 1; local a:4 = SP; dst = *[ram]:2 a; }

# --- ST0/ST1 pack/unpack: individual flag registers <-> the 16-bit status word.
# The unpacked flag model (each status bit is its own register, see the slaspec)
# means PUSH/POP ST0|ST1 must assemble/disassemble the word from/into those regs.
# PM is stored DECODED (signed shift -6..+1); the raw ST0[7,3] field encodes it as
# (1 - shift), so pack/unpack convert. unpackst0's PM path also models the C2xLP
# (AMODE=1) raw-value-5 => +4 special case. Adapted from mwdmwd/ghidra-c28x
# (Apache-2.0); see the file header and THIRD-PARTY.md.
macro packst0(res) {
    local pm_signed:2 = sext(PM);
    local pm_raw:2 = (1 - pm_signed) & 7;
    local ovc_raw:2 = zext(OVC) & 0x3f;
    res = (zext(SXM)
        | (zext(OVM) << 1)
        | (zext(TC) << 2)
        | (zext(C) << 3)
        | (zext(Z) << 4)
        | (zext(N) << 5)
        | (zext(V) << 6)
        | (pm_raw << 7)
        | (ovc_raw << 10));
}
macro unpackst0(in) {
    local ovc_raw:1 = in[10,6];
    local ovc_sign_mask:1 = 0 - ovc_raw[5,1];
    OVC = ovc_raw | (ovc_sign_mask & 0xc0);
    local pm_raw:1 = in[7,3];
    local pm_default:1 = 1 - pm_raw;
    local pm_plus4:1 = (AMODE != 0) && (pm_raw == 5);
    local pm_plus4_mask:1 = 0 - pm_plus4;
    PM = (pm_default & ~pm_plus4_mask) | (4 & pm_plus4_mask);
    V   = in[6,1];
    N   = in[5,1];
    Z   = in[4,1];
    C   = in[3,1];
    TC  = in[2,1];
    OVM = in[1,1];
    SXM = in[0,1];
}
macro packst1(res) {
    res = (zext(INTM)
        | (zext(DBGM) << 1)
        | (zext(PAGE0) << 2)
        | (zext(VMAP) << 3)
        | (zext(SPA) << 4)
        | (zext(LOOP) << 5)
        | (zext(EALLOW) << 6)
        | (zext(IDLESTAT) << 7)
        | (zext(AMODE) << 8)
        | (zext(OBJMODE) << 9)
        | (zext(M0M1MAP) << 11)
        | (zext(XF) << 12)
        | (zext(ARP) << 13));
}
macro unpackst1(in) {
    ARP      = in[13,3];
    XF       = in[12,1];
    M0M1MAP  = in[11,1];
    OBJMODE  = in[9,1];
    AMODE    = in[8,1];
    IDLESTAT = in[7,1];
    EALLOW   = in[6,1];
    LOOP     = in[5,1];
    SPA      = in[4,1];
    VMAP     = in[3,1];
    PAGE0    = in[2,1];
    DBGM     = in[1,1];
    INTM     = in[0,1];
}

:POP "IFR"       is rpt_phase=1 & op16=0x0002 { pop16(IFR); }
:POP "AR1H:AR0H" is rpt_phase=1 & op16=0x0003 { SP = SP - 2; }               # decode-only (pair pop)
:POP "RPC"       is rpt_phase=1 & op16=0x0007 { SP = SP - 2; local a:4 = SP; RPC = *[ram]:4 a; }
:PUSH "RPC"      is rpt_phase=1 & op16=0x0004 { local a:4 = SP; *[ram]:4 a = RPC; SP = SP + 2; }
# PUSH/POP P (32-bit product reg). 0x761d / 0x7611. dis2000-confirmed (PCS411 0x9167c).
:PUSH "P"        is rpt_phase=1 & op16=0x761D { local a:4 = SP; *[ram]:4 a = P; SP = SP + 2; }
:POP "P"         is rpt_phase=1 & op16=0x7611 { SP = SP - 2; local a:4 = SP; P = *[ram]:4 a; }
:PUSH "AR1H:AR0H" is rpt_phase=1 & op16=0x0005 { SP = SP + 2; }              # decode-only (pair push)
# POP DP reloads DP from an unknown stack value; invalidate ctx_DP at inst_next so
# resolved @6bit dispatch falls back to the runtime expression. (MOVW/MOVZ DP,#imm
# are the only writers we can snapshot at disassembly time.)
:POP "DP"        is rpt_phase=1 & op16=0x7603
        [ ctx_DP_valid = 0; globalset(inst_next, ctx_DP_valid); ]
        { pop16(DP); }
:POP "ST0"       is rpt_phase=1 & op16=0x7613 { pop16(ST0); unpackst0(ST0); }
:POP "ST1"       is rpt_phase=1 & op16=0x7600 { pop16(ST1); unpackst1(ST1); }
:POP "DBGIER"    is rpt_phase=1 & op16=0x7612 { pop16(DBGIER); }
:PUSH "IFR"      is rpt_phase=1 & op16=0x760A { push16(IFR); }
:PUSH "DP"       is rpt_phase=1 & op16=0x760B { push16(DP); }
:PUSH "ST0"      is rpt_phase=1 & op16=0x7618 { packst0(ST0); push16(ST0); }
:PUSH "ST1"      is rpt_phase=1 & op16=0x7608 { packst1(ST1); push16(ST1); }

# =============================================================================
# Batch 5: AX shifts (0xFF-prefix), SP byte-add, MOVL ACC,P — from TI rts validation.
# =============================================================================
# Shifts of AX by T(3:0).  The AX selector is bit 0 of the word (AXb0), NOT bit 8,
# and the sub-opcode occupies bits 1..7 (op_lo71).  1111 1111 0110 0ssA.
# SPRU430F ch. 6: N/Z from AX after; C = last bit shifted out (0 if T[3:0]==0).
# Same pattern as LSLL/LSRL/ASRL in tms320c28x_ext56.sinc. Was flag-silent — see #104.
# ASR AX,T   1111 1111 0110 010A  (arithmetic shift right by T)
:ASR AXb0, "T"  is rpt_phase=1 & op_hi8=0xFF & op_lo71=0b0110010 & AXb0  {
    local s:2 = T & 0xf;
    $(C) = 0;
    if (s == 0) goto <done>;
    $(C) = ((AXb0 >> (s - 1)) & 1) != 0;
  <done>
    AXb0 = AXb0 s>> s;
    setNZ16(AXb0);
}
# LSR AX,T   1111 1111 0110 001A
:LSR AXb0, "T"  is rpt_phase=1 & op_hi8=0xFF & op_lo71=0b0110001 & AXb0  {
    local s:2 = T & 0xf;
    $(C) = 0;
    if (s == 0) goto <done>;
    $(C) = ((AXb0 >> (s - 1)) & 1) != 0;
  <done>
    AXb0 = AXb0 >> s;
    setNZ16(AXb0);
}
# LSL AX,T   1111 1111 0110 011A  (logical shift left by T)
:LSL AXb0, "T"  is rpt_phase=1 & op_hi8=0xFF & op_lo71=0b0110011 & AXb0  {
    local s:2 = T & 0xf;
    $(C) = 0;
    if (s == 0) goto <done>;
    $(C) = ((AXb0 >> (16 - s)) & 1) != 0;
  <done>
    AXb0 = AXb0 << s;
    setNZ16(AXb0);
}
# ADDB SP,#7bit   1111 1110 0CCC CCCC  (stack adjust). bit7=0 distinguishes from
# SUBB SP,#7bit (1111 1110 1CCC CCCC, bit7=1) — must constrain bit7 or ADDB greedily
# swallows SUBB too (caught vs TI dis2000).
:ADDB "SP", "#"sp7  is rpt_phase=1 & op_hi8=0xFE & loc_b7=0 & sp7  { SP = SP + sp7; }
# SUBB SP,#7bit   1111 1110 1CCC CCCC
:SUBB "SP", "#"sp7  is rpt_phase=1 & op_hi8=0xFE & loc_b7=1 & sp7  { SP = SP - sp7; }
# MOVL ACC,P   0001 0110 1010 1100  (move P to ACC)
# MOVL ACC,P << PM. Paired on pm_shift like the ADDL/SUBL/CMPL forms in _mac.sinc.
# SPRU430F p.299: N/Z set from ACC unconditionally after the load. Was flag-silent
# on both pm_shift halves -- issue #110.
:MOVL ACCreg, "P"  is rpt_phase=1 & pm_shift=0 & op16=0x16AC & ACCreg  {
    ACC = P;
    setNZ32(ACC);
}
:MOVL ACCreg, "P"  is rpt_phase=1 & pm_shift=1 & op16=0x16AC & ACCreg  {
    local v:4; pshift(v);
    ACC = v;
    setNZ32(ACC);
}

# =============================================================================
# Batch 6: MOVL XARn,loc32 / SUBB XARn,#7bit / MOV ACC,loc16<<#16 — the remaining
# common forms from the TI rts validation (function prologues: load AR pointers,
# adjust them, shift). Encodings: SPRU430F ch6.
# =============================================================================
# MOVL XARn, loc32 — load a 32-bit aux register from loc32. Per-register opcodes
# (SPRU430F): XAR0=0x8E XAR1=0x8B XAR2=0x86 XAR3=0x82 XAR4=0x8A XAR5=0x83
#             XAR6=0xC4 XAR7=0xC5.  word = opcode<<8 | loc32.
:MOVL "XAR0", loc32  is rpt_phase=1 & op_hi8=0x8E & loc32 { XAR0 = loc32; }
:MOVL "XAR1", loc32  is rpt_phase=1 & op_hi8=0x8B & loc32 { XAR1 = loc32; }
:MOVL "XAR2", loc32  is rpt_phase=1 & op_hi8=0x86 & loc32 { XAR2 = loc32; }
:MOVL "XAR3", loc32  is rpt_phase=1 & op_hi8=0x82 & loc32 { XAR3 = loc32; }
:MOVL "XAR4", loc32  is rpt_phase=1 & op_hi8=0x8A & loc32 { XAR4 = loc32; }
:MOVL "XAR5", loc32  is rpt_phase=1 & op_hi8=0x83 & loc32 { XAR5 = loc32; }
:MOVL "XAR6", loc32  is rpt_phase=1 & op_hi8=0xC4 & loc32 { XAR6 = loc32; }
:MOVL "XAR7", loc32  is rpt_phase=1 & op_hi8=0xC5 & loc32 { XAR7 = loc32; }

# SUBB XARn, #7bit   1101 1nnn 1CCC CCCC  -- subtract 7-bit const from XARn.
# nnn (xarn_hi3, bits 8..10) selects the register; bit7=1 distinguishes the SUBB
# form. Top 5 bits 11011 (op_hi5). Attach nnn to the XARn list.
attach variables [ xarn_hi3 ] [ XAR0 XAR1 XAR2 XAR3 XAR4 XAR5 XAR6 XAR7 ];
:SUBB xarn_hi3, "#"sp7  is rpt_phase=1 & op_hi5=0b11011 & xarn_hi3 & loc_b7=1 & sp7 {
    xarn_hi3 = xarn_hi3 - zext(sp7:1);
}

# MOV ACC, loc16 <<#16   0010 0101 LLLL LLLL  (single word; high 16 of loc into ACC)
# Shifting by 16 discards every bit extension could have contributed, so this form and
# its ADD/SUB siblings below are SXM-independent by construction -- deliberately NOT
# routed through mext, which would add an SXM term the decompiler then has to fold away.
# SPRU430F: MOV ACC,loc16<<# sets N,Z only (no C, V).
:MOV ACCreg, loc16^"<<#16"  is rpt_phase=1 & op_hi8=0x25 & ACCreg & loc16 {
    local v:4 = zext(loc16); ACC = v << 16;
    setNZ32(ACC);
}

# =============================================================================
# Batch 7: AX immediate shifts + SETC Mode — close the last rts-validation gaps.
# =============================================================================
# ASR/LSR/LSL AX,#1..16   1111 1111 sssA SHFT  (sss: ASR=101 LSR=110 LSL=100,
# A=bit4 selects AL/AH, SHFT=0 means 16). Single word. SPRU430F ch6.
# N/Z from AX after; C = last bit shifted out. shcount is always 1..16 (SHFT+1),
# so unlike the T-register forms there is no shift-count-zero carve-out. Was
# flag-silent -- see issue #104.
:ASR AXb4, "#"shcount  is rpt_phase=1 & op_hi8=0xFF & op_lo765=0b101 & AXb4 & shcount {
    local s:2 = zext(shcount);
    $(C) = ((AXb4 >> (s - 1)) & 1) != 0;
    AXb4 = AXb4 s>> s;
    setNZ16(AXb4);
}
:LSR AXb4, "#"shcount  is rpt_phase=1 & op_hi8=0xFF & op_lo765=0b110 & AXb4 & shcount {
    local s:2 = zext(shcount);
    $(C) = ((AXb4 >> (s - 1)) & 1) != 0;
    AXb4 = AXb4 >> s;
    setNZ16(AXb4);
}
:LSL AXb4, "#"shcount  is rpt_phase=1 & op_hi8=0xFF & op_lo765=0b100 & AXb4 & shcount {
    local s:2 = zext(shcount);
    $(C) = ((AXb4 >> (16 - s)) & 1) != 0;
    AXb4 = AXb4 << s;
    setNZ16(AXb4);
}

# SETC Mode   0011 1011 CCCC CCCC  -- set status bits per 8-bit mask. Common
# single-bit forms get named operands; general mask form prints the hex mask.
# (CLRC Mode is 0011 1101; add if it shows up.) ST0/ST1 are the flag registers;
# decode-only OR-in is enough for readable disasm without modeling every bit.
:SETC "SXM"   is rpt_phase=1 & op16=0x3B01 { $(SXM) = 1; }
:SETC "OVM"   is rpt_phase=1 & op16=0x3B02 { $(OVM) = 1; }
:SETC "TC"    is rpt_phase=1 & op16=0x3B04 { $(TC)  = 1; }
:SETC "C"     is rpt_phase=1 & op16=0x3B08 { $(C)   = 1; }
:SETC "INTM"  is rpt_phase=1 & op16=0x3B10 { $(INTM)  = 1; }
:SETC "DBGM"  is rpt_phase=1 & op16=0x3B20 { $(DBGM)  = 1; }
:SETC "PAGE0" is rpt_phase=1 & op16=0x3B40 { $(PAGE0) = 1; }
:SETC "VMAP"  is rpt_phase=1 & op16=0x3B80 { $(VMAP)  = 1; }
# General mask (multi-bit combos, e.g. SETC #0x30 = INTM|DBGM). imm8 bit i selects
# a flag: 0=SXM 1=OVM 2=TC 3=C 4=INTM 5=DBGM 6=PAGE0 7=VMAP (SPRU430F; matches the
# single-flag opcodes 0x3B01..0x3B80 above). Set each selected flag on its own
# register. Adapted from mwdmwd/ghidra-c28x (Apache-2.0).
:SETC "#"imm8  is rpt_phase=1 & op_hi8=0x3B & imm8 {
    local m:1 = imm8;
    $(SXM)   = $(SXM)   || (m[0,1] != 0);
    $(OVM)   = $(OVM)   || (m[1,1] != 0);
    $(TC)    = $(TC)    || (m[2,1] != 0);
    $(C)     = $(C)     || (m[3,1] != 0);
    $(INTM)  = $(INTM)  || (m[4,1] != 0);
    $(DBGM)  = $(DBGM)  || (m[5,1] != 0);
    $(PAGE0) = $(PAGE0) || (m[6,1] != 0);
    $(VMAP)  = $(VMAP)  || (m[7,1] != 0);
}

# =============================================================================
# Batch 8: MOVB XARn,#8bit  +  TEST ACC  (close remaining rts-validation gaps).
# =============================================================================
# MOVB XAR0..5,#8bit  1101 0nnn CCCC CCCC ; XAR6=1011 1110, XAR7=1011 0110.
# Per-register opcodes (XAR0..5 = 0xD0..0xD5) to avoid claiming 0xD6/0xD7.
:MOVB "XAR0", "#"imm8  is rpt_phase=1 & op_hi8=0xD0 & imm8 { XAR0 = zext(imm8:1); }
:MOVB "XAR1", "#"imm8  is rpt_phase=1 & op_hi8=0xD1 & imm8 { XAR1 = zext(imm8:1); }
:MOVB "XAR2", "#"imm8  is rpt_phase=1 & op_hi8=0xD2 & imm8 { XAR2 = zext(imm8:1); }
:MOVB "XAR3", "#"imm8  is rpt_phase=1 & op_hi8=0xD3 & imm8 { XAR3 = zext(imm8:1); }
:MOVB "XAR4", "#"imm8  is rpt_phase=1 & op_hi8=0xD4 & imm8 { XAR4 = zext(imm8:1); }
:MOVB "XAR5", "#"imm8  is rpt_phase=1 & op_hi8=0xD5 & imm8 { XAR5 = zext(imm8:1); }
:MOVB "XAR6", "#"imm8  is rpt_phase=1 & op_hi8=0xBE & imm8 { XAR6 = zext(imm8:1); }
:MOVB "XAR7", "#"imm8  is rpt_phase=1 & op_hi8=0xB6 & imm8 { XAR7 = zext(imm8:1); }

# MOVB AR6/AR7, #8bit -- NARROW-WRITE siblings of MOVB XAR6/XAR7 above.
# 1101 011n CCCC CCCC  (SPRU430F p.282). Distinct from the wide-write XAR variants: this
# form writes ONLY the low 16 bits (AR6/AR7 view), leaving AR6H/AR7H unchanged. asm2000
# rejects the AR0..AR5 syntax (spec only defines the AR6/AR7 forms), so no AR0..AR5
# constructors here even though the D0..D5 opcodes carry the wide-write XAR variants.
# Missing before issue #118 -- fw-parity sweep flagged `MOVB AR7, #0xa` at 0x82bf4 as <UNDEF>.
:MOVB "AR6", "#"imm8  is rpt_phase=1 & op_hi8=0xD6 & imm8 { AR6 = zext(imm8:1); }
:MOVB "AR7", "#"imm8  is rpt_phase=1 & op_hi8=0xD7 & imm8 { AR7 = zext(imm8:1); }

# TEST ACC   1111 1111 0101 1000  (set Z/N from ACC; decode-only flags)
:TEST "ACC"  is rpt_phase=1 & op16=0xFF58 { $(Z) = (ACC == 0); $(N) = (ACC s< 0); }

# SAT ACC   1111 1111 0101 0111  (saturate ACC per OVC; modeled flow-preserving —
# the OVC-driven clamp isn't tracked, so write ACC so dataflow continues).
# SAT ACC   1111 1111 0101 0111  (saturate ACC per OVC, then clear OVC). SPRU430F 6.x:
#   if(OVC > 0): ACC = 0x7FFFFFFF; V = 1;
#   if(OVC < 0): ACC = 0x80000000; V = 1;
#   if(OVC = 0): ACC unchanged;      V = 0;
#   OVC = 0 in all cases. C is cleared. N/Z from ACC after.
# The reader of the counter -- the previous stub left ACC untouched and OVC unread,
# so a saturating math loop couldn't terminate.
:SAT "ACC"  is rpt_phase=1 & op16=0xFF57 {
    local ovc_s:1 = OVC;
    $(V) = (ovc_s != 0);
    $(C) = 0;
    if (ovc_s s<= 0) goto <not_pos>;
    ACC = 0x7FFFFFFF;
    goto <done>;
    <not_pos>
    if (ovc_s s>= 0) goto <done>;
    ACC = 0x80000000;
    <done>
    OVC = 0;
    setNZ32(ACC);
}

# LSL ACC,T   1111 1111 0101 0000  (logical shift left ACC by T(3:0)). T-register
# counterpart of LSL ACC,#imm at 0xFF3x. SPRU430F: N/Z from ACC after; C = 0 if
# T[3:0]==0 else last bit shifted out. Was missing -- see issue #104.
:LSL ACCreg, "T"  is rpt_phase=1 & op16=0xFF50 & ACCreg {
    local s:4 = zext(T) & 0xf;
    $(C) = 0;
    if (s == 0) goto <done>;
    $(C) = ((ACC >> (32 - s)) & 1) != 0;
  <done>
    ACC = ACC << s;
    setNZ32(ACC);
}
# SFR ACC,T   1111 1111 0101 0001  (shift ACC right by T(3:0); SXM-governed).
# T-register counterpart of SFR ACC,#imm at 0xFF4x. SPRU430F: arithmetic (sign-fill)
# when SXM=1, logical (zero-fill) when SXM=0. N/Z from ACC after; C = 0 if T[3:0]==0
# else last bit shifted out. Was missing -- see issue #104.
:SFR ACCreg, "T"  is rpt_phase=1 & op16=0xFF51 & ACCreg {
    local s:4 = zext(T) & 0xf;
    $(C) = 0;
    if (s == 0) goto <done>;
    $(C) = ((ACC >> (s - 1)) & 1) != 0;
  <done>
    local sxm_mask:4 = 0 - zext($(SXM));  # all-1s when SXM=1, 0 when SXM=0
    local arith:4 = ACC s>> s;
    local logic:4 = ACC >> s;
    ACC = (arith & sxm_mask) | (logic & ~sxm_mask);
    setNZ32(ACC);
}
# ROR ACC   1111 1111 0101 0010  (rotate ACC right through carry: C->b31, b0->C).
# Mirror of ROL ACC at 0xFF53. Was missing -- see issue #104.
:ROR "ACC"  is rpt_phase=1 & op16=0xFF52 {
    local oldc:4 = zext($(C)) << 31;
    $(C) = (ACC & 1) != 0;
    ACC = (ACC >> 1) | oldc;
    setNZ32(ACC);
}
# ROL ACC   1111 1111 0101 0011  (rotate ACC left through carry: C<-b31, b0<-C).
:ROL "ACC"  is rpt_phase=1 & op16=0xFF53 {
    local oldc:4 = zext($(C));
    $(C) = ((ACC >> 31) & 1) != 0;
    ACC = (ACC << 1) | oldc;
    setNZ32(ACC);
}
# NORM ACC,XARn++/--   1111 1111 0111 Xnnn  (normalize ACC, post-inc/dec XARn; X=bit3
# selects ++/--, nnn=ARn via loc_areg). Was the truncation behind 0xff77.
#
# SPRU430F pseudo-code: if ACC != 0 and (bit31 XOR bit30 == 0) then ACC <<= 1, TC = 0,
# XARn post-modifies; else TC = 1 and XARn is NOT modified. N/Z reflect ACC after.
# The prior model always stepped XARn and left ACC unchanged; both were wrong per spec
# and left TC unset -- the flag most code using NORM actually consumes.
:NORM "ACC,"loc_areg^"++"  is rpt_phase=1 & op_hi8=0xFF & op_lo765=0b011 & norm_pm=1 & loc_areg {
    local b31:4 = (ACC >> 31) & 1;
    local b30:4 = (ACC >> 30) & 1;
    local shift:1 = (ACC != 0) && (b31 == b30);
    $(TC) = !shift;
    if (!shift) goto <done>;
    ACC = ACC << 1;
    loc_areg = loc_areg + 1;
    <done>
    setNZ32(ACC);
}
:NORM "ACC,"loc_areg^"--"  is rpt_phase=1 & op_hi8=0xFF & op_lo765=0b011 & norm_pm=0 & loc_areg {
    local b31:4 = (ACC >> 31) & 1;
    local b30:4 = (ACC >> 30) & 1;
    local shift:1 = (ACC != 0) && (b31 == b30);
    $(TC) = !shift;
    if (!shift) goto <done>;
    ACC = ACC << 1;
    loc_areg = loc_areg + (-1);
    <done>
    setNZ32(ACC);
}

# =============================================================================
# Batch 9: final rts-validation gaps — MOV ACC,#16bit<<#shift, CMPB AX,#8bit.
# =============================================================================
# MOV ACC,#16bit<<#0..15   1111 1111 0010 SHFT : iiii iiii iiii iiii  (2-word)
:MOV ACCreg, "#"imm16^"<<#"^shft4 is rpt_phase=1 & op_hi8=0xFF & loc_hi4=0b0010 & shft4 & ACCreg ; imm16 {
    local s:4 = zext(shft4:1);
    mov_acc_mext_shift(imm16:2, s);
}
# CMPB AX,#8bit   0101 001A CCCC CCCC  (compare AX with zero-ext 8-bit; set flags)
# SPRU430F ch. 6 p.180: N/Z/C only, V not affected. Infinite-precision N (the
# imm side is zero-extended per spec pseudocode "AX - 0:8bit"). See #108.
:CMPB AX, "#"imm8  is rpt_phase=1 & op_hi7=0x29 & AX & imm8 {
    local a:4 = sext(AX);
    local b:4 = zext(imm8:1);
    local r:4 = a - b;
    $(C) = !(AX < zext(imm8:1));
    $(N) = (r s< 0);
    $(Z) = (r == 0);
}

# =============================================================================
# Batch 10: top missing opcodes from the byte-swapped F28377D production firmware sweep
# (these dominate the undecoded histogram on real F28377D code).
# =============================================================================
# ADDU ACC, loc16   0000 1101 LLLL LLLL  -- add zero-extended 16-bit word to ACC.
# Was MISSING — the truncation point in CAN_postRxEvent (word 0x0da0 = ADDU ACC,@AR0);
# its empty slot orphaned the following word and broke the CFG. ACC = ACC + 0:[loc16].
:ADDU ACCreg, loc16  is rpt_phase=1 & op_hi8=0x0D & ACCreg & loc16  {
    local b:4 = zext(loc16);
    $(C) = carry(ACC, b);
    ACC = ACC + b;
    setNZ32(ACC);
}
# MOVH loc16, ACC<<1   1011 0011 LLLL LLLL  -- store high word of (ACC<<1) to loc16.
# dis2000-confirmed (DIR image, op_hi8=0xB3). loc16 = bits 16..31 of (ACC<<1).
# SPRU430F: N/Z conditioned on the destination -- set from AX only when loc16=@AX.
# Same PREAD-style @AH/@AL split as tms320c28x_more.sinc:396. Issue #110.
:MOVH "@AH", "ACC<<1"  is rpt_phase=1 & op_hi8=0xB3 & ctx_AMODE=0 & loc_full8=0b10101000  {
    local v:4 = ACC << 1; AH = v(2); setNZ16(AH);
}
:MOVH "@AL", "ACC<<1"  is rpt_phase=1 & op_hi8=0xB3 & ctx_AMODE=0 & loc_full8=0b10101001  {
    local v:4 = ACC << 1; AL = v(2); setNZ16(AL);
}
:MOVH loc16, "ACC<<1"  is rpt_phase=1 & op_hi8=0xB3 & loc16  { local v:4 = ACC << 1; loc16 = v(2); }
# MOVH loc16, P     0101 0111 LLLL LLLL  -- store high 16 bits of P to loc16.
# Also MISSING — the next truncation in CAN_postRxEvent (word 0x5703 = MOVH @3,P, in an
# RPT/PREAD block-copy idiom). [loc16] = (P << PM) >> 16; PM (product-shift) not tracked
# in decode, so model the common PM=0 case: store the high word PH.
# MOVH loc16,P stores the HIGH half of the PM-shifted product (SPRU430F p.269).
# @AH/@AL specialisations set N/Z per spec (issue #110).
:MOVH "@AH", "P"  is rpt_phase=1 & pm_shift=0 & op_hi8=0x57 & ctx_AMODE=0 & loc_full8=0b10101000  {
    AH = PH; setNZ16(AH);
}
:MOVH "@AL", "P"  is rpt_phase=1 & pm_shift=0 & op_hi8=0x57 & ctx_AMODE=0 & loc_full8=0b10101001  {
    AL = PH; setNZ16(AL);
}
:MOVH "@AH", "P"  is rpt_phase=1 & pm_shift=1 & op_hi8=0x57 & ctx_AMODE=0 & loc_full8=0b10101000  {
    local v:4; pshift(v); AH = v(2); setNZ16(AH);
}
:MOVH "@AL", "P"  is rpt_phase=1 & pm_shift=1 & op_hi8=0x57 & ctx_AMODE=0 & loc_full8=0b10101001  {
    local v:4; pshift(v); AL = v(2); setNZ16(AL);
}
:MOVH loc16, "P"  is rpt_phase=1 & pm_shift=0 & op_hi8=0x57 & loc16  { loc16 = PH; }
:MOVH loc16, "P"  is rpt_phase=1 & pm_shift=1 & op_hi8=0x57 & loc16  {
    local v:4; pshift(v);
    loc16 = v(2);
}
# MOV loc16, P      0011 1111 LLLL LLLL  -- store low 16 bits of P (PM=0 modeled) to loc16.
# MOV loc16,P stores the LOW half of the PM-shifted product (SPRU430F p.270).
# @AH/@AL specialisations set N/Z per spec (issue #110).
:MOV "@AH", "P"   is rpt_phase=1 & pm_shift=0 & op_hi8=0x3F & ctx_AMODE=0 & loc_full8=0b10101000  {
    AH = PL; setNZ16(AH);
}
:MOV "@AL", "P"   is rpt_phase=1 & pm_shift=0 & op_hi8=0x3F & ctx_AMODE=0 & loc_full8=0b10101001  {
    AL = PL; setNZ16(AL);
}
:MOV "@AH", "P"   is rpt_phase=1 & pm_shift=1 & op_hi8=0x3F & ctx_AMODE=0 & loc_full8=0b10101000  {
    local v:4; pshift(v); AH = v:2; setNZ16(AH);
}
:MOV "@AL", "P"   is rpt_phase=1 & pm_shift=1 & op_hi8=0x3F & ctx_AMODE=0 & loc_full8=0b10101001  {
    local v:4; pshift(v); AL = v:2; setNZ16(AL);
}
:MOV loc16, "P"   is rpt_phase=1 & pm_shift=0 & op_hi8=0x3F & loc16  { loc16 = PL; }
:MOV loc16, "P"   is rpt_phase=1 & pm_shift=1 & op_hi8=0x3F & loc16  {
    local v:4; pshift(v);
    loc16 = v:2;
}
# MOVU ACC, loc16   0000 1110 LLLL LLLL  -- load ACC with zero-extended 16-bit word.
:MOVU ACCreg, loc16  is rpt_phase=1 & op_hi8=0x0E & ACCreg & loc16  { ACC = zext(loc16); setNZ32(ACC); }
# ADDCU ACC, loc16  0000 1100 LLLL LLLL  -- ACC = ACC + 0:[loc16] + C  (add unsigned w/ carry)
# SPRU430F: N/Z/C/V + OVC. Combined-addend pattern; C and V approximated on the
# consolidated sum (zext(loc16) + C).
:ADDCU ACCreg, loc16  is rpt_phase=1 & op_hi8=0x0C & ACCreg & loc16  {
    local cin:4 = zext($(C));
    local b:4 = zext(loc16) + cin;
    $(C) = carry(ACC, b);
    $(V) = scarry(ACC, b);
    ACC = ACC + b;
    setNZ32(ACC);
    applyOvcSigned(ACC);
}
# SBBU ACC, loc16   0001 1101 LLLL LLLL  -- ACC = ACC - 0:[loc16] - ~C  (subtract unsigned w/ borrow)
# SPRU430F: N/Z/C/V + OVC. Same combined-subtrahend shape as SUBBL.
:SBBU ACCreg, loc16  is rpt_phase=1 & op_hi8=0x1D & ACCreg & loc16  {
    local nborrow:4 = zext($(C) == 0);   # ~C as 0/1  (borrow-in)
    local b:4 = zext(loc16) + nborrow;   # combined subtrahend
    $(C) = !(ACC < b);
    $(V) = sborrow(ACC, b);
    ACC = ACC - b;
    setNZ32(ACC);
    applyOvcSigned(ACC);
}

# CLRC mode   0010 1001 CCCC CCCC  -- clear status bits per 8-bit mask (counterpart
# to SETC mode / 0x3B). Named single-bit forms + general mask. EINT = CLRC INTM.
:CLRC "SXM"   is rpt_phase=1 & op16=0x2901 { $(SXM) = 0; }
:CLRC "OVM"   is rpt_phase=1 & op16=0x2902 { $(OVM) = 0; }
:CLRC "TC"    is rpt_phase=1 & op16=0x2904 { $(TC)  = 0; }
:CLRC "C"     is rpt_phase=1 & op16=0x2908 { $(C)   = 0; }
:EINT         is rpt_phase=1 & op16=0x2910 { $(INTM)  = 0; }   # CLRC INTM (enable interrupts)
:CLRC "DBGM"  is rpt_phase=1 & op16=0x2920 { $(DBGM)  = 0; }
:CLRC "PAGE0" is rpt_phase=1 & op16=0x2940 { $(PAGE0) = 0; }
:CLRC "VMAP"  is rpt_phase=1 & op16=0x2980 { $(VMAP)  = 0; }
# General mask: clear each flag selected by imm8 (same bit->flag map as SETC #imm8).
:CLRC "#"imm8  is rpt_phase=1 & op_hi8=0x29 & imm8 {
    local m:1 = imm8;
    $(SXM)   = $(SXM)   && (m[0,1] == 0);
    $(OVM)   = $(OVM)   && (m[1,1] == 0);
    $(TC)    = $(TC)    && (m[2,1] == 0);
    $(C)     = $(C)     && (m[3,1] == 0);
    $(INTM)  = $(INTM)  && (m[4,1] == 0);
    $(DBGM)  = $(DBGM)  && (m[5,1] == 0);
    $(PAGE0) = $(PAGE0) && (m[6,1] == 0);
    $(VMAP)  = $(VMAP)  && (m[7,1] == 0);
}

# RPT #8bit   1111 0110 CCCC CCCC  -- repeat next instruction (count+1 times).
# RPT loc16   1111 0111 LLLL LLLL  -- repeat count from [loc16] (+1).
#
# The loop is realised by the `:^instruction is rpt_phase=0 & rpt_active=1 &
# instruction` wrapper in tms320c28x_rpt.sinc: the body here loads the raw N
# into RPTC and, at inst_next, arms rpt_active=1 alongside dropping rpt_phase
# to 0 (the wrapper's decode-time trigger -- see the "phase-bit partition"
# comment in tms320c28x_rpt.sinc for why both bits are required). The wrapper
# builds the repeated instruction once, then decrements RPTC and jumps back to
# inst_start N more times. Total executions = N + 1, matching SPRU430F.
# Ported from mwdmwd/ghidra-c28x (Apache-2.0); see THIRD-PARTY.md.
:RPT "#"imm8  is op_hi8=0xF6 & imm8 & rpt_phase=1
        [ rpt_active=1; rpt_phase=0;
          globalset(inst_next, rpt_active); globalset(inst_next, rpt_phase); ] {
    RPTC = zext(imm8:1);
}
:RPT loc16    is op_hi8=0xF7 & loc16 & rpt_phase=1
        [ rpt_active=1; rpt_phase=0;
          globalset(inst_next, rpt_active); globalset(inst_next, rpt_phase); ] {
    RPTC = loc16;
}

# XOR loc16, AX   1111 001A LLLL LLLL  -- store-side XOR (loc ^= AX). A bit -> AL/AH.
# SPRU430F: N/Z from the result at [loc16]. Was flag-silent -- see issue #108.
:XOR loc16, AX  is rpt_phase=1 & op_hi7=0x79 & loc16 & AX  { loc16 = loc16 ^ AX; setNZ16(loc16); }

# =============================================================================
# Batch 11: more top misses from the byte-swapped F28377D production firmware sweep.
# =============================================================================
# ADDB XARn,#7bit   1101 1nnn 0CCC CCCC  (bit7=0; SUBB XARn is the bit7=1 form).
:ADDB xarn_hi3, "#"sp7  is rpt_phase=1 & op_hi5=0b11011 & xarn_hi3 & loc_b7=0 & sp7 {
    xarn_hi3 = xarn_hi3 + zext(sp7:1);
}

# ADRK #8bit    1111 1100 CCCC CCCC   -- XAR(ARP) += zext(imm8).
# SBRK #8bit    1111 1101 CCCC CCCC   -- XAR(ARP) -= zext(imm8).
# Both are ARP-selected register arithmetic (SPRU430F ch. 6). We do not track
# ARP as state (see docs/DESIGN.md discussion of *,*++ etc.), so model as XAR0 --
# the same silent-wrong-when-ARP!=0 convention the C2xLP ARP-implicit addressing
# modes use. dis2000 renders these with no register in the listing (`SBRK #71`),
# so a wrong-XAR here is invisible in the text; a future ARP model fixes both at
# once. Neither instruction touches status flags.
:ADRK "#"imm8  is rpt_phase=1 & op_hi8=0xFC & imm8 {
    XAR0 = XAR0 + zext(imm8:1);
}
:SBRK "#"imm8  is rpt_phase=1 & op_hi8=0xFD & imm8 {
    XAR0 = XAR0 - zext(imm8:1);
}

# --- 0xFF-prefix fixed/shift forms ------------------------------------------
# ABS ACC          1111 1111 0101 0110  (ACC = |ACC|). SPRU430F: N/Z from result,
# C cleared, V set if the input was 0x80000000 (the one value with no positive counterpart).
# flag-audit-ovc: none -- SPRU430F Table 2-5 does not list ABS in any OVC-affecting
# category; the instruction's own flag table lists only N,Z,C,V,OVM.
# SPRU430F ch. 6 p.369: N/Z/C/V + OVM saturation. C is always cleared. V=1 iff
# input==0x80000000; OVM=1 saturates ACC to 0x7FFFFFFF (positive max), OVM=0 wraps.
# Was missing OVM saturation -- see issue #106.
:ABS "ACC"   is rpt_phase=1 & op16=0xFF56 {
    $(V) = (ACC == 0x80000000);
    $(C) = 0;
    if (ACC s>= 0) goto <positive>;
    ACC = -ACC;
    <positive>
    applyOvmSaturate32(ACC);
    setNZ32(ACC);
}
# MOVL P,ACC       1111 1111 0101 1010
:MOVL "P", ACCreg  is rpt_phase=1 & op16=0xFF5A & ACCreg { P = ACC; }
# SPM PM           1111 1111 0110 1xxx  (set product shift mode). PM now holds the
# DECODED signed shift amount (-6..+1); packst0 re-encodes it to the raw ST0[7,3]
# field as (1 - shift). Matches mwdmwd/ghidra-c28x's PM convention.
:SPM "+1"  is rpt_phase=1 & op16=0xFF68 { $(PM) =  1; }
:SPM "0"   is rpt_phase=1 & op16=0xFF69 { $(PM) =  0; }
:SPM "-1"  is rpt_phase=1 & op16=0xFF6A { $(PM) = -1; }
:SPM "-2"  is rpt_phase=1 & op16=0xFF6B { $(PM) = -2; }
:SPM "-3"  is rpt_phase=1 & op16=0xFF6C { $(PM) = -3; }
:SPM "-4"  is rpt_phase=1 & op16=0xFF6D { $(PM) = -4; }
:SPM "-5"  is rpt_phase=1 & op16=0xFF6E { $(PM) = -5; }
:SPM "-6"  is rpt_phase=1 & op16=0xFF6F { $(PM) = -6; }
# ADD ACC,#16bit<<#0..15   1111 1111 0001 SHFT : iiii iiii iiii iiii  (2-word)
# SPRU430F: N,Z,C,V per the 32-bit add of ACC + (mext(#imm16) << s).
:ADD ACCreg, "#"imm16^"<<#"^shft4  is rpt_phase=1 & op_hi8=0xFF & loc_hi4=0b0001 & shft4 & ACCreg ; imm16 {
    local v:4; local s:4 = zext(shft4:1);
    mext(v, imm16:2);
    local addend:4 = v << s;
    $(C) = carry(ACC, addend);
    $(V) = scarry(ACC, addend);
    ACC = ACC + addend;
    setNZ32(ACC);
    applyOvcSigned(ACC);
}
# LSL ACC,#1..16   1111 1111 0011 SHFT  (logical shift left ACC; SHFT=0 -> 16). Single
# word. C = last bit shifted out (= ACC bit 32-sh, pre-shift); N/Z from the result.
:LSL ACCreg, "#"shcount  is rpt_phase=1 & op_hi8=0xFF & loc_hi4=0b0011 & ACCreg & shcount {
    local sh:4 = zext(shcount);
    $(C) = ((ACC >> (32 - sh)) & 1) != 0;
    ACC = ACC << sh;
    setNZ32(ACC);
}
# SFR ACC,#1..16   1111 1111 0100 SHFT  (shift ACC right; SHFT=0 -> 16). Single word.
# Reuse the shcount subtable (= shft4+1) used by the AX immediate shifts.
#
# SPRU430F: SFR is SXM-governed -- arithmetic (sign-fill) right shift when SXM=1,
# logical (zero-fill) when SXM=0. N/Z from the ACC result; C = last bit shifted out.
# The prior body always did the logical form, dropping the sign for SXM=1 sites, and
# wrote no flags -- both fixed here.
:SFR ACCreg, "#"shcount  is rpt_phase=1 & op_hi8=0xFF & loc_hi4=0b0100 & ACCreg & shcount {
    local sh:4 = zext(shcount);
    $(C) = ((ACC >> (sh - 1)) & 1) != 0;
    local sxm_mask:4 = 0 - zext($(SXM));  # all-1s when SXM=1, 0 when SXM=0
    local arith:4 = ACC s>> sh;
    local logic:4 = ACC >> sh;
    ACC = (arith & sxm_mask) | (logic & ~sxm_mask);
    setNZ32(ACC);
}
# SUB ACC,#16bit<<#0..15   1111 1111 0000 SHFT : iiii  (2-word; counterpart to the
# ADD ACC,#16bit<<# at 0xFF1x). 0xff00/0xff0f etc.
#
# Canonical variant (switch_canonical=1): same numeric result plus C=1 and N/Z from
# the ACC result. TMS320C28xSwitchAnalyzer sets this bit on the "SUB ACC,#(2*low)"
# range-subtraction instruction of a validated switch dispatch (only present on the
# 32-bit-selector variants -- see the guardCanonicalInstruction path in the analyzer).
# The flag-set + carry pair matches TI's own semantics for the operation and lets the
# subsequent CMPB/CMPL bounds check reason from the post-SUB ACC. Adapted from
# mwdmwd/ghidra-c28x (Apache-2.0); see THIRD-PARTY.md.
:SUB ACCreg, "#"imm16^"<<#"^shft4  is rpt_phase=1 & switch_canonical=1 & op_hi8=0xFF & loc_hi4=0b0000 & shft4 & ACCreg ; imm16 {
    local v:4 = zext(imm16:2); local s:4 = zext(shft4:1);
    ACC = ACC - (v << s);
    $(C) = 1;
    setNZ32(ACC);
}
:SUB ACCreg, "#"imm16^"<<#"^shft4  is rpt_phase=1 & op_hi8=0xFF & loc_hi4=0b0000 & shft4 & ACCreg ; imm16 {
    local v:4; local s:4 = zext(shft4:1);
    mext(v, imm16:2);
    local subend:4 = v << s;
    $(C) = !(ACC < subend);
    $(V) = sborrow(ACC, subend);
    ACC = ACC - subend;
    setNZ32(ACC);
    applyOvcSigned(ACC);
}
# NOT AX   1111 1111 0101 111A  (complement AL/AH; A=bit0).
:NOT AXb0  is rpt_phase=1 & op_hi8=0xFF & op_lo71=0b0101111 & AXb0  { AXb0 = ~AXb0; setNZ16(AXb0); }
# NEG AX   1111 1111 0101 110A  (negate AL/AH; A=bit0). dis2000-confirmed (DIR image).
:NEG AXb0  is rpt_phase=1 & op_hi8=0xFF & op_lo71=0b0101110 & AXb0  {
    $(C) = (AXb0 == 0);  # carry set only when result is 0 (per SPRU430F)
    $(V) = (AXb0 == 0x8000);
    AXb0 = -AXb0;
    setNZ16(AXb0);
}

# =============================================================================
# Batch 13: remaining firmware tail (each 33-72 sites; verified vs SPRU430F).
# =============================================================================
# ADD ACC, loc16 <<#0   1000 0001 LLLL LLLL  (single word; base form of the
# ADD ACC,loc16<<#shift family). Extended per SXM. Was the truncation in the first
# fragment of FUN_0009099d (word 0x81a3).
:ADD ACCreg, loc16  is rpt_phase=1 & op_hi8=0x81 & ACCreg & loc16 {
    local b:4;
    mext(b, loc16);
    $(C) = carry(ACC, b);
    $(V) = scarry(ACC, b);
    ACC = ACC + b;
    setNZ32(ACC);
    applyOvcSigned(ACC);
}
# SUB ACC, loc16 <<#0   1010 1110 LLLL LLLL  (single word; SUB counterpart of the
# 0x81 ADD base form). Was the truncation behind word 0xae3e.
:SUB ACCreg, loc16  is rpt_phase=1 & op_hi8=0xAE & ACCreg & loc16 {
    local b:4;
    mext(b, loc16);
    $(C) = !(ACC < b);
    $(V) = sborrow(ACC, b);
    ACC = ACC - b;
    setNZ32(ACC);
    applyOvcSigned(ACC);
}
# ADD ACC, loc16 <<#16   0000 0101 LLLL LLLL  (single word; add loc<<16 to ACC).
:ADD ACCreg, loc16^"<<#16"  is rpt_phase=1 & op_hi8=0x05 & ACCreg & loc16 {
    local v:4 = zext(loc16) << 16;
    $(C) = carry(ACC, v);
    $(V) = scarry(ACC, v);
    ACC = ACC + v;
    setNZ32(ACC);
    applyOvcSigned(ACC);
}
# SUB ACC, loc16 <<#16   0000 0100 LLLL LLLL  (single word; subtract loc<<16 from ACC).
# Completes the ACC,loc16<<#16 family (MOV=0x25, ADD=0x05 above; SUB=0x04 was the
# missing sibling). dis2000-confirmed: 0x044e = SUB ACC,*-SP[14]<<16.
:SUB ACCreg, loc16^"<<#16"  is rpt_phase=1 & op_hi8=0x04 & ACCreg & loc16 {
    local v:4 = zext(loc16) << 16;
    $(C) = !(ACC < v);
    $(V) = sborrow(ACC, v);
    ACC = ACC - v;
    setNZ32(ACC);
    applyOvcSigned(ACC);
}
# CMP loc16, #16bitSigned   0001 1011 LLLL LLLL : iiii  (2-word; flags only).
# SPRU430F ch. 6 p.178: N/Z/C, V not affected. Was missing C entirely and used
# finite-precision N. Infinite-precision N via 4-byte sext; C from the
# unsigned compare of the raw operands. See #108.
:CMP loc16, "#"simm16  is rpt_phase=1 & op_hi8=0x1B & loc16 ; simm16 {
    local x:2 = loc16; local y:2 = simm16:2;
    local a:4 = sext(x);
    local b:4 = sext(y);
    local r:4 = a - b;
    $(C) = !(x < y);
    $(N) = (r s< 0);
    $(Z) = (r == 0);
}
# MPYU ACC,T,loc16   0011 0110 LLLL LLLL  (unsigned 16x16 -> ACC).
# SPRU430F: N,Z on the ACC write.
:MPYU ACCreg, Treg, loc16  is rpt_phase=1 & op_hi8=0x36 & ACCreg & Treg & loc16 {
    local a:4 = zext(T); local b:4 = zext(loc16); ACC = a * b;
    setNZ32(ACC);
}
# SUB loc16, AX   0111 010A LLLL LLLL  ([loc16] = [loc16] - AX).  C/V/N/Z.
# SPRU430F p.419: despite the manual's "Reverse-Subtract ... From AX" title, the
# Description/Example are unambiguous (`SUB @AR0,AL ; AR0 = AR0 - AL`).  This used
# to emit `AX - loc16` (that's SUBR's job, right below) and set no flags -- see #56.
:SUB loc16, AX  is rpt_phase=1 & op_hi7=0x3A & loc16 & AX  {
    local m:2 = loc16;
    $(C) = !(m < AX);
    $(V) = sborrow(m, AX);
    loc16 = m - AX;
    setNZ16(loc16);
}
# SUBR loc16, AX  1110 101A LLLL LLLL  (reverse-subtract store: [loc16] = AX - [loc16]).
# Confirmed via dis2000 (word 0xeaa8) — the binary-pattern grep missed it. C/V/N/Z.
:SUBR loc16, AX  is rpt_phase=1 & op_hi7=0x75 & loc16 & AX  {
    local m:2 = loc16;
    $(C) = !(AX < m);
    $(V) = sborrow(AX, m);
    loc16 = AX - m;
    setNZ16(loc16);
}
# ADD loc16, AX   0111 001A LLLL LLLL  (store-side add: [loc16] = [loc16] + AX). Was
# MISSING — truncation in FUN_000900f8 (word 0x72a6 = ADD *+XAR2[AR0],AL). C/V/N/Z.
:ADD loc16, AX  is rpt_phase=1 & op_hi7=0x39 & loc16 & AX  {
    local m:2 = loc16;
    $(C) = carry(m, AX);
    $(V) = scarry(m, AX);
    loc16 = m + AX;
    setNZ16(loc16);
}

# =============================================================================
# Batch 14: gap revealed once the empty-body status/mode ops emit p-code (flow
# now continues into this store). Verified vs SPRU430F.
# =============================================================================
# MOV loc16, *(0:16bit)   1111 0101 LLLL LLLL : CCCC CCCC CCCC CCCC  (2-word).
# Move the 16-bit value at absolute data address 0:imm16 into loc16. Was the
# truncation after FUN_00093327 / FUN_00093407 (load form).
:MOV loc16, "*(0:"imm16")"  is rpt_phase=1 & op_hi8=0xF5 & loc16 ; imm16  {
    local a:4 = zext(imm16:2);
    loc16 = *[ram]:2 a;
    setNZ16(loc16);
}
# MOV *(0:16bit), loc16   1111 0100 LLLL LLLL : CCCC CCCC CCCC CCCC  (2-word).
# Store counterpart of the above: [0:imm16] = [loc16]. The next gap behind the
# 0xF5 load once flow continued past it (word 0xf4a9 after FUN_00093327/407).
:MOV "*(0:"imm16"),"^loc16  is rpt_phase=1 & op_hi8=0xF4 & loc16 ; imm16  {
    local a:4 = zext(imm16:2);
    *[ram]:2 a = loc16;
}

# =============================================================================
# I/O port instructions (SPRU430F ch.6): IN / OUT / UOUT
# =============================================================================
# The C28x I/O space is architecturally distinct from data memory. All three
# instructions are 2-word: word1 low byte = standard loc16 field, word2 = 16-bit
# I/O port address (the "*(PA)" operand).
#
#   IN   loc16, *(PA)   1011 0100 LLLL LLLL : PPPP PPPP PPPP PPPP   (read from port)
#   UOUT *(PA), loc16   1011 0000 LLLL LLLL : PPPP PPPP PPPP PPPP   (write, unprotected)
#   OUT  *(PA), loc16   1011 1100 LLLL LLLL : PPPP PPPP PPPP PPPP   (write, protected)
#
# UOUT and OUT differ only in whether the write is gated by the I/O-space
# protection bit; semantically they both move loc16 to the port. Modeled as
# pcodeop intrinsics so the data flow is visible (loc16 -> port write is not
# a memory access we can fold into a store). Verified against asm2000.
define pcodeop ioread;    # IN         : value = ioread(portAddr)
define pcodeop iowrite;   # OUT / UOUT : iowrite(portAddr, value)

:IN loc16, "*("imm16")"  is rpt_phase=1 & op_hi8=0xB4 & loc16 ; imm16 {
    loc16 = ioread(imm16:2);
}
:UOUT "*("imm16"),"^loc16  is rpt_phase=1 & op_hi8=0xB0 & loc16 ; imm16 {
    iowrite(imm16:2, loc16);
}
:OUT "*("imm16"),"^loc16   is rpt_phase=1 & op_hi8=0xBC & loc16 ; imm16 {
    iowrite(imm16:2, loc16);
}

# =============================================================================
# Stray misses from the fw-parity sweep after the harness fix surfaced them.
# =============================================================================
# MOVB loc16, AX.MSB   1100 100A LLLL LLLL   (single-word). Store MSB byte of
# AX (bits 15..8) into low byte of [loc16]; high byte of [loc16] is zeroed per
# SPRU430F. Peer to the existing MOVB AX.LSB store (op_hi7=0x1E) and MOVB
# AX.MSB load (op_hi7=0x1C); this is the missing MSB store direction.
:MOVB loc16, AX^".MSB"  is rpt_phase=1 & op_hi7=0x64 & AX & loc16 {
    loc16 = (AX >> 8) & 0xFF;
}

# MOV XARn, PC   0011 1110 0101 1nnn   (single-word). Copies the PC of the next
# instruction into XARn -- position-independent lookup idiom. C28x PC is a
# 22-bit WORD address; SLEIGH's inst_next is byte-based, so shift right 1 to
# match what hardware writes.
:MOV loc_areg, "PC"  is rpt_phase=1 & op_hi8=0x3E & op_lo_hi5=0b01011 & loc_areg {
    loc_areg = inst_next >> 1;
}
