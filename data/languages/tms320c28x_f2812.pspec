<!-- See Relax specification: Ghidra/Framework/SoftwareModeling/data/languages/processor_spec.rxg -->

<!-- Processor spec for the TMS320F2812 (and the pin/memory-compatible F2810/F2811),
     the original fixed-point C28x family (F281x). This is a DEVICE variant of the
     shared C28x SLEIGH core: it reuses the same tms320c28x.sla and .cspec (the F2812
     instruction set is a strict subset of the decoded ISA — no FPU/TMU/VCU/CLA), and
     differs from the F2837xD default only in the DEVICE-specific memory map: the
     peripheral (MMIO) frames and the interrupt vectors live at F281x addresses, not
     F2837xD ones. Addresses are WORD addresses (the C28x is word-addressable; 1 addr
     = 16 bits). Verified against the device datasheet SPRS174V (memory map Figure 9-13)
     and the TI DSP281x header package (peripheral bases in DSP281x_Headers_nonBIOS.cmd). -->
<processor_spec>
  <programcounter register="PC"/>

  <!-- Disable Ghidra's heuristic no-return / shared-return analyzers for this processor.
       Same rationale as the F28377D pspec: on C28x images the heuristic "Non-Returning
       Functions - Discovered" mis-marks flash-to-RAM copied functions (.ramfunc) as
       non-returning and truncates their genuine flash callers into ?? data. Both stock
       analyzers honor these language properties in getDefaultEnablement() (ARM's pspec does
       the same). Re-enable per-program in Analysis Options if a specific image needs it. -->
  <properties>
    <property key="enableNoReturnAnalysis"     value="false"/>
    <property key="enableSharedReturnAnalysis" value="false"/>
  </properties>

  <!-- AMODE context bit: 0 = C28x addressing modes (compiler default). -->
  <context_data>
    <context_set space="ram">
      <set name="ctx_AMODE" val="0"/>
    </context_set>
  </context_data>

  <!-- Peripheral-register (MMIO) ranges marked volatile so the decompiler never elides
       or reorders reads/writes to hardware registers (a status poll or a write-to-clear
       must not be optimized away). F2812 peripheral frames (SPRS174V, word addresses):
         0x000800-0x000CFF  Peripheral Frame 0: DevEmu, Flash/OTP cfg, CSM, XINTF cfg,
                            CPU timers 0/1/2, PIE control (PIECTRL/PIEACK/PIEIERx/PIEIFRx)
         0x006000-0x006FFF  Peripheral Frame 1 (protected): eCAN-A (control regs +
                            LAM/MOTS/MOTO + 32 mailboxes)
         0x007000-0x007FFF  Peripheral Frame 2 (protected): SysCtrl/PLL/WD, SPI-A, SCI-A,
                            external-interrupt, GPIO mux/data, ADC, EV-A, EV-B, SCI-B,
                            McBSP-A
       The PIE vector table at 0x000D00-0x000DFF is writable RAM (interrupt-pointer
       table), NOT MMIO — deliberately left non-volatile so it reads as pointer data.
       On-chip SARAM (M0/M1/L0/L1/H0) and flash are likewise NOT volatile. -->
  <volatile outputop="write_volatile" inputop="read_volatile">
    <range space="ram" first="0x000800" last="0x000CFF"/>
    <range space="ram" first="0x006000" last="0x007FFF"/>
  </volatile>

  <default_symbols>
    <!-- C28x CPU interrupt vector table, boot-ROM (BROM) vector map at 0x3FFFC0
         (SPRU430F Table 3-1; enabled when VMAP=1, MP/MC=0, ENPIE=0). Word addresses.
         On a device using the PIE (ENPIE=1) the live vectors are instead in the PIE
         vector RAM at 0x000D00 (see PIE_VECT below) — these BROM names still correctly
         label the reset/CPU vector fetch entries. -->
    <symbol name="RESET"   address="ram:0x3FFFC0" entry="true"/>
    <symbol name="INT1"    address="ram:0x3FFFC2"/>
    <symbol name="INT2"    address="ram:0x3FFFC4"/>
    <symbol name="INT3"    address="ram:0x3FFFC6"/>
    <symbol name="INT4"    address="ram:0x3FFFC8"/>
    <symbol name="INT5"    address="ram:0x3FFFCA"/>
    <symbol name="INT6"    address="ram:0x3FFFCC"/>
    <symbol name="INT7"    address="ram:0x3FFFCE"/>
    <symbol name="INT8"    address="ram:0x3FFFD0"/>
    <symbol name="INT9"    address="ram:0x3FFFD2"/>
    <symbol name="INT10"   address="ram:0x3FFFD4"/>
    <symbol name="INT11"   address="ram:0x3FFFD6"/>
    <symbol name="INT12"   address="ram:0x3FFFD8"/>
    <symbol name="INT13"   address="ram:0x3FFFDA"/>
    <symbol name="INT14"   address="ram:0x3FFFDC"/>
    <symbol name="DLOGINT" address="ram:0x3FFFDE"/>
    <symbol name="RTOSINT" address="ram:0x3FFFE0"/>
    <symbol name="NMI"     address="ram:0x3FFFE4"/>
    <symbol name="ILLEGAL" address="ram:0x3FFFE6"/>
    <symbol name="USER1"   address="ram:0x3FFFE8"/>
    <symbol name="USER2"   address="ram:0x3FFFEA"/>
    <symbol name="USER3"   address="ram:0x3FFFEC"/>
    <symbol name="USER4"   address="ram:0x3FFFEE"/>
    <symbol name="USER5"   address="ram:0x3FFFF0"/>
    <symbol name="USER6"   address="ram:0x3FFFF2"/>
    <symbol name="USER7"   address="ram:0x3FFFF4"/>
    <symbol name="USER8"   address="ram:0x3FFFF6"/>
    <symbol name="USER9"   address="ram:0x3FFFF8"/>
    <symbol name="USER10"  address="ram:0x3FFFFA"/>
    <symbol name="USER11"  address="ram:0x3FFFFC"/>
    <symbol name="USER12"  address="ram:0x3FFFFE"/>
  </default_symbols>
</processor_spec>
