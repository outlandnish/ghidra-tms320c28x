# Copyright 2026 Nishanth Samala
# Copyright the mwdmwd/ghidra-c28x contributors (https://github.com/mwdmwd/ghidra-c28x)
#
# Portions adapted from mwdmwd/ghidra-c28x (Apache-2.0): the unpacked status-flag
# model (each ST0/ST1 status bit defined as its own register in the 0x100/0x110
# blocks, with the $(NAME) flag macros expanding to those registers) and the
# ffc_return / switch_canonical decode-context bits. See THIRD-PARTY.md.
#
# SLEIGH specification for the TI TMS320C28x fixed-point DSP core.
# Target device: TMS320F28377D (dual C28x + FPU).
# Source: SPRU430F - TMS320C28x CPU and Instruction Set Reference Guide.
#
# KEY ARCHITECTURAL FACT: the C28x is WORD-ADDRESSABLE. The smallest addressable
# unit is 16 bits ("byte" == 16 bits on this CPU). We model this with wordsize=2
# on the data/code space so one address == one 16-bit word, which is what makes
# XREFs to peripheral (e.g. CAN) registers land correctly.

define endian=little;
define alignment=2;

# --- Address spaces -----------------------------------------------------------
# The C28x has a UNIFIED address space: program and data share one 22-bit/32-bit
# address map (the same address, e.g. 0x048000 for CANA, is reached by either the
# program or data bus). So we model ONE space `ram` (not separate CODE/DATA) -- this
# matches the hardware AND satisfies the decompiler, which requires the default space
# to be the global space. wordsize=2 => addressable unit is a 16-bit word (the C28x
# "16-bit byte").
define space ram      type=ram_space      size=4  wordsize=2  default;
define space register type=register_space size=4;

# =============================================================================
# Register file (SPRU430F Table 2-1, Figure 2-2).
# Little-endian layout: a 32-bit register's low 16 bits sit at the lower offset,
# so ACC[0:2]=AL, ACC[2:2]=AH, etc.  Bytes within AH/AL are also accessible.
# =============================================================================

# --- Accumulator + Product joined as ACC_P[64] so 64-bit ACC:P ops decompile
# as one value (was: ACC@0x00 size=4, P@0x08 size=4 non-adjacent -> every
# 64-bit shift/neg/cmp/zap decompiled as CONCAT44(ACC, P)).
# ACC:P convention is ACC = high 32, P = low 32 (SPRU430F). In LE, that means
# P (low) must sit at the LOWER offset and ACC (high) at the HIGHER offset.
# So the size=4 view lists [ P ACC ] — P@0x00, ACC@0x04 — and reading ACC_P
# as a 64-bit int naturally gives (ACC << 32) | P. Halves inside each 32-bit
# register keep the usual LE convention (H at higher offset within its register).
define register offset=0x00 size=8 [ ACC_P ];
define register offset=0x00 size=4 [ P ACC ];
define register offset=0x00 size=2 [ PL PH AL AH ];
define register offset=0x00 size=1 [ PL_LSB PL_MSB PH_LSB PH_MSB AL_LSB AL_MSB AH_LSB AH_MSB ];
# 0x08-0x0F: previously held P; now free for future use.

# --- Multiplicand register: XT[32] = T[16]:TL[16]  (T is the HIGH half)
define register offset=0x10 size=4 [ XT ];
define register offset=0x10 size=2 [ TL T ];

# --- Auxiliary registers: XARn[32] = ARnH[16]:ARn[16]  (ARn is the LOW half)
define register offset=0x20 size=4 [ XAR0 XAR1 XAR2 XAR3 XAR4 XAR5 XAR6 XAR7 ];
define register offset=0x20 size=2 [ AR0 AR0H AR1 AR1H AR2 AR2H AR3 AR3H
                                     AR4 AR4H AR5 AR5H AR6 AR6H AR7 AR7H ];

# --- Pointers and program counters
# SP is 16-bit on the C28x but the stack always lives in low RAM, so we model it
# as a 4-byte pointer to match the address-space width. This eliminates the
# `ZEXT24(&stack…)` casts (and `& 0xffff` wrap masks) the decompiler would
# otherwise emit at every stack access. SPL/SPH alias the halves for the rare
# 16-bit-mode uses (e.g. `@SP` in loc16 addressing).
define register offset=0x40 size=2 [ DP ];
define register offset=0x54 size=4 [ SP ];
define register offset=0x54 size=2 [ SPL SPH ];
define register offset=0x44 size=4 [ PC RPC ];   # 22-bit values held in 32-bit slots

# --- Status registers
define register offset=0x50 size=2 [ ST0 ST1 ];

# --- Status flags as individual registers (unpacked model) -------------------
# Every ST0/ST1 status bit is modeled as its own 1-byte register; the packed
# ST0/ST1 words are assembled/disassembled on demand by the packst0/unpackst0 and
# packst1/unpackst1 macros (see tms320c28x_more.sinc) -- only PUSH/POP ST0|ST1
# touch the packed words. This unpacked model lets the decompiler track individual
# flags (better conditional recovery) and lets the compiler spec assert TI
# C-runtime boundary values (PM=OVM=PAGE0=0, SPRU514 Table 7-4) via
# <context_data><tracked_set>, which requires real register names -- a bit-slice
# like ST0[7,3] cannot be named there (Ghidra rejects the whole language at load
# with "Unknown register: PM"). Adapted from mwdmwd/ghidra-c28x (Apache-2.0);
# see the file header and THIRD-PARTY.md.
#
# ST0 (SPRU430F 2.3): SXM(0) OVM(1) TC(2) C(3) Z(4) N(5) V(6) PM(7-9) OVC(10-15).
#   PM holds the DECODED signed product-shift (-6..+1); packst0 converts it to the
#   raw ST0[7,3] field. OVC is the 6-bit signed overflow counter.
# ST1 (SPRU430F 2.4): INTM(0) DBGM(1) PAGE0(2) VMAP(3) SPA(4) LOOP(5) EALLOW(6)
#   IDLESTAT(7) AMODE(8) OBJMODE(9) M0M1MAP(11) XF(12) ARP(13-15).
define register offset=0x100 size=1 [ SXM OVM TC C Z N V PM OVC ];
define register offset=0x110 size=1 [ INTM DBGM PAGE0 VMAP SPA LOOP EALLOW IDLESTAT AMODE OBJMODE M0M1MAP XF ARP ];

# --- Interrupt control
define register offset=0x58 size=2 [ IFR IER DBGIER ];

# --- FPU registers (F2837x C28x+FPU, spruhs1c ch.1) ---------------------------
# Eight 32-bit float result registers, the FPU status register, and the repeat
# block register. Used by the (decode-only) FPU instruction variant.
define register offset=0x60 size=4 [ R0H R1H R2H R3H R4H R5H R6H R7H ];
define register offset=0x90 size=4 [ STF RB ];

# --- RPT / RPTB loop-control registers ---------------------------------------
# Model the C28x hardware repeat state as named registers so the RPT/RPTB
# `^instruction` prefix wrappers (tms320c28x_flow.sinc) can express the loop
# entirely in SLEIGH p-code -- no state modifier needed for the loop itself.
#   RPTC          single-instruction repeat counter (RPT loads, wrapper decrements)
#   RB_RSTART     byte address of the first instruction of an RPTB block
#   RB_RC         RPTB loop counter (decremented once per pass by the wrapper)
#   RB_RSIZE      RPTB block size in words (as loaded from imm7)
#   RB_RA         RPTB "active" flag stored in the body constructor
#   RB_RE         low 7 bits of the block-end address (hardware fidelity only)
# Offsets adopted from mwdmwd/ghidra-c28x (Apache-2.0). PUSH/POP RB still uses
# the packed RB @0x90 above -- these split slots exist purely for the wrappers.
define register offset=0x122 size=2 [ RPTC ];
define register offset=0x324 size=4 [ RB_RSTART ];
define register offset=0x328 size=2 [ RB_RC ];
define register offset=0x32a size=1 [ RB_RE RB_RSIZE RB_RA ];

# --- STF status flags (unpacked model) ---------------------------------------
# STF's flag bits split into individual 1-byte registers so the decompiler can
# track each flag independently -- the CMPF32 -> conditional-branch idiom then
# survives without the packed STF[0,1] slice reads that the decompiler cannot
# name in the compiler spec. Mirrors the ST0/ST1 unpacked model above. The
# packed STF register at 0x90 is materialized on demand by the packstf/unpackstf
# macros in tms320c28x_fpu.sinc, invoked at the rare STF <-> memory move sites.
# Adapted from mwdmwd/ghidra-c28x (Apache-2.0); see THIRD-PARTY.md.
# Field order matches STF bit numbering (SPRUHS1C Table 2-2):
#   STF[0]=LVF STF[1]=LUF STF[2]=NF STF[3]=ZF STF[4]=NI STF[5]=ZI STF[6]=TF
define register offset=0x124 size=1 [ STF_LV STF_LU STF_NF STF_ZF STF_NI STF_ZI STF_TF ];
# The two non-condition STF bits, kept out of the run above because they are not
# contiguous with it (SPRUHS1C Table 1-2): STF[9] = RND32 (0 = MPYF32/ADDF32/SUBF32
# truncate, 1 = round to nearest even) and STF[31] = SHDWS (set by SAVE, cleared by
# RESTORE). SETFLG can write RND32, so it needs somewhere to land.
define register offset=0x12C size=1 [ STF_RND STF_SHDWS ];

# --- FPU shadow register set (SAVE / RESTORE) --------------------------------
# SAVE copies R0H-R7H and STF here in one cycle and RESTORE copies them back; it is
# the register-preservation path for high-priority interrupts that cannot themselves
# be interrupted (low-priority handlers push to the stack instead). Modelling them as
# real registers rather than leaving SAVE/RESTORE as no-ops means an ISR that brackets
# its body with SAVE/RESTORE no longer looks like it clobbers the interrupted code's
# float registers.
define register offset=0x140 size=4 [ R0H_s R1H_s R2H_s R3H_s R4H_s R5H_s R6H_s R7H_s STF_s ];

# --- VCU-II registers (F2837x C28x+VCU, spruhs1c ch.5) ------------------------
# General-purpose VR0-VR8, transition-bit regs, status, and the CRC result reg.
# Used by the (decode-only) VCU/VCRC instructions -- relevant because CAN-message
# CRCs are computed here. VR0-VR8 = 9 regs.
define register offset=0xA0 size=4 [ VR0 VR1 VR2 VR3 VR4 VR5 VR6 VR7 VR8 ];
define register offset=0xC8 size=4 [ VT0 VT1 VSTATUS VCRC ];

# =============================================================================
# Status-flag macros. Each expands to the individual flag REGISTER (unpacked model,
# defined above); the packed ST0/ST1 words are only materialized by the pack/unpack
# macros on PUSH/POP ST0|ST1. Keeping the $(NAME) indirection means every instruction
# body that sets a flag is unchanged by the packed->unpacked switch. (SPRU430F 2.3-2.4.)
# =============================================================================
@define SXM   "SXM"       # sign-extension mode        ST0[0]
@define OVM   "OVM"       # overflow mode              ST0[1]
@define TC    "TC"        # test/control flag          ST0[2]
@define C     "C"         # carry                      ST0[3]
@define Z     "Z"         # zero                       ST0[4]
@define N     "N"         # negative                   ST0[5]
@define V     "V"         # overflow                   ST0[6]
@define PM    "PM"        # product shift mode, signed ST0[7,3]
@define AMODE "AMODE"     # addressing-mode select bit ST1[8]
@define INTM   "INTM"     # interrupt global mask      ST1[0]
@define DBGM   "DBGM"     # debug enable mask          ST1[1]
@define PAGE0  "PAGE0"    # PAGE0 addressing mode      ST1[2]
@define VMAP   "VMAP"     # vector map                 ST1[3]
@define SPA    "SPA"      # stack-pointer alignment    ST1[4]
@define EALLOWF "EALLOW"  # EALLOW/EDIS write-protect  ST1[6]

# =============================================================================
# Decode context. AMODE selects the loc16/loc32 field interpretation (Table 5-1).
# OBJMODE/AMODE live in ST1 at runtime; for decode we track AMODE as context.
# =============================================================================
# contextreg was widened from 4 to 8 bytes to make room for a 16-bit ctx_DP (bits
# 32..47) alongside a validity bit (48). The existing fields (bits 0..31) keep their
# offsets. Overlapping ctx_DP with the noflow scratch fields (ctx_fimm16 at 8..23,
# ctx_setflg_flag at 8..18) was unsafe: any noflow write of those bits at some
# intermediate instruction (an FPU #16FHi form, a SETFLG) would reset bits 8..23 to
# the pspec default at that address, wiping the flowed ctx_DP for the fall-through.
# Bits 32..63 are untouched by any noflow scratch, so ctx_DP flows cleanly.
define register offset=0x80 size=8 contextreg;
define context contextreg
  ctx_AMODE = (0,0)        # 0 = C28x modes (compiler default), 1 = C2xLP-compatible
  # Analyzer-set context bits for `LB *XAR7` disambiguation. The same opcode
  # (0x7620) serves as FFC helper return and switch-table dispatch; SLEIGH alone
  # can't tell them apart. Ghidra analyzers set these context bits on the proven
  # terminal instructions to select the correct constructor variant. `noflow` so
  # they only affect the one instruction, not the surrounding flow.
  ffc_return       = (1,1) noflow  # set by TMS320C28xFfcReturnAnalyzer
  switch_canonical = (2,2) noflow  # set by TMS320C28xSwitchAnalyzer (see #18)
  # Scratch field for DISPLAY of immediates that are split across both words of a
  # 2-word instruction (the FPU #16FHi forms). SLEIGH can't print an arithmetic
  # expression, so the constructor computes the joined value into this field in a
  # disassembly action and prints the field. `noflow` keeps it local to the one
  # instruction. Display only -- the semantics still compute from the raw fields.
  ctx_fimm16 = (8,23) noflow
  # Same trick for SETFLG / SAVE, whose 11-bit FLAG mask is split 6 bits in the LSW
  # and 5 in the MSW. Deliberately shares bits with ctx_fimm16: both are noflow
  # display scratch and no instruction is both an #16FHi form and a SETFLG form, so
  # they can never be live at the same time.
  ctx_setflg_flag = (8,18) noflow
  # --- RPT / RPTB dispatch bits (mwdmwd/ghidra-c28x pattern; see THIRD-PARTY.md).
  # rpt_active is set by the RPT body via globalset(inst_next, ...) so the very
  # next instruction picks up the `:^instruction is rpt_active=1 & instruction`
  # prefix wrapper (tms320c28x_flow.sinc). noflow so the flag drops after that
  # one instruction. rptb_flag is set at the block-end address so the same
  # wrapper trick makes the block-end instruction loop back to RB_RSTART.
  # rpt_phase gates the wrapper itself against recursive matching (the wrapper's
  # `build instruction` re-enters decode; setting rpt_phase=1 locally on the
  # wrapper's own decode blocks the outer pattern from firing again).
  #
  # ALL THREE must be noflow, and rpt_phase most of all. The wrapper's local
  # `[ rpt_phase=1; ]` action does NOT limit the globalset's scope: it applies to
  # the wrapper's own parse and never commits to the following address. Without
  # noflow, `globalset(inst_next, rpt_phase)` leaves rpt_phase=0 flowing past the
  # repeated instruction, so at RPT+2 no constructor can match at all -- the base
  # forms require rpt_phase=1, the RPT wrapper requires rpt_active=1 (already
  # dropped, being noflow) and the RPTB wrapper requires rptb_flag=1. The address
  # decodes as UNDEF. Measured on a byte-swapped F28377D production image over
  # 0x82000+0x8000: 57 extra UNDEFs and 3 extra length-skews vs main, 42 of them
  # sitting exactly two words after an RPT opcode. noflow makes the globalset apply to the wrapped address only,
  # after which rpt_phase reverts to the ram-space default of 1 from the pspec.
  rpt_active = (3,3) noflow
  rptb_flag  = (4,4) noflow
  rpt_phase  = (5,5) noflow
  # --- DP-relative addressing resolution (bits 32..63 of the widened contextreg).
  # DP is TI's data-page pointer: a `@6bit` operand resolves at runtime to
  # (DP<<6)|6bit, giving a 22-bit address. The compiler emits `MOVW DP,#imm` (and
  # occasionally `MOVZ DP,#10bit`) immediately before a run of `@6bit` accesses.
  # We snapshot the immediate into ctx_DP and mark ctx_DP_valid; the SLA emits a
  # single runtime-expression @6bit constructor (one prototype per byte sequence,
  # so no cross-flow "inconsistent prototype" conflict -- was #48). Resolution to a
  # concrete symbol is deferred to TMS320C28xDpPropagationAnalyzer, which reads
  # (ctx_DP, ctx_DP_valid) at each instruction and attaches a memory reference
  # -- Ghidra then substitutes the global's symbol name in the operand, draws the
  # XREF, and the decompiler sees the underlying data type.
  #
  # NOT noflow: ctx_DP/ctx_DP_valid propagate through linear flow until the next
  # `MOVW DP` / `MOVZ DP` overwrites them. This is the whole point -- one MOVW DP
  # feeds many downstream @6bit loads. Overlap-safe because bits 32..63 aren't
  # touched by ctx_fimm16 (8..23) or ctx_setflg_flag (8..18) scratch writes.
  # ABI note: TI's C runtime does NOT preserve DP across calls; call constructors
  # invalidate ctx_DP_valid at inst_next. The propagation analyzer re-seeds valid=1
  # into fall-throughs where the callee is provably DP-preserving.
  ctx_DP        = (32,47)
  ctx_DP_valid  = (48,48)
;

# Tokens and instruction constructors live in the .sinc include.
@include "tms320c28x.sinc"
