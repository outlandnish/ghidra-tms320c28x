<!-- See Relax specification: Ghidra/Framework/SoftwareModeling/data/languages/language_definitions.rxg -->

<language_definitions>
  <language processor="TMS320C28x"
            endian="little"
            size="32"
            variant="default"
            version="0.1"
            slafile="tms320c28x.sla"
            processorspec="tms320c28x.pspec"
            id="TMS320C28x:LE:32:default">
    <description>TI TMS320C28x 32-bit fixed-point DSP (word-addressable, 16-bit byte). Target: TMS320F28377D.</description>
    <compiler name="default" spec="tms320c28x.cspec" id="default"/>
    <external_name tool="IDA-PRO" name="tms320c28"/>
  </language>

  <!-- F2812 device variant: same C28x SLEIGH core (.sla) and calling convention (.cspec)
       as the default — the F2812 fixed-point instruction set is a strict subset of the
       decoded ISA — but with the F281x-specific memory map (peripheral MMIO frames and
       interrupt vectors) in tms320c28x_f2812.pspec. Also covers the memory-compatible
       F2810/F2811. Pair with ghidra_scripts/SetupF2812.java for full peripheral labels. -->
  <language processor="TMS320C28x"
            endian="little"
            size="32"
            variant="f2812"
            version="0.1"
            slafile="tms320c28x.sla"
            processorspec="tms320c28x_f2812.pspec"
            id="TMS320C28x:LE:32:f2812">
    <description>TI TMS320F2812 (F281x) fixed-point C28x DSP — no FPU/VCU. Word-addressable, 16-bit byte. Also F2810/F2811.</description>
    <compiler name="default" spec="tms320c28x.cspec" id="default"/>
    <external_name tool="IDA-PRO" name="tms320c28"/>
  </language>

  <!-- CLA (Control Law Accelerator) Type-1: the independent 32-bit floating-point
       coprocessor on the F2837x, executing out of whichever LSx banks MemCfgRegs
       assigns it. Its own register file, its own instruction set (SPRUHM8K ch.6), its
       own PC, and no encoding in common with the C28x core — so it is a separate
       language, not a decode mode, and CLA program RAM is analysed as its own program.
       Every instruction is 32 bits; addresses are 16-bit word addresses (the CLA reaches
       only the low 64K), held in a wordsize=2 space like the core's. Pair with
       ghidra_scripts/SetupClaProgram.java, which maps the banks and roots the eight
       tasks from Cla1Regs.MVECT1-8. -->
  <language processor="TMS320C28x"
            endian="little"
            size="32"
            variant="cla"
            version="0.1"
            slafile="tms320c28x_cla.sla"
            processorspec="tms320c28x_cla.pspec"
            id="TMS320C28x:LE:32:cla">
    <description>TI CLA Type-1 coprocessor (TMS320F2837x). 32-bit fixed-width float ISA, word-addressable.</description>
    <compiler name="default" spec="tms320c28x_cla.cspec" id="default"/>
  </language>
</language_definitions>
