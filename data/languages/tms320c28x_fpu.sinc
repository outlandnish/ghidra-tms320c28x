#
# Portions adapted from mwdmwd/ghidra-c28x (Apache-2.0):
#   * the `cndf` condition sub-table (12 conditions + UNC/UNCF);
#   * the STF sub-register model (STF_ZF/NF/TF/LV/LU/NI/ZI defined in slaspec);
#   * the operand-conditioning macro `tmu_condition_operand` (TMU input
#     canonicalisation) per SPRUHS1C §7.5.2 -- the compare-input analogue was
#     ported too but is deliberately not wired up; see update_stf_cmp;
#   * `fpu_minmax_output` (denormal/NaN flush on MAX/MIN result);
#   * the flag-writing macros `update_stf` (arith 1-op), `update_stf_cmp`
#     (compare, with conditioned operands), `update_stf_mov` (MOV loads: ZI/NI
#     alongside ZF/NF);
#   * `packstf` / `unpackstf` for the packed-STF sync on STF <-> memory moves;
#   * the UNCF-vs-conditional split on MOV32 / NEGF32 / SWAPF ... cndf.
# See THIRD-PARTY.md.
#
# C28x FPU (F2837x / FPU32) instructions.
# Included by tms320c28x.sinc. Encodings verified against docs/c28x/fpu_instructions.txt
# (spruhs1c ch.1). Confirmed used in DIR/PMR (~281 ext-ISA words).
#
# SCOPE: real IEEE-754 single-precision p-code (FPU-PCODE-SPEC.md, PCODE-GAPS B2).
# The FP regs R0H..R7H are 32-bit varnodes holding the IEEE-754 bit pattern; SLEIGH's
# float operators (f+ f- f* f/ f== f< ... int2float trunc abs sqrt) are size-typed, so
# applying them to the 4-byte reg values is correct. Compares (CMPF32/MAXF32/MINF32)
# update the STF sub-registers STF_ZF/STF_NF; the `cndf` sub-table reads them so the
# `CMPF32 -> MOV32 RaH,RbH,cndf` and `CMPF32 -> MOVST0 -> SB(cond)` idioms both survive
# (an unset flag makes the decompiler prune the branch successor as unreachable ->
# halt_baddata, the dominant B2 truncation).
#
# FPU instructions are 32-bit: LSW (low word, lower address) + MSW. The LSW is the
# opcode; for reg-reg forms the MSW holds the register fields aaa/bbb/ccc.

# --- MSW register fields (second 16-bit word) --------------------------------
# The f_* / p_* / fimm_hi* fields are defined on the shared `instr16` token in
# tms320c28x.sinc, NOT on a token of their own. SLEIGH refuses to combine fields
# from two different tokens at the same word ("Mismatched tokens when combining
# patterns") even when both tokens are 16 bits wide, so a private MSW token would
# make `p_ra & loc32` -- an FPU register selector next to a standard C28x loc byte,
# which is exactly the MSW layout of every `mem32` form -- impossible to express.
# See tms320c28x.sinc for the field list.
attach variables [ f_ra f_rb f_rc ] [ R0H R1H R2H R3H R4H R5H R6H R7H ];
attach variables [ fimm_reg ] [ R0H R1H R2H R3H R4H R5H R6H R7H ];
attach variables [ p_rd p_ra ] [ R0H R1H R2H R3H R4H R5H R6H R7H ];
# f_movf_reg values 4..11 map to R0H..R7H (low 4 indices unused/reserved).
attach variables [ f_movf_reg ]
    [ _ _ _ _ R0H R1H R2H R3H R4H R5H R6H R7H _ _ _ _ ];

# --- MOVST0 FLAG select mask ------------------------------------------------
# The FLAG operand is an 8-bit mask, one bit per STF flag, and TI's assembler prints
# the selected names in ascending bit order (`MOVST0 NF,ZF` for 0x14). Bit assignment
# recovered from asm2000/dis2000 ground truth (SPRUHS1C documents the ST0 mapping but
# not the mask encoding): LVF=0x01 LUF=0x02 NF=0x04 NI=0x08 ZF=0x10 ZI=0x20 TF=0x80.
# Bit 6 is unused (`MOVST0 <all>` assembles to 0xBF), so it renders as rsvd6.
# 256 entries because `attach names` must cover every value of the 8-bit field.
attach names [ movst0_flags ] [
    "0" "LVF" "LUF" "LVF,LUF" "NF" "LVF,NF" "LUF,NF" "LVF,LUF,NF"
    "NI" "LVF,NI" "LUF,NI" "LVF,LUF,NI" "NF,NI" "LVF,NF,NI" "LUF,NF,NI" "LVF,LUF,NF,NI"
    "ZF" "LVF,ZF" "LUF,ZF" "LVF,LUF,ZF" "NF,ZF" "LVF,NF,ZF" "LUF,NF,ZF" "LVF,LUF,NF,ZF"
    "NI,ZF" "LVF,NI,ZF" "LUF,NI,ZF" "LVF,LUF,NI,ZF" "NF,NI,ZF" "LVF,NF,NI,ZF" "LUF,NF,NI,ZF" "LVF,LUF,NF,NI,ZF"
    "ZI" "LVF,ZI" "LUF,ZI" "LVF,LUF,ZI" "NF,ZI" "LVF,NF,ZI" "LUF,NF,ZI" "LVF,LUF,NF,ZI"
    "NI,ZI" "LVF,NI,ZI" "LUF,NI,ZI" "LVF,LUF,NI,ZI" "NF,NI,ZI" "LVF,NF,NI,ZI" "LUF,NF,NI,ZI" "LVF,LUF,NF,NI,ZI"
    "ZF,ZI" "LVF,ZF,ZI" "LUF,ZF,ZI" "LVF,LUF,ZF,ZI" "NF,ZF,ZI" "LVF,NF,ZF,ZI" "LUF,NF,ZF,ZI" "LVF,LUF,NF,ZF,ZI"
    "NI,ZF,ZI" "LVF,NI,ZF,ZI" "LUF,NI,ZF,ZI" "LVF,LUF,NI,ZF,ZI" "NF,NI,ZF,ZI" "LVF,NF,NI,ZF,ZI" "LUF,NF,NI,ZF,ZI" "LVF,LUF,NF,NI,ZF,ZI"
    "rsvd6" "LVF,rsvd6" "LUF,rsvd6" "LVF,LUF,rsvd6" "NF,rsvd6" "LVF,NF,rsvd6" "LUF,NF,rsvd6" "LVF,LUF,NF,rsvd6"
    "NI,rsvd6" "LVF,NI,rsvd6" "LUF,NI,rsvd6" "LVF,LUF,NI,rsvd6" "NF,NI,rsvd6" "LVF,NF,NI,rsvd6" "LUF,NF,NI,rsvd6" "LVF,LUF,NF,NI,rsvd6"
    "ZF,rsvd6" "LVF,ZF,rsvd6" "LUF,ZF,rsvd6" "LVF,LUF,ZF,rsvd6" "NF,ZF,rsvd6" "LVF,NF,ZF,rsvd6" "LUF,NF,ZF,rsvd6" "LVF,LUF,NF,ZF,rsvd6"
    "NI,ZF,rsvd6" "LVF,NI,ZF,rsvd6" "LUF,NI,ZF,rsvd6" "LVF,LUF,NI,ZF,rsvd6" "NF,NI,ZF,rsvd6" "LVF,NF,NI,ZF,rsvd6" "LUF,NF,NI,ZF,rsvd6" "LVF,LUF,NF,NI,ZF,rsvd6"
    "ZI,rsvd6" "LVF,ZI,rsvd6" "LUF,ZI,rsvd6" "LVF,LUF,ZI,rsvd6" "NF,ZI,rsvd6" "LVF,NF,ZI,rsvd6" "LUF,NF,ZI,rsvd6" "LVF,LUF,NF,ZI,rsvd6"
    "NI,ZI,rsvd6" "LVF,NI,ZI,rsvd6" "LUF,NI,ZI,rsvd6" "LVF,LUF,NI,ZI,rsvd6" "NF,NI,ZI,rsvd6" "LVF,NF,NI,ZI,rsvd6" "LUF,NF,NI,ZI,rsvd6" "LVF,LUF,NF,NI,ZI,rsvd6"
    "ZF,ZI,rsvd6" "LVF,ZF,ZI,rsvd6" "LUF,ZF,ZI,rsvd6" "LVF,LUF,ZF,ZI,rsvd6" "NF,ZF,ZI,rsvd6" "LVF,NF,ZF,ZI,rsvd6" "LUF,NF,ZF,ZI,rsvd6" "LVF,LUF,NF,ZF,ZI,rsvd6"
    "NI,ZF,ZI,rsvd6" "LVF,NI,ZF,ZI,rsvd6" "LUF,NI,ZF,ZI,rsvd6" "LVF,LUF,NI,ZF,ZI,rsvd6" "NF,NI,ZF,ZI,rsvd6" "LVF,NF,NI,ZF,ZI,rsvd6" "LUF,NF,NI,ZF,ZI,rsvd6" "LVF,LUF,NF,NI,ZF,ZI,rsvd6"
    "TF" "LVF,TF" "LUF,TF" "LVF,LUF,TF" "NF,TF" "LVF,NF,TF" "LUF,NF,TF" "LVF,LUF,NF,TF"
    "NI,TF" "LVF,NI,TF" "LUF,NI,TF" "LVF,LUF,NI,TF" "NF,NI,TF" "LVF,NF,NI,TF" "LUF,NF,NI,TF" "LVF,LUF,NF,NI,TF"
    "ZF,TF" "LVF,ZF,TF" "LUF,ZF,TF" "LVF,LUF,ZF,TF" "NF,ZF,TF" "LVF,NF,ZF,TF" "LUF,NF,ZF,TF" "LVF,LUF,NF,ZF,TF"
    "NI,ZF,TF" "LVF,NI,ZF,TF" "LUF,NI,ZF,TF" "LVF,LUF,NI,ZF,TF" "NF,NI,ZF,TF" "LVF,NF,NI,ZF,TF" "LUF,NF,NI,ZF,TF" "LVF,LUF,NF,NI,ZF,TF"
    "ZI,TF" "LVF,ZI,TF" "LUF,ZI,TF" "LVF,LUF,ZI,TF" "NF,ZI,TF" "LVF,NF,ZI,TF" "LUF,NF,ZI,TF" "LVF,LUF,NF,ZI,TF"
    "NI,ZI,TF" "LVF,NI,ZI,TF" "LUF,NI,ZI,TF" "LVF,LUF,NI,ZI,TF" "NF,NI,ZI,TF" "LVF,NF,NI,ZI,TF" "LUF,NF,NI,ZI,TF" "LVF,LUF,NF,NI,ZI,TF"
    "ZF,ZI,TF" "LVF,ZF,ZI,TF" "LUF,ZF,ZI,TF" "LVF,LUF,ZF,ZI,TF" "NF,ZF,ZI,TF" "LVF,NF,ZF,ZI,TF" "LUF,NF,ZF,ZI,TF" "LVF,LUF,NF,ZF,ZI,TF"
    "NI,ZF,ZI,TF" "LVF,NI,ZF,ZI,TF" "LUF,NI,ZF,ZI,TF" "LVF,LUF,NI,ZF,ZI,TF" "NF,NI,ZF,ZI,TF" "LVF,NF,NI,ZF,ZI,TF" "LUF,NF,NI,ZF,ZI,TF" "LVF,LUF,NF,NI,ZF,ZI,TF"
    "rsvd6,TF" "LVF,rsvd6,TF" "LUF,rsvd6,TF" "LVF,LUF,rsvd6,TF" "NF,rsvd6,TF" "LVF,NF,rsvd6,TF" "LUF,NF,rsvd6,TF" "LVF,LUF,NF,rsvd6,TF"
    "NI,rsvd6,TF" "LVF,NI,rsvd6,TF" "LUF,NI,rsvd6,TF" "LVF,LUF,NI,rsvd6,TF" "NF,NI,rsvd6,TF" "LVF,NF,NI,rsvd6,TF" "LUF,NF,NI,rsvd6,TF" "LVF,LUF,NF,NI,rsvd6,TF"
    "ZF,rsvd6,TF" "LVF,ZF,rsvd6,TF" "LUF,ZF,rsvd6,TF" "LVF,LUF,ZF,rsvd6,TF" "NF,ZF,rsvd6,TF" "LVF,NF,ZF,rsvd6,TF" "LUF,NF,ZF,rsvd6,TF" "LVF,LUF,NF,ZF,rsvd6,TF"
    "NI,ZF,rsvd6,TF" "LVF,NI,ZF,rsvd6,TF" "LUF,NI,ZF,rsvd6,TF" "LVF,LUF,NI,ZF,rsvd6,TF" "NF,NI,ZF,rsvd6,TF" "LVF,NF,NI,ZF,rsvd6,TF" "LUF,NF,NI,ZF,rsvd6,TF" "LVF,LUF,NF,NI,ZF,rsvd6,TF"
    "ZI,rsvd6,TF" "LVF,ZI,rsvd6,TF" "LUF,ZI,rsvd6,TF" "LVF,LUF,ZI,rsvd6,TF" "NF,ZI,rsvd6,TF" "LVF,NF,ZI,rsvd6,TF" "LUF,NF,ZI,rsvd6,TF" "LVF,LUF,NF,ZI,rsvd6,TF"
    "NI,ZI,rsvd6,TF" "LVF,NI,ZI,rsvd6,TF" "LUF,NI,ZI,rsvd6,TF" "LVF,LUF,NI,ZI,rsvd6,TF" "NF,NI,ZI,rsvd6,TF" "LVF,NF,NI,ZI,rsvd6,TF" "LUF,NF,NI,ZI,rsvd6,TF" "LVF,LUF,NF,NI,ZI,rsvd6,TF"
    "ZF,ZI,rsvd6,TF" "LVF,ZF,ZI,rsvd6,TF" "LUF,ZF,ZI,rsvd6,TF" "LVF,LUF,ZF,ZI,rsvd6,TF" "NF,ZF,ZI,rsvd6,TF" "LVF,NF,ZF,ZI,rsvd6,TF" "LUF,NF,ZF,ZI,rsvd6,TF" "LVF,LUF,NF,ZF,ZI,rsvd6,TF"
    "NI,ZF,ZI,rsvd6,TF" "LVF,NI,ZF,ZI,rsvd6,TF" "LUF,NI,ZF,ZI,rsvd6,TF" "LVF,LUF,NI,ZF,ZI,rsvd6,TF" "NF,NI,ZF,ZI,rsvd6,TF" "LVF,NF,NI,ZF,ZI,rsvd6,TF" "LUF,NF,NI,ZF,ZI,rsvd6,TF" "LVF,LUF,NF,NI,ZF,ZI,rsvd6,TF"
];

# (The `mem32d` sub-table that used to live here decoded only the DP-direct mode of the
# MSW loc byte. The shared loc32 sub-table decodes all of them, and is now used directly
# in the second word, so mem32d is gone.)

# --- TMU intrinsics ----------------------------------------------------------
# The Trigonometric Math Unit ops (0xE27x) have no SLEIGH primitive. Declare them as
# pcodeops so the decompiler renders a named intrinsic call (e.g. `R0H = SINPUF32(R1H)`)
# instead of dropping the op or falling back to the generic 0xE2 MOV32. SINPUF32/COSPUF32
# take a "per-unit" angle (turns, = radians/2pi); ATANPUF32 returns a per-unit angle.
define pcodeop SINPUF32;
define pcodeop COSPUF32;
define pcodeop ATANPUF32;
define pcodeop QUADF32;
define pcodeop IEXP2F32;
define pcodeop LOG2F32;

# Operand/result conditioning (SPRUHS1C §7.5.2). The C28x FPU is not IEEE-clean: it
# treats denormals as ±0 and NaNs as ±infinity on compare and TMU inputs, and flushes
# the MAX/MIN result the same way. See the macro comments below for why these are
# intrinsics rather than inline p-code. Behaviours live in
# TMS320C28xEmulateInstructionStateModifier.
define pcodeop TMU_COND_OPERAND;   # TMU input:      denormal/±0 -> +0, NaN -> signed inf
define pcodeop FPU_MINMAX_FLUSH;   # MAX/MIN result: denormal -> ±0 preserved, NaN -> +inf

# Latched exception flags (SPRUHS1C 7.3.4 / 7.3.5). Underflow is "the operation generated
# a value too small to represent" and overflow "too large" -- so neither is decidable from
# the rounded result alone: 0.0 * 5.0 returns a zero that is not an underflow, and
# Inf + 1.0 an infinity that is not an overflow. Both operands and the operation are
# needed, which is exactly what an intrinsic can take and inline p-code cannot express
# without recomputing the arithmetic at wider precision. The sticky OR is folded into the
# behaviour, so each is one CALLOTHER and one register write.
#   inputs: (kind, a, b, current-latch)   ->   new latch value
define pcodeop FPU_UNDERFLOW;
define pcodeop FPU_OVERFLOW;

# Operation selectors for the two above. Must match FpuArithFlagBehavior.KIND_* in
# TMS320C28xEmulateInstructionStateModifier.
@define FPK_MPY   "0:1"
@define FPK_ADD   "1:1"
@define FPK_SUB   "2:1"
@define FPK_DIV   "3:1"
@define FPK_SQRT  "4:1"
@define FPK_EINV  "5:1"
@define FPK_EISQR "6:1"

# Two-operand and one-operand latch updates. `b` is ignored by the one-operand kinds.
macro fpu_latch2(kind, a, b) {
    STF_LU = FPU_UNDERFLOW(kind, a, b, STF_LU);
    STF_LV = FPU_OVERFLOW(kind, a, b, STF_LV);
}
macro fpu_latch1(kind, a) {
    local zero:4 = 0;
    STF_LU = FPU_UNDERFLOW(kind, a, zero, STF_LU);
    STF_LV = FPU_OVERFLOW(kind, a, zero, STF_LV);
}
# Several TMU ops latch only one of the two (SPRUHS1C chapter 7 instruction tables):
# MPY2PIF32 / SQRTF32 / ATANPUF32 set only LVF, DIV2PIF32 / IEXP2F32 only LUF.
macro fpu_latch_lv2(kind, a, b) { STF_LV = FPU_OVERFLOW(kind, a, b, STF_LV); }
macro fpu_latch_lu2(kind, a, b) { STF_LU = FPU_UNDERFLOW(kind, a, b, STF_LU); }
macro fpu_latch_lv1(kind, a) { local zero:4 = 0; STF_LV = FPU_OVERFLOW(kind, a, zero, STF_LV); }

# --- STF flag model (unpacked) -----------------------------------------------
# CMPF32/MINF32/MAXF32 set ZF/NF from the comparison; the single-value flag ops
# (ABSF32, NEGF32 UNCF, ...) set ZF/NF from the result's exponent/sign.
# STF is modeled as individual sub-registers STF_ZF/STF_NF/STF_TF/STF_LV/STF_LU
# (slaspec) rather than bit slices of the packed STF, so the decompiler can name
# each flag directly. (LUF/LVF over/underflow flags are not modeled numerically;
# TMU pcodeops leave them stale.) The packed STF register is synced on the rare
# STF <-> memory move sites via packstf/unpackstf below.
#
# The `cndf` sub-table (12 conditions + UNC/UNCF) reads these sub-registers and
# exports a 1-byte boolean so conditional variants of MOV32 / NEGF32 / SWAPF can
# be genuinely conditional in p-code.
# Adapted from mwdmwd/ghidra-c28x (Apache-2.0). See THIRD-PARTY.md.

# --- Operand conditioning ----------------------------------------------------
# Per SPRUHS1C §7.5.2 the FPU treats denormals as ±0 and NaNs as ±infinity in
# compares and TMU inputs. Modeling this explicitly is what makes CMPF32/MAXF32
# match silicon on the edge-case inputs (denormals are frequent in scaled fixed-
# point-to-float conversions; NaNs surface in TMU divide-by-zero paths).
#

# TMU input conditioning (SPRUHS1C §7.5.2): denormals/negative-zero -> +0,
# NaN -> signed inf. Applied to DIVF32 / SQRTF32 / MPY2PIF32 / DIV2PIF32 inputs.
macro tmu_condition_operand(out, in) {
    out = TMU_COND_OPERAND(in);
}

# MAX/MIN output conditioning: SPRUHS1C says the picked value is passed through
# a denormal-flush + NaN-flush stage before being written to RaH.
macro fpu_minmax_output(out) {
    out = FPU_MINMAX_FLUSH(out);
}

# --- Flag-writing macros (used by the FP instructions) -----------------------

# 2-operand compare (CMPF32/MAXF32/MINF32): condition both operands first, then
# set ZF/NF from the ordered comparison. `setFloatFlags` is kept as a thin alias
# so existing call sites (below) don't have to change all at once.
# Compare operands are deliberately NOT run through fpu_cmp_operand, though the FPU does
# condition them. Three reasons, in order of weight:
#   1. It cannot change a conclusion. The conditioning only differs from a plain compare
#      when an operand is a denormal or a NaN, and for a threshold test the difference is
#      "treated as 0" vs "treated as ~1e-38" -- it does not flip a real branch. SLEIGH's
#      own f== / f< already return false for NaN, which is the IEEE answer.
#   2. It costs the most of any conditioning site, because it touches BOTH operands of
#      EVERY compare -- including every float constant. Routing constants through an
#      opaque intrinsic loses their rendering: `if (0.002 < x)` becomes
#      `t = FPU_CMP_OPERAND(0x3b03126f); if (t < ...)`.
#   3. Measured on a real PMR function: conditioning both operands costs 79 decompiled
#      lines against 55 without, for zero change in what the code is doing.
# The conditioning that DOES survive is the kind that alters a value flowing onward --
# TMU inputs and the MAX/MIN result -- where the difference is observable downstream.
macro update_stf_cmp(lhs, rhs) {
    STF_ZF = (lhs f== rhs);
    STF_NF = (lhs f< rhs);
}
macro setFloatFlags(a, b) {
    update_stf_cmp(a, b);
}

# 1-operand result flag update for ARITHMETIC results (ABSF32, NEGF32 UNCF).
# Sets ZF from a zero-exponent test and NF from the sign bit gated on non-zero.
# LUF/LVF are not modeled numerically.
macro update_stf(res) {
    local zero_exp:1 = ((res & 0x7F800000) == 0);
    STF_ZF = zero_exp;
    STF_NF = res[31,1] && !zero_exp;
}

# 1-operand result flag update for MOV loads (MOV32 RaH,mem32,UNCF etc.). The
# ISA specifies that MOV UNCF updates FOUR flags: ZF/NF from the exponent (as
# above) AND ZI/NI from the raw integer bit pattern (SPRUHS1C Table 6-14).
# Distinct from update_stf because arithmetic-result flag semantics only touch
# ZF/NF; a MOV should also refresh the integer-view flags.
macro update_stf_mov(res) {
    local zero_exp:1 = ((res & 0x7F800000) == 0);
    STF_NI = res[31,1];
    STF_ZI = (res == 0);
    STF_ZF = zero_exp;
    STF_NF = res[31,1] && !zero_exp;
}

# Pack the individual flag sub-registers back into the STF word for the rare
# case where STF is stored to memory (or PUSH STF). Bit numbering matches
# SPRUHS1C Table 2-2: LVF=0 LUF=1 NF=2 ZF=3 NI=4 ZI=5 TF=6.
macro packstf(res) {
    local lv:4 = zext(STF_LV);
    local lu:4 = zext(STF_LU);
    local nf:4 = zext(STF_NF);
    local zf:4 = zext(STF_ZF);
    local ni:4 = zext(STF_NI);
    local zi:4 = zext(STF_ZI);
    local tf:4 = zext(STF_TF);
    local rnd:4 = zext(STF_RND);
    local shd:4 = zext(STF_SHDWS);
    res = lv | (lu << 1) | (nf << 2) | (zf << 3) | (ni << 4) | (zi << 5) | (tf << 6)
        | (rnd << 9) | (shd << 31);
}
macro unpackstf(in) {
    STF_LV = (in & 0x01) != 0;
    STF_LU = (in & 0x02) != 0;
    STF_NF = (in & 0x04) != 0;
    STF_ZF = (in & 0x08) != 0;
    STF_NI = (in & 0x10) != 0;
    STF_ZI = (in & 0x20) != 0;
    STF_TF = (in & 0x40) != 0;
    STF_RND = (in & 0x200) != 0;
    STF_SHDWS = (in & 0x80000000) != 0;
}

# --- LUF / LVF: the latched exception flags -----------------------------------
# Fully modelled: SETFLG / SAVE write them, RESTORE reloads them, MOVST0 folds them into
# ST0's OV and auto-clears them, packstf / unpackstf round-trip them through memory, the
# `LU` / `LV` cndf conditions read them, and -- via fpu_latch* above -- the arithmetic
# instructions latch them.
#
# Per SPRUHS1C 7.3.4 / 7.3.5 (a section in the TMU chapter, which states its treatment
# matches the FPU):
#     underflow -- the operation generates a value too small to represent; zero is
#                  returned. With 7.3.3 (a denormal is never generated) that means any
#                  result that would have been denormal counts.
#     overflow  -- the operation generates a value too large to represent; +/-Inf is
#                  returned.
# Neither is decidable from the rounded result alone -- 0.0 * 5.0 returns a zero that is
# not an underflow, and Inf + 1.0 an infinity that is not an overflow -- so the operands
# and the operation go to an intrinsic that recomputes the true result at double
# precision. That is exact for every operation here on float inputs.
#
# Which instructions latch, and which flag, is not uniform. Chapter 1 names MPYF32,
# ADDF32, SUBF32, MACF32, EINVF32 and EISQRTF32 for both flags; the chapter 7 TMU tables
# add DIVF32 (both), MPY2PIF32 and SQRTF32 (LVF only) and DIV2PIF32 (LUF only). Chapter
# 1's list simply predates the TMU. MACF32 latches on BOTH of its operations, per "LUF = 1
# if MACF32 (add or multiply) generates an underflow condition".
#
# NOT latched here: the transcendental TMU estimates (IEXP2F32, LOG2F32, ATANPUF32,
# QUADF32). Their results are pcodeops with no modelled value, so there is nothing to
# compare a true result against; latching them would be invention rather than modelling.
#
# Cost, measured on a float-heavy PMR function: 55 decompiled lines without latching, 95
# with. The intrinsics cannot be eliminated even where nothing reads LUF/LVF -- each takes
# the previous latch value and returns the new one, so they form a dependency chain, and
# Ghidra treats CALLOTHER as having side effects regardless. They also serialise the
# surrounding arithmetic, which costs some expression folding. That is the price of having
# the flags be correct; if a future reader wants the cheaper decompile back, deleting the
# fpu_latch* call sites is a mechanical change and the emulation tests will show exactly
# what stops being modelled.

# --- SETFLG / SAVE flag write ------------------------------------------------
# Both instructions carry an 11-bit FLAG mask ("which flags to change") and an 11-bit
# VALUE ("what to change them to"); a flag whose mask bit is 0 keeps its current value.
# FLAG's bit order is the STF register's own (SPRUHS1C Table 1-2), which is NOT the
# order MOVST0's mask uses -- MOVST0 swaps ZF/NI and puts TF at bit 7. Do not share
# tables between the two.
#   0 LVF   1 LUF   2 NF   3 ZF   4 NI   5 ZI   6 TF   7,8 rsvd   9 RND32   10 rsvd
# Both operands are decode-time constants, so the decompiler folds this down to just
# the flags the mask actually names.
macro apply_setflg(fl, va) {
    local s_lv:1 = (fl & 0x001) != 0;
    local s_lu:1 = (fl & 0x002) != 0;
    local s_nf:1 = (fl & 0x004) != 0;
    local s_zf:1 = (fl & 0x008) != 0;
    local s_ni:1 = (fl & 0x010) != 0;
    local s_zi:1 = (fl & 0x020) != 0;
    local s_tf:1 = (fl & 0x040) != 0;
    local s_rn:1 = (fl & 0x200) != 0;
    STF_LV    = (s_lv && ((va & 0x001) != 0)) || (!s_lv && STF_LV);
    STF_LU    = (s_lu && ((va & 0x002) != 0)) || (!s_lu && STF_LU);
    STF_NF    = (s_nf && ((va & 0x004) != 0)) || (!s_nf && STF_NF);
    STF_ZF    = (s_zf && ((va & 0x008) != 0)) || (!s_zf && STF_ZF);
    STF_NI    = (s_ni && ((va & 0x010) != 0)) || (!s_ni && STF_NI);
    STF_ZI    = (s_zi && ((va & 0x020) != 0)) || (!s_zi && STF_ZI);
    STF_TF    = (s_tf && ((va & 0x040) != 0)) || (!s_tf && STF_TF);
    STF_RND   = (s_rn && ((va & 0x200) != 0)) || (!s_rn && STF_RND);
}

# --- cndf: FPU condition-code sub-table --------------------------------------
# The 4-bit `fcndf` token field selects one of 16 float conditions (SPRUHS1C
# Table 6-1). Each constructor exports a 1-byte boolean the parent instruction
# uses in an `if (cndf) ...` guard. Reserved encodings 6..9 are given a bogus
# `rsvdN` display and export false so the table is total (SLEIGH requires every
# reachable pattern to match).
# Adapted from mwdmwd/ghidra-c28x (Apache-2.0).
cndf: "NEQ"   is fcndf=0b0000 { local b:1 = (STF_ZF == 0);                    export b; }
cndf: "EQ"    is fcndf=0b0001 { local b:1 = (STF_ZF == 1);                    export b; }
cndf: "GT"    is fcndf=0b0010 { local b:1 = (STF_ZF == 0) && (STF_NF == 0);   export b; }
cndf: "GEQ"   is fcndf=0b0011 { local b:1 = (STF_NF == 0);                    export b; }
cndf: "LT"    is fcndf=0b0100 { local b:1 = (STF_NF == 1);                    export b; }
cndf: "LEQ"   is fcndf=0b0101 { local b:1 = (STF_ZF == 1) || (STF_NF == 1);   export b; }
cndf: "rsvd6" is fcndf=0b0110 { local b:1 = 0;                                 export b; }
cndf: "rsvd7" is fcndf=0b0111 { local b:1 = 0;                                 export b; }
cndf: "rsvd8" is fcndf=0b1000 { local b:1 = 0;                                 export b; }
cndf: "rsvd9" is fcndf=0b1001 { local b:1 = 0;                                 export b; }
cndf: "TF"    is fcndf=0b1010 { local b:1 = (STF_TF == 1);                    export b; }
cndf: "NTF"   is fcndf=0b1011 { local b:1 = (STF_TF == 0);                    export b; }
cndf: "LU"    is fcndf=0b1100 { local b:1 = (STF_LU == 1);                    export b; }
cndf: "LV"    is fcndf=0b1101 { local b:1 = (STF_LV == 1);                    export b; }
cndf: "UNC"   is fcndf=0b1110 { local b:1 = 1;                                 export b; }
cndf: "UNCF"  is fcndf=0b1111 { local b:1 = 1;                                 export b; }

# =============================================================================
# Register-register 3-operand FP ops:  LSW fixed, MSW = 0000 000c ccbb baaa
# =============================================================================
:ADDF32 f_ra, f_rb, f_rc  is rpt_phase=1 & op16=0xE710; f_rc & f_rb & f_ra {
    fpu_latch2($(FPK_ADD), f_rb, f_rc);
    f_ra = f_rb f+ f_rc;
}
:SUBF32 f_ra, f_rb, f_rc  is rpt_phase=1 & op16=0xE720; f_rc & f_rb & f_ra {
    fpu_latch2($(FPK_SUB), f_rb, f_rc);
    f_ra = f_rb f- f_rc;
}
:MPYF32 f_ra, f_rb, f_rc  is rpt_phase=1 & op16=0xE700; f_rc & f_rb & f_ra {
    fpu_latch2($(FPK_MPY), f_rb, f_rc);
    f_ra = f_rb f* f_rc;
}

# =============================================================================
# Register-register 2-operand ops:  MSW = 0000 0000 00bb baaa
# =============================================================================
:ABSF32 f_ra, f_rb     is rpt_phase=1 & op16=0xE695; f_rb & f_ra & f_msw_hi=0 { f_ra = abs(f_rb); update_stf(f_ra); }
:CMPF32 f_ra, f_rb     is rpt_phase=1 & op16=0xE694; f_rb & f_ra & f_msw_hi=0 { setFloatFlags(f_ra, f_rb); }
# MAX/MIN: SLEIGH has no ternary — pick the larger/smaller with an if/goto.
# The compare sets ZF/NF (via update_stf_cmp inside setFloatFlags: denormals ->
# 0, NaN -> +inf), and the selected value is then denormal/NaN-flushed on its
# way to RaH (fpu_minmax_output). Applied on both paths of the if/else.
:MAXF32 f_ra, f_rb     is rpt_phase=1 & op16=0xE696; f_rb & f_ra & f_msw_hi=0 {
    update_stf_cmp(f_ra, f_rb);
    if (f_ra f>= f_rb) goto <keep>;
    f_ra = f_rb;
  <keep>
    fpu_minmax_output(f_ra);
}
:MINF32 f_ra, f_rb     is rpt_phase=1 & op16=0xE697; f_rb & f_ra & f_msw_hi=0 {
    update_stf_cmp(f_ra, f_rb);
    if (f_ra f<= f_rb) goto <keep>;
    f_ra = f_rb;
  <keep>
    fpu_minmax_output(f_ra);
}
# SLEIGH has no float literals — use the IEEE-754 bit pattern (1.0f = 0x3F800000).
:EINVF32 f_ra, f_rb    is rpt_phase=1 & op16=0xE693; f_rb & f_ra & f_msw_hi=0 {
    local one:4 = 0x3F800000;
    fpu_latch1($(FPK_EINV), f_rb);
    f_ra = one f/ f_rb;
}       # reciprocal estimate
:EISQRTF32 f_ra, f_rb  is rpt_phase=1 & op16=0xE692; f_rb & f_ra & f_msw_hi=0 {
    local one:4 = 0x3F800000;
    fpu_latch1($(FPK_EISQR), f_rb);
    f_ra = one f/ sqrt(f_rb);
} # 1/sqrt estimate
:FRACF32 f_ra, f_rb    is rpt_phase=1 & op16=0xE6F1; f_rb & f_ra & f_msw_hi=0 { f_ra = f_rb f- trunc(f_rb); } # fractional part (approx)

# =============================================================================
# TMU (Trigonometric Math Unit) ops — 0xE27x. MSW reg fields: aaa=RaH dest, bbb=RbH,
# ccc=RcH, ddd=RdH (2nd dest for QUADF32). Real math where a SLEIGH primitive exists
# (div/sqrt/2pi); transcendentals use the pcodeops above.
#
# TMU inputs go through tmu_condition_operand (SPRUHS1C §7.5.2): denormals ->
# +0, NaN -> signed inf. This makes the arithmetic outputs match silicon on the
# edge-case inputs, which is exactly the material for the compares that follow.
:MPY2PIF32 f_ra, f_rb  is rpt_phase=1 & op16=0xE270; f_rb & f_ra & f_msw_hi=0 {
    local b:4; tmu_condition_operand(b, f_rb);
    local twopi:4 = 0x40C90FDB;
    fpu_latch_lv2($(FPK_MPY), b, twopi);   # LVF only
    f_ra = b f* twopi;
}
:DIV2PIF32 f_ra, f_rb  is rpt_phase=1 & op16=0xE271; f_rb & f_ra & f_msw_hi=0 {
    local b:4; tmu_condition_operand(b, f_rb);
    local twopi:4 = 0x40C90FDB;
    fpu_latch_lu2($(FPK_DIV), b, twopi);   # LUF only
    f_ra = b f/ twopi;
}
:IEXP2F32 f_ra, f_rb   is rpt_phase=1 & op16=0xE272; f_rb & f_ra & f_msw_hi=0 { f_ra = IEXP2F32(f_rb); }   # 1/2^x estimate
:LOG2F32 f_ra, f_rb    is rpt_phase=1 & op16=0xE273; f_rb & f_ra & f_msw_hi=0 { f_ra = LOG2F32(f_rb); }    # log2(x) estimate
:DIVF32 f_ra, f_rb, f_rc  is rpt_phase=1 & op16=0xE274; f_rc & f_rb & f_ra & f_msw_hi=0 {
    local b:4; tmu_condition_operand(b, f_rb);
    local c:4; tmu_condition_operand(c, f_rc);
    fpu_latch2($(FPK_DIV), b, c);
    f_ra = b f/ c;
}
:SQRTF32 f_ra, f_rb    is rpt_phase=1 & op16=0xE277; f_rb & f_ra & f_msw_hi=0 {
    local b:4; tmu_condition_operand(b, f_rb);
    fpu_latch_lv1($(FPK_SQRT), b);         # LVF only
    f_ra = sqrt(b);
}
:SINPUF32 f_ra, f_rb   is rpt_phase=1 & op16=0xE278; f_rb & f_ra & f_msw_hi=0 { f_ra = SINPUF32(f_rb); }   # sin(2pi*x)
:COSPUF32 f_ra, f_rb   is rpt_phase=1 & op16=0xE279; f_rb & f_ra & f_msw_hi=0 { f_ra = COSPUF32(f_rb); }   # cos(2pi*x)
:ATANPUF32 f_ra, f_rb  is rpt_phase=1 & op16=0xE27A; f_rb & f_ra & f_msw_hi=0 { f_ra = ATANPUF32(f_rb); }  # atan(x)/2pi
# QUADF32 RaH,RbH,RcH (+RdH) — quadrant determination for ATANPUF32; two dest regs.
:QUADF32 f_ra, f_rb, f_rc  is rpt_phase=1 & op16=0xE27C; f_rc & f_rb & f_ra { f_ra = QUADF32(f_rb, f_rc); }

# Conversions (reg-reg).  LSW fixed; MSW reg fields. The FP reg holds a float; the
# int forms hold a 2's-complement int in the 32-bit reg. trunc = float->int (toward 0),
# int2float = int->float.  For the 16-bit source converts, take the low half.
:F32TOI32 f_ra, f_rb   is rpt_phase=1 & op16=0xE688; f_rb & f_ra & f_msw_hi=0 { f_ra = trunc(f_rb); }
:F32TOUI32 f_ra, f_rb  is rpt_phase=1 & op16=0xE68A; f_rb & f_ra & f_msw_hi=0 { f_ra = trunc(f_rb); }
:I32TOF32 f_ra, f_rb   is rpt_phase=1 & op16=0xE689; f_rb & f_ra & f_msw_hi=0 { f_ra = int2float(f_rb); }
:UI32TOF32 f_ra, f_rb  is rpt_phase=1 & op16=0xE68B; f_rb & f_ra & f_msw_hi=0 { f_ra = int2float(f_rb); }
# F32TOI16 / F32TOI16R (0xE68C): float -> SIGNED int16. MSW bit15=1 = round variant
# (dis2000-confirmed, DIR image). Result sign-extended into the 32-bit reg.
:F32TOI16 f_ra, f_rb   is rpt_phase=1 & op16=0xE68C; f_rb & f_ra & f_msw_mid=0 & f_msw_rnd=0 { local v:2 = trunc(f_rb); f_ra = sext(v); }  # truncate
:F32TOI16R f_ra, f_rb  is rpt_phase=1 & op16=0xE68C; f_rb & f_ra & f_msw_mid=0 & f_msw_rnd=1 { local v:2 = trunc(f_rb); f_ra = sext(v); }  # round
:I16TOF32 f_ra, f_rb   is rpt_phase=1 & op16=0xE68D; f_rb & f_ra & f_msw_hi=0 { local v:2 = f_rb:2; f_ra = int2float(v); }
:F32TOUI16 f_ra, f_rb  is rpt_phase=1 & op16=0xE68E; f_rb & f_ra & f_msw_mid=0 & f_msw_rnd=0 { local v:2 = trunc(f_rb); f_ra = zext(v); }  # float -> uint16 (truncate)
# F32TOUI16R — same LSW, MSW bit15=1 selects round-to-nearest. dis2000 confirmed the
# round variant at word 0xe68e:0x8000 (the f_msw_hi=0 form rejected it). Modeled as the
# same convert (we don't track the rounding mode bit precisely).
:F32TOUI16R f_ra, f_rb  is rpt_phase=1 & op16=0xE68E; f_rb & f_ra & f_msw_mid=0 & f_msw_rnd=1 { local v:2 = trunc(f_rb); f_ra = zext(v); }  # float -> uint16 (round)
:UI16TOF32 f_ra, f_rb  is rpt_phase=1 & op16=0xE68F; f_rb & f_ra & f_msw_hi=0 { local v:2 = f_rb:2; f_ra = int2float(v); }

# =============================================================================
# Stack / control
# =============================================================================
# RB is 32-bit; occupies 2 words on the 16-bit word-addressed stack.
:PUSH "RB"   is rpt_phase=1 & op16=0xFFF0 { local a:4 = SP; *[ram]:4 a = RB; SP = SP + 2; }
:POP "RB"    is rpt_phase=1 & op16=0xFFF1 { SP = SP - 2; local a:4 = SP; RB = *[ram]:4 a; }
# RESTORE   LSW: 1110 0101 0110 0010 (single word)
# Copy R0H-R7H and STF back from the shadow register set, and clear SHDWS. Was a `{ }`
# no-op, which made a SAVE/RESTORE-bracketed ISR look like it clobbered every float
# register of the code it interrupted.
:RESTORE     is rpt_phase=1 & op16=0xE562 {
    R0H = R0H_s; R1H = R1H_s; R2H = R2H_s; R3H = R3H_s;
    R4H = R4H_s; R5H = R5H_s; R6H = R6H_s; R7H = R7H_s;
    STF = STF_s;
    unpackstf(STF);
    STF_SHDWS = 0;
}
:ZEROA       is rpt_phase=1 & op16=0xE563 { R0H=0; R1H=0; R2H=0; R3H=0; R4H=0; R5H=0; R6H=0; R7H=0; }

# SETFLG FLAG,VALUE   LSW: 1110 0110 00FF FFFF ; MSW: FFFF FVVV VVVV VVVV  (2-word)
# SAVE   FLAG,VALUE   LSW: 1110 0110 01FF FFFF ; MSW: FFFF FVVV VVVV VVVV  (2-word)
# Set or clear selected FPU status flags. FLAG is split across both words (low 6 bits in
# the LSW, high 5 in the MSW) so, like the #16FHi immediates, the display reassembles it
# in a disassembly action rather than printing whichever half fits -- SETFLG's most
# common real use is RND32, which is FLAG bit 9.
#
# Note the halves are the other way round from the #16FHi immediates: here the LSW holds
# the HIGH 6 bits of FLAG and the MSW the low 5, i.e. FLAG = (m6 << 5) | f5. Confirmed
# against asm2000: `SETFLG RNDF32=1` assembles to `e610 0200` -- m6 = 0b010000 puts the
# set bit at FLAG[9], and reading the halves the other way round would land it on NI.
#
# SETFLG was `{ STF = STF; }` -- a placeholder that named flags it did not write, so
# firmware clearing LUF/LVF or switching the rounding mode had no modelled effect at all.
:SETFLG "#"^ctx_setflg_flag, "#"setflg_v11
        is rpt_phase=1 & op_hi8=0xE6 & lo_b76=0 & setflg_m6 ; setflg_f5 & setflg_v11
        [ ctx_setflg_flag = (setflg_m6 << 5) | setflg_f5; ] {
    local f5:2 = setflg_f5;
    local m6:2 = setflg_m6;
    local fl:2 = (m6 << 5) | f5;
    local va:2 = setflg_v11;
    apply_setflg(fl, va);
}
# SAVE additionally copies the working register set to the shadows, in the same cycle.
# Per SPRUHS1C the status register is copied BEFORE the flag values are changed, so the
# packstf/copy happens first and SHDWS is set after it.
:SAVE "#"^ctx_setflg_flag, "#"setflg_v11
        is rpt_phase=1 & op_hi8=0xE6 & lo_b76=1 & setflg_m6 ; setflg_f5 & setflg_v11
        [ ctx_setflg_flag = (setflg_m6 << 5) | setflg_f5; ] {
    R0H_s = R0H; R1H_s = R1H; R2H_s = R2H; R3H_s = R3H;
    R4H_s = R4H; R5H_s = R5H; R6H_s = R6H; R7H_s = R7H;
    packstf(STF);
    STF_s = STF;
    STF_SHDWS = 1;
    local f5:2 = setflg_f5;
    local m6:2 = setflg_m6;
    local fl:2 = (m6 << 5) | f5;
    local va:2 = setflg_v11;
    apply_setflg(fl, va);
}

# RPTB label, loc16 / #RC   LSW: 1011 0101 Rbbb bbbb ; MSW: (0000 0000 loc16) or (imm16).
# Zero-overhead block repeat: after the RPTB, the CPU runs the following RSIZE+1 words
# and loops back RB_RC additional times. Now modeled entirely in SLEIGH via the RPTB
# `^instruction` prefix wrapper in tms320c28x_rpt.sinc.
#
# HOW: the `rptb_end` sub-table below computes the block-end byte address as
# `inst_start + RSIZE + 2` (the +2 accounts for RPTB itself being a 2-word insn,
# so inst_next = inst_start + 2, and end = inst_next + RSIZE). It arms rptb_flag
# on THAT address via globalset, so the wrapper fires on the last block insn:
# there it decrements RB_RC and branches to RB_RSTART (= inst_next of the RPTB)
# until the count is exhausted. `RB = zext(rsz)` is kept only so PUSH RB captures
# the same value as before -- the packed 32-bit RB layout at 0x90 is not otherwise
# reconstructed from the split RB_R* slots. Ported from mwdmwd/ghidra-c28x
# (Apache-2.0); see THIRD-PARTY.md.
# The `rptb_end` sub-table computes the block-end address as inst_next + RSIZE
# (in the addressable-unit units SLEIGH uses for inst_start / inst_next, which
# is word units in this wordsize=2 space). It arms rptb_flag=1 and rpt_phase=0
# on that address via globalset, so the wrapper fires on the last block insn.
# It also exports the address so the parent's display renders the block-end
# label instead of a raw RSIZE integer (matching TI dis2000 syntax).
rptb_end: rel  is rptb_rsz
        [ rel = inst_start + rptb_rsz + 2;
          rptb_flag=1; rpt_phase=0;
          globalset(rel, rptb_flag); globalset(rel, rpt_phase); ] {
    export *:4 rel;
}
:RPTB rptb_end^", loc16"  is op_hi8=0xB5 & rptb_sel=0 & rpt_phase=1 & rptb_end & rptb_rsz ; loc16 {
    local rsz:1 = rptb_rsz;
    RB_RSIZE = rsz;
    local count:2 = loc16;
    RB_RC = count;
    RB_RA = (count != 0);
    RB_RSTART = inst_next >> 1;
    RB = zext(rsz);
}
:RPTB rptb_end^", #"^imm16  is op_hi8=0xB5 & rptb_sel=1 & rpt_phase=1 & rptb_end & rptb_rsz ; imm16 {
    local rsz:1 = rptb_rsz;
    RB_RSIZE = rsz;
    local count:2 = imm16;
    RB_RC = count;
    RB_RA = (count != 0);
    RB_RSTART = inst_next >> 1;
    RB = zext(rsz);
}

# =============================================================================
# Register immediate loads: MOVIZ (high 16) / MOVXI (low 16) of an FP reg.
#   LSW: 1110 1000 0000 zIII   (III = HIGH 3 bits of the 16-bit immediate)
#   MSW: IIII IIII IIII Iaaa   (13 I = LOW 13 bits of the immediate; aaa = dest reg)
# The 16-bit immediate is split: imm16 = (LSW[2:0] << 13) | MSW[15:3]
#                                      = (fimm_lo3 << 13) | fimm_hi13
# and the DEST REGISTER is MSW[2:0] = f_ra (NOT the LSW bits).
#
# WAS WRONG (the "already correct — leave" note was a misdiagnosis): the old form used
# `fimm_reg` (= LSW[2:0], which is the immediate HIGH 3 bits, not the reg) as the dest, and
# the whole `imm16` MSW word as the value. That produced (a) the wrong destination register
# whenever LSW-III != MSW-aaa, and (b) a garbage immediate (raw MSW). Surfaced in PCS411
# @0x8f7da: the 0x441 scale constants decoded as 0xEE62.../0xE119... (~1e28) instead of the
# real 0x3DCCCCCD (0.1) / 0x3C23D70A (0.01), and R2H scale-loads were mislabeled R6H so R2H
# read as uninitialized in the decompile. See PCODE-GAPS RESOLVED entry for the full diagnosis.
#
# DISPLAY: printing `fimm_hi13` alone shows only the LOW 13 bits of the constant, so a
# MOVIZ of 0x46a5 rendered as "#0x6a5" — the semantics were right but the listing lied.
# Confirmed against TI dis2000 (`e802 352b` = MOVIZ R3,#0x46a5, we printed #0x6a5).
# Compute the joined value into ctx_fimm16 in a disassembly action and print that.
:MOVIZ f_ra, "#"^ctx_fimm16  is rpt_phase=1 & op_hi8=0xE8 & fimm_hi=0 & fimm_z=0 & fimm_lo3 ; fimm_hi13 & f_ra
        [ ctx_fimm16 = (fimm_lo3 << 13) | fimm_hi13; ] {
    local imm:2 = (zext(fimm_lo3:2) << 13) | fimm_hi13:2;
    f_ra = (f_ra & 0x0000FFFF) | (zext(imm) << 16);
}
:MOVXI f_ra, "#"^ctx_fimm16  is rpt_phase=1 & op_hi8=0xE8 & fimm_hi=0 & fimm_z=1 & fimm_lo3 ; fimm_hi13 & f_ra
        [ ctx_fimm16 = (fimm_lo3 << 13) | fimm_hi13; ] {
    local imm:2 = (zext(fimm_lo3:2) << 13) | fimm_hi13:2;
    f_ra = (f_ra & 0xFFFF0000) | zext(imm);
}

# =============================================================================
# 0xBD / 0xBF : DUAL-form 32-bit move.  LSW = 1011 110x + loc32 (ACC/P/XT/XARn, decoded by
# the shared loc32 sub-table).  The SECOND word (MSW) selects between two entirely different
# instructions -- verified by asm2000/dis2000 round-trip:
#
#   * MSW high byte 0x0F, bits[7:6]=0, index bits[5:2] in 4..11  ->  FPU register move
#       0xBF: MOV32 loc32, RaH   (loc32 <- FP reg)   MSW = 0x0F02 | (freg<<2); freg 4..11 = R0H..R7H
#       0xBD: MOV32 RaH, loc32   (FP reg <- loc32)
#     (e.g. bfa9 0f12 => MOV32 ACC,R0H ; bda9 0f12 => MOV32 R0H,ACC)
#
#   * ANY other MSW  ->  VCU-II absolute-memory move; the MSW is a 16-bit *(0:16bitAddr)
#     data address (page 0, high bits zero) -- NOT a register selector:
#       0xBF: VMOV32 loc32, *(0:16bitAddr)   (loc32 <- [0:addr])   spruhs1c p.549
#       0xBD: VMOV32 *(0:16bitAddr), loc32   (loc32 -> [0:addr])   spruhs1c p.548
#     (e.g. bfa9 7f08 => VMOV32 ACC,*(0:0x7f08) ; bda9 7f08 => VMOV32 *(0:0x7f08),ACC)
#
# The old model matched the register form on ANY MSW (only the f_movf_reg index bits, no
# high-byte constraint), so a real address MSW (index bits landing outside 4..11, e.g.
# 0x7F08) fell on an undefined f_movf_reg attach slot and decoded to <UNDEF> (halt_baddata).
# Constrain the register form to the exact 0x0F.. selector; add the absolute-memory form as
# the strictly-less-specific catch-all.  dis2000 tie-breaks identically.  The register form
# keeps its opaque FP-reg move (its constant recovery is handled by the value-flow work); the
# memory form has real load/store p-code so the decompiler tracks the address.

# All four carry `& rpt_phase=1` like every other top-level constructor -- without it the
# RPT / RPTB `:^instruction` wrappers cannot wrap them and `RPT || <this>` would execute
# only once. See the phase-bit partition note in tms320c28x_rpt.sinc.

# --- register form (MSW = 0x0F.. FP-reg selector) --------------------------------
:MOV32 f_movf_reg, loc32  is rpt_phase=1 & op_hi8=0xBD & loc32 ; f_msw_b8_15=0x0F & f_msw_b76=0 & f_movf_reg
        { f_movf_reg = loc32; }          # 0xBD: FP reg <- loc32
:MOV32 loc32, f_movf_reg  is rpt_phase=1 & op_hi8=0xBF & loc32 ; f_msw_b8_15=0x0F & f_msw_b76=0 & f_movf_reg
        { loc32 = f_movf_reg; }          # 0xBF: loc32 <- FP reg

# --- absolute-memory form (MSW = 16-bit data address, page 0) --------------------
:VMOV32 "*(0:"imm16")", loc32  is rpt_phase=1 & op_hi8=0xBD & loc32 ; imm16
        { local a:4 = zext(imm16:2); *[ram]:4 a = loc32; }    # 0xBD: [0:addr] <- loc32
:VMOV32 loc32, "*(0:"imm16")"  is rpt_phase=1 & op_hi8=0xBF & loc32 ; imm16
        { local a:4 = zext(imm16:2); loc32 = *[ram]:4 a; }    # 0xBF: loc32 <- [0:addr]

# =============================================================================
# 0xE2 family: LSW = 1110 0010 <hi4> <lo4> ; MSW = 0000 0aaa mem32
# p_ra (MSW bits 8-10) = RaH, and the MSW's LOW 8 bits are a standard C28x loc byte --
# so the `mem32` / `mem16` operand is decoded by the SAME loc32 / loc16 sub-tables the
# integer instructions use, just matched in the second word (after the `;`). That is only
# expressible because the FPU MSW fields share the `instr16` token; see the token comment
# in tms320c28x.sinc.
#
# These used to be modelled as opaque identity moves (`p_ra = p_ra`, stores consumed into a
# dead local) on the belief that the address was unrecoverable. It isn't. The identity model
# was also actively harmful: a load that tells the decompiler nothing and a store that goes
# nowhere means an entire float pipeline has no observable effect and gets eliminated --
# whole clamp/lerp routines decompiled to nothing but the surrounding pointer arithmetic.
#
# Like every other loc16/loc32 user in this language, these are AMODE=0 only (there are no
# AMODE=1 constructors anywhere in addr.sinc).
#
# Exact LSW encodings (spruhs1c): 0xE200 mem32,STF  0xE203 mem32,RaH  0xE213 mem16,RaH
#   0xE223 MOVD32 RaH,mem32  0xE250 MACF32  0xE280 STF,mem32  0xE284 UI32TOF32  0xE288
#   I32TOF32  0xE2A0..AF MOV32 RaH,mem32,CNDF  0xE2C4 UI16TOF32  0xE2C8 I16TOF32
:MOV32 loc32, "STF"         is rpt_phase=1 & op16=0xE200 ; loc32  { packstf(STF); loc32 = STF; }  # sync sub-regs -> packed, then store
:MOV32 loc32, p_ra          is rpt_phase=1 & op16=0xE203 ; p_ra & loc32 { loc32 = p_ra; }         # store RaH -> mem32
:MOV16 loc16, p_ra          is rpt_phase=1 & op16=0xE213 ; p_ra & loc16 { loc16 = p_ra:2; }       # store RaH[15:0] -> mem16
# MOVD32 RaH, mem32: RaH = [mem32] AND [mem32+2] = [mem32]. loc32 exports the dereferenced
# cell rather than the address, so the duplicate store to mem32+2 is not modelled -- the
# load, which is what the dataflow needs, is.
:MOVD32 p_ra, loc32         is rpt_phase=1 & op16=0xE223 ; p_ra & loc32 { p_ra = loc32; }
# MACF32 R7H,R3H,mem32,*XAR7++  MSW: 0001 1111 mem32 (no register field -- both operands
# are memory). Standalone semantics per SPRUHS1C are
#     R3H = R3H + R2H ;  R2H = [mem32] * [XAR7++]
# i.e. the accumulate consumes the PREVIOUS product in R2H and only then is R2H overwritten.
# (The old model multiplied R3H by [XAR7] and accumulated into R7H, which was neither
# operand pairing nor either destination.) When repeated under RPT the destinations
# alternate R3H/R7H with R2H/R6H as the temporaries; only the standalone form is modelled.
:MACF32 "R7H,R3H", loc32, "*XAR7++"  is rpt_phase=1 & op16=0xE250 ; op_hi8=0x1F & loc32 {
    fpu_latch2($(FPK_ADD), R3H, R2H);
    R3H = R3H f+ R2H;
    local a:4 = XAR7;
    local m:4 = *[ram]:4 a;
    fpu_latch2($(FPK_MPY), loc32, m);
    R2H = loc32 f* m;
    XAR7 = XAR7 + 2;
}
:MOV32 "STF", loc32         is rpt_phase=1 & op16=0xE280 ; loc32  { STF = loc32; unpackstf(STF); }  # load mem -> STF, sync sub-regs
# int -> float converts. int2float is signed, so the unsigned forms widen first.
:UI32TOF32 p_ra, loc32      is rpt_phase=1 & op16=0xE284 ; p_ra & loc32 { local v:8 = zext(loc32); p_ra = int2float(v); }
:I32TOF32 p_ra, loc32       is rpt_phase=1 & op16=0xE288 ; p_ra & loc32 { p_ra = int2float(loc32); }
# MOV32 RaH, mem32 CNDF (0xE2A? family). UNCF (0b1111) is unconditional + updates the
# flags from the loaded value (ZI/NI along with ZF/NF, per SPRUHS1C Table 6-14);
# other codes are conditional and leave the flags alone.
:MOV32 p_ra, loc32, cndf    is rpt_phase=1 & op_hi8=0xE2 & loc_hi4=0b1010 & fcndf=0b1111 & cndf ; p_ra & loc32 {
    p_ra = loc32;
    update_stf_mov(p_ra);
}
:MOV32 p_ra, loc32, cndf    is rpt_phase=1 & op_hi8=0xE2 & loc_hi4=0b1010 & cndf ; p_ra & loc32 {
    if (!cndf) goto <done>;
    p_ra = loc32;
  <done>
}
:UI16TOF32 p_ra, loc16      is rpt_phase=1 & op16=0xE2C4 ; p_ra & loc16 { local v:4 = zext(loc16); p_ra = int2float(v); }
:I16TOF32 p_ra, loc16       is rpt_phase=1 & op16=0xE2C8 ; p_ra & loc16 { local v:2 = loc16; p_ra = int2float(v); }
# 0xe27x seen in firmware — undocumented load form, consume both words
:MOV32 p_ra, "mem32 (e27x)" is rpt_phase=1 & op_hi8=0xE2 & loc_hi4=0b0111 ; p_ra  { p_ra = p_ra; }

# MOV32 RaH, RbH {,CNDF}   LSW=1110 0110 1100 CNDF : MSW=0000 0000 00bb baaa
# UNCF (0b1111): unconditional move + MOV-flavoured flag update (ZI/NI plus
# ZF/NF, per SPRUHS1C Table 6-14).
# Others: genuinely conditional (was previously an unconditional copy with cndf
# rendered display-only, which mis-modeled the semantics for the decompiler).
:MOV32 f_ra, f_rb, cndf  is rpt_phase=1 & op_hi8=0xE6 & loc_hi4=0b1100 & fcndf=0b1111 & cndf
                         ; f_rb & f_ra & f_msw_hi=0 {
    f_ra = f_rb;
    update_stf_mov(f_ra);
}
:MOV32 f_ra, f_rb, cndf  is rpt_phase=1 & op_hi8=0xE6 & loc_hi4=0b1100 & cndf
                         ; f_rb & f_ra & f_msw_hi=0 {
    if (!cndf) goto <done>;
    f_ra = f_rb;
  <done>
}

attach variables [ p_rf ] [ R0H R1H R2H R3H R4H R5H R6H R7H ];
attach variables [ p_rd9 p_re12 ] [ R0H R1H R2H R3H R4H R5H R6H R7H ];

# --- split registers in the parallel forms -----------------------------------
# Two of the parallel-form register selectors straddle the word boundary, so no single
# field can name them. A sub-table whose own pattern spans both words can: the part before
# its `;` matches in the LSW, the part after in the MSW.
#
# p_re_l / p_re_h -- ReH in the "arith || MOV32 mem32" family (0xE0/0xE3). ReH is split:
# high bit is LSW bit 0 (e), low 2 bits are MSW bits 14-15 (ee), so ReH = (e << 2) | ee.
# Verified against dis2000: `e30d 6042` = MPYF32 R4H,R5H,R6H ||MOV32 R0H,*-SP[2] -- e=1,
# ee=1 -> R5H. A single sub-table cannot span the word boundary (a straddling pattern would
# push the parent's own second-word fields into a third word), so there is one half-table
# per value of e and the constructors below come in matching pairs.
p_re_l: "R0H"  is p_re_lo=0 { export R0H; }
p_re_l: "R1H"  is p_re_lo=1 { export R1H; }
p_re_l: "R2H"  is p_re_lo=2 { export R2H; }
p_re_l: "R3H"  is p_re_lo=3 { export R3H; }
p_re_h: "R4H"  is p_re_lo=0 { export R4H; }
p_re_h: "R5H"  is p_re_lo=1 { export R5H; }
p_re_h: "R6H"  is p_re_lo=2 { export R6H; }
p_re_h: "R7H"  is p_re_lo=3 { export R7H; }

# p_rf7_0 / p_rf7_1 -- RfH in the "MPYF32 || ADDF32/SUBF32" family (0xE74x/0xE75x). Here
# the split runs the OTHER way: the HIGH 2 bits are LSW bits 0-1 (ff) and the LOW bit is
# MSW bit 15 (f), so RfH = (ff << 1) | f. Verified against dis2000: `e753 c688` =
# MPYF32 R0H,R1H,R2H ||SUBF32 R3H,R4H,R7H -- ff=3, f=1 -> R7H (reading the halves the other
# way round would give R6H). These live in the LSW, selected by the MSW bit, so unlike
# p_re_* the sub-table is the word-1 operand and the selector is a plain word-2 constraint.
p_rf7_0: "R0H" is p_ff2=0 { export R0H; }
p_rf7_0: "R2H" is p_ff2=1 { export R2H; }
p_rf7_0: "R4H" is p_ff2=2 { export R4H; }
p_rf7_0: "R6H" is p_ff2=3 { export R6H; }
p_rf7_1: "R1H" is p_ff2=0 { export R1H; }
p_rf7_1: "R3H" is p_ff2=1 { export R3H; }
p_rf7_1: "R5H" is p_ff2=2 { export R5H; }
p_rf7_1: "R7H" is p_ff2=3 { export R7H; }

# =============================================================================
# Immediate-operand FP ops (2-word):  RaH = RbH {op} #16FHi
#   LSW: 1110 1000 ssII IIII   (ss = 01 MPY / 10 ADD / 11 SUB)
#   MSW: IIII IIII IIbb baaa   (aaa = dest RaH, bbb = SOURCE RbH)
# CRITICAL: dest (aaa) and source (bbb) are SEPARATE fields and routinely differ, so
# modeling this as `f_ra = f_ra` makes the result a self-reference — the decompiler then
# constant-folds the downstream CMP/branch and prunes real blocks as "unreachable". Read f_rb.
# The #16FHi constant is the HIGH 16 bits of the float (low mantissa = 0), split across both
# words. By the same convention proven for MOVIZ/CMPF32 (the LSW immediate bits are the
# HIGH-order bits), imm16 = (LSW[5:0] << 10) | MSW[15:6] = (fimm_lo6 << 10) | fimm_hi10.
# VERIFIED (was "INFERRED, no site to bench"): a real F28377D production image has such a
# site, and TI dis2000 agrees with this split — word pair `e84c ...` = MPYF32 R0H,#0x3180,R0H,
# i.e. imm16 = (fimm_lo6 << 10) | fimm_hi10 = (0x0C << 10) | 0x180 = 0x3180.
# The DISPLAY printed `fimm_hi10` alone (#0x180), so it is computed into ctx_fimm16 below.
:MPYF32 f_ra, "#"^ctx_fimm16, f_rb  is rpt_phase=1 & op_hi8=0xE8 & op_lo_76=0b01 & fimm_lo6 ; f_ra & f_rb & fimm_hi10
        [ ctx_fimm16 = (fimm_lo6 << 10) | fimm_hi10; ] {
    local imm:4 = (zext(fimm_lo6:4) << 10 | zext(fimm_hi10:4)) << 16;
    fpu_latch2($(FPK_MPY), f_rb, imm);
    f_ra = f_rb f* imm;
}
:ADDF32 f_ra, "#"^ctx_fimm16, f_rb  is rpt_phase=1 & op_hi8=0xE8 & op_lo_76=0b10 & fimm_lo6 ; f_ra & f_rb & fimm_hi10
        [ ctx_fimm16 = (fimm_lo6 << 10) | fimm_hi10; ] {
    local imm:4 = (zext(fimm_lo6:4) << 10 | zext(fimm_hi10:4)) << 16;
    fpu_latch2($(FPK_ADD), f_rb, imm);
    f_ra = f_rb f+ imm;
}
:SUBF32 f_ra, "#"^ctx_fimm16, f_rb  is rpt_phase=1 & op_hi8=0xE8 & op_lo_76=0b11 & fimm_lo6 ; f_ra & f_rb & fimm_hi10
        [ ctx_fimm16 = (fimm_lo6 << 10) | fimm_hi10; ] {
    local imm:4 = (zext(fimm_lo6:4) << 10 | zext(fimm_hi10:4)) << 16;
    fpu_latch2($(FPK_SUB), f_rb, imm);
    f_ra = f_rb f- imm;
}

# CMPF32 RaH, #16FHi   LSW: 1110 1000 0001 0III ; MSW: IIII IIII IIII Iaaa  (2-word)
# imm16 (high 16 bits of the float, low mantissa=0) is split: III (LSW[2:0]) = HIGH 3 bits,
# MSW[15:3] = LOW 13 bits → imm16 = (fimm_lo3 << 13) | fimm_hi13. (Was backwards — same bug
# as the MOVIZ/MOVXI fix; verified on a real image: #1.0/#2.0/#5.0 sites now decode right.)
:CMPF32 f_ra, "#"^ctx_fimm16  is rpt_phase=1 & op_hi8=0xE8 & loc_mode5=0b00010 & fimm_lo3 ; f_ra & fimm_hi13
        [ ctx_fimm16 = (fimm_lo3 << 13) | fimm_hi13; ] {
    local imm:4 = (zext(fimm_lo3:4) << 13 | zext(fimm_hi13:4)) << 16;
    setFloatFlags(f_ra, imm);
}
# CMPF32 RaH, #0.0     LSW: 1110 0101 1010 0aaa  (single word). fimm_reg = aaa.
:CMPF32 fimm_reg, "#0.0"  is rpt_phase=1 & op_hi8=0xE5 & loc_mode5=0b10100 & fimm_reg { local z:4 = 0; setFloatFlags(fimm_reg, z); }
# ZERO RaH             LSW: 1110 0101 1001 0aaa  (single word)
:ZERO fimm_reg            is rpt_phase=1 & op_hi8=0xE5 & loc_mode5=0b10010 & fimm_reg { fimm_reg = 0; }
# TESTTF CNDF          LSW: 1110 0101 1000 CNDF  (single word)
# Evaluate the float condition and latch it into STF's TF flag; a later
# `MOV32/NEGF32/SWAPF ...,TF|NTF` or `MOVST0 TF` (-> C/TC) tests it. This is the only
# writer of TF, so without it the TF/NTF conditions can never be anything but stale.
# Encoding confirmed against asm2000/dis2000: 0xE580=NEQ 0xE581=EQ ... 0xE58E=UNC.
# The selector must be loc_hi4, not loc_mode5: CNDF occupies bits 0-3 and loc_mode5
# (bits 3-7) would slice through it.
:TESTTF cndf              is rpt_phase=1 & op_hi8=0xE5 & loc_hi4=0b1000 & cndf { STF_TF = cndf; }
# NEGF32 RaH,RbH{,CNDF} LSW: 1110 0110 1010 CNDF ; MSW: 0000 0000 00bb baaa
# UNCF (0b1111): unconditional negate + update flags from the result.
# Others: conditional; leave flags alone.
:NEGF32 f_ra, f_rb, cndf  is rpt_phase=1 & op_hi8=0xE6 & loc_hi4=0b1010 & fcndf=0b1111 & cndf
                          ; f_rb & f_ra & f_msw_hi=0 {
    f_ra = f_rb ^ 0x80000000;
    update_stf(f_ra);
}
:NEGF32 f_ra, f_rb, cndf  is rpt_phase=1 & op_hi8=0xE6 & loc_hi4=0b1010 & cndf
                          ; f_rb & f_ra & f_msw_hi=0 {
    local val:4 = f_rb;
    if (!cndf) goto <done>;
    val = f_rb ^ 0x80000000;
  <done>
    f_ra = val;
}
# MOVST0 FLAG          LSW: 1010 1101 FFFF FFFF  (copy selected STF flags into ST0)
# ST0 holds the integer Z/N flags the SB ...,COND decoder reads, so MOVST0 is the bridge
# that keeps the CMPF32 -> MOVST0 -> SB(cond) idiom alive. Per SPRUHS1C the mapping is
# NOT one flag per bit -- several STF flags fold into one ST0 bit:
#     OV = LVF | LUF      N = NF | NI      Z = ZF | ZI      C = TF      TC = TF
# and "if any STF flag is not specified, the corresponding ST0 register bit is not
# modified", so each ST0 bit is a select-gated update rather than an unconditional write.
# LVF/LUF are additionally auto-cleared in STF when selected.
#
# `movst0_flags` carries the display (attach names, above); `imm8` is the same 8 bits as a
# plain number, because an attach-names field has no value usable in the semantic section.
# Every sel_* below is a decode-time constant, so the decompiler folds this whole block
# down to the one or two assignments the mask actually selects (mask 0x14 -> N/Z only,
# which is what every CMPF32/MAXF32/MINF32 site in PMR/DIR uses).
:MOVST0 movst0_flags   is rpt_phase=1 & op_hi8=0xAD & movst0_flags & imm8 {
    local mask:1 = imm8;    # sized copy: a bare field has no size for the & below
    local sel_lvf:1 = (mask & 0x01) != 0;
    local sel_luf:1 = (mask & 0x02) != 0;
    local sel_nf:1  = (mask & 0x04) != 0;
    local sel_ni:1  = (mask & 0x08) != 0;
    local sel_zf:1  = (mask & 0x10) != 0;
    local sel_zi:1  = (mask & 0x20) != 0;
    local sel_tf:1  = (mask & 0x80) != 0;

    local sel_ov:1 = sel_lvf || sel_luf;
    local ovval:1  = (sel_lvf && STF_LV) || (sel_luf && STF_LU);
    $(V) = (sel_ov && ovval) || (!sel_ov && $(V));

    local sel_n:1 = sel_nf || sel_ni;
    local nval:1  = (sel_nf && STF_NF) || (sel_ni && STF_NI);
    $(N) = (sel_n && nval) || (!sel_n && $(N));

    local sel_z:1 = sel_zf || sel_zi;
    local zval:1  = (sel_zf && STF_ZF) || (sel_zi && STF_ZI);
    $(Z) = (sel_z && zval) || (!sel_z && $(Z));

    $(C)  = (sel_tf && STF_TF) || (!sel_tf && $(C));
    $(TC) = (sel_tf && STF_TF) || (!sel_tf && $(TC));

    # "the LUF or LVF flags are automatically cleared if selected"
    STF_LV = STF_LV && !sel_lvf;
    STF_LU = STF_LU && !sel_luf;
}

# MAXF32 RaH, #16FHi   LSW: 1110 1000 0010 0III ; MSW: IIII IIII IIII Iaaa  (2-word)
# RaH = max(RaH, imm). imm16 = (LSW[2:0] << 13) | MSW[15:3] (III = HIGH 3 bits; see CMPF32).
# Compare updates ZF/NF; selected value flushed through fpu_minmax_output.
:MAXF32 f_ra, "#"^ctx_fimm16  is rpt_phase=1 & op_hi8=0xE8 & loc_mode5=0b00100 & fimm_lo3 ; f_ra & fimm_hi13
        [ ctx_fimm16 = (fimm_lo3 << 13) | fimm_hi13; ] {
    local imm:4 = (zext(fimm_lo3:4) << 13 | zext(fimm_hi13:4)) << 16;
    update_stf_cmp(f_ra, imm);
    if (f_ra f>= imm) goto <keep>;
    f_ra = imm;
  <keep>
    fpu_minmax_output(f_ra);
}
# MINF32 RaH, #16FHi   LSW: 1110 1000 0011 0III ; MSW: IIII IIII IIII Iaaa  (2-word)
:MINF32 f_ra, "#"^ctx_fimm16  is rpt_phase=1 & op_hi8=0xE8 & loc_mode5=0b00110 & fimm_lo3 ; f_ra & fimm_hi13
        [ ctx_fimm16 = (fimm_lo3 << 13) | fimm_hi13; ] {
    local imm:4 = (zext(fimm_lo3:4) << 13 | zext(fimm_hi13:4)) << 16;
    update_stf_cmp(f_ra, imm);
    if (f_ra f<= imm) goto <keep>;
    f_ra = imm;
  <keep>
    fpu_minmax_output(f_ra);
}
# MAXF32 RaH,RbH||MOV32 RcH,RdH  LSW: 1110 0110 1001 1100 ; MSW: 0000 dddc ccbb baaa
# The parallel move is CONDITIONAL on the same test as the max, not a free-standing copy:
#     if (RaH < RbH) { RaH = RbH; RcH = RdH; }
# (SPRUHS1C p.99.) It used to be modelled as an unconditional `RcH = RbH` -- wrong source
# *and* wrong control flow. RdH is p_rd9 in this MSW layout (bits 9-11), not p_rd.
:MAXF32 f_ra, f_rb, "||MOV32", f_rc, p_rd9  is rpt_phase=1 & op16=0xE69C ; f_rc & f_rb & f_ra & p_rd9 {
    update_stf_cmp(f_ra, f_rb);
    if (f_ra f>= f_rb) goto <skip>;
    f_ra = f_rb;
    f_rc = p_rd9;
  <skip>
    fpu_minmax_output(f_ra);
}
# MINF32 RaH,RbH||MOV32 RcH,RdH  LSW: 1110 0110 1001 1101 ; MSW: 0000 dddc ccbb baaa
#     if (RaH > RbH) { RaH = RbH; RcH = RdH; }
:MINF32 f_ra, f_rb, "||MOV32", f_rc, p_rd9  is rpt_phase=1 & op16=0xE69D ; f_rc & f_rb & f_ra & p_rd9 {
    update_stf_cmp(f_ra, f_rb);
    if (f_ra f<= f_rb) goto <skip>;
    f_ra = f_rb;
    f_rc = p_rd9;
  <skip>
    fpu_minmax_output(f_ra);
}
# SWAPF RaH,RbH{,CNDF}  LSW: 1110 0110 1110 CNDF ; MSW: 0000 0000 00bb baaa
# UNCF (0b1111): unconditional swap; per SPRUHS1C the swap itself doesn't touch flags.
# Others: conditional swap.
:SWAPF f_ra, f_rb, cndf  is rpt_phase=1 & op_hi8=0xE6 & loc_hi4=0b1110 & fcndf=0b1111 & cndf
                         ; f_rb & f_ra & f_msw_hi=0 {
    local t:4 = f_ra; f_ra = f_rb; f_rb = t;
}
:SWAPF f_ra, f_rb, cndf  is rpt_phase=1 & op_hi8=0xE6 & loc_hi4=0b1110 & cndf
                         ; f_rb & f_ra & f_msw_hi=0 {
    if (!cndf) goto <done>;
    local t:4 = f_ra; f_ra = f_rb; f_rb = t;
  <done>
}

# =============================================================================
# Parallel "arith || MOV32 mem32" family — 2-word.
#   LSW: 1110 00X0 YYYY fffe    MSW: eedd daaa mem32
# X selects the direction of the parallel move and YYYY the arithmetic op:
#   0xE0 = "... || MOV32 mem32, RaH"  (store)   0xE3 = "... || MOV32 RaH, mem32"  (load)
#   YYYY: 0000 MPYF32  0001 ADDF32  0010 SUBF32  0011 MACF32 R3H,R2H  1100 MACF32 R7H,R6H
# All five register selectors are now decoded: RdH = p_rd (MSW 11-13), RaH = p_ra (MSW
# 8-10), RfH = p_rf (LSW 1-3), ReH = the split p_re sub-table, and mem32 = loc32 on the
# MSW's low byte. These used to be `p_rd = p_rd` identity stubs with every operand except
# the dest dropped from the display, which meant a third of the FPU work in a DSP loop was
# invisible to both the listing and the decompiler.
#
# Source-before-dest ordering: the arithmetic reads ReH/RfH and the parallel MOV32 may
# target one of them (TI only forbids RaH == RdH), so the arithmetic is evaluated first.
#
# MACF32's accumulate consumes the PREVIOUS product out of R2H/R6H before RdH is
# rewritten, per SPRUHS1C: "R3H = R3H + R2H, RdH = ReH * RfH, RaH = [mem32]".
#   MPYF32 RdH,ReH,RfH || MOV32 mem32, RaH   LSW: E000 sub 0b0000
:MPYF32 p_rd, p_re_l, p_rf, "||MOV32", loc32, p_ra
        is rpt_phase=1 & op_hi8=0xE0 & loc_hi4=0b0000 & p_rf & p_re_hi=0 ; p_rd & p_ra & p_re_l & loc32 {
    fpu_latch2($(FPK_MPY), p_re_l, p_rf);
    p_rd = p_re_l f* p_rf;
    loc32 = p_ra;
}
:MPYF32 p_rd, p_re_h, p_rf, "||MOV32", loc32, p_ra
        is rpt_phase=1 & op_hi8=0xE0 & loc_hi4=0b0000 & p_rf & p_re_hi=1 ; p_rd & p_ra & p_re_h & loc32 {
    fpu_latch2($(FPK_MPY), p_re_h, p_rf);
    p_rd = p_re_h f* p_rf;
    loc32 = p_ra;
}
#   ADDF32 RdH,ReH,RfH || MOV32 mem32, RaH   LSW: E000 sub 0b0001
:ADDF32 p_rd, p_re_l, p_rf, "||MOV32", loc32, p_ra
        is rpt_phase=1 & op_hi8=0xE0 & loc_hi4=0b0001 & p_rf & p_re_hi=0 ; p_rd & p_ra & p_re_l & loc32 {
    fpu_latch2($(FPK_ADD), p_re_l, p_rf);
    p_rd = p_re_l f+ p_rf;
    loc32 = p_ra;
}
:ADDF32 p_rd, p_re_h, p_rf, "||MOV32", loc32, p_ra
        is rpt_phase=1 & op_hi8=0xE0 & loc_hi4=0b0001 & p_rf & p_re_hi=1 ; p_rd & p_ra & p_re_h & loc32 {
    fpu_latch2($(FPK_ADD), p_re_h, p_rf);
    p_rd = p_re_h f+ p_rf;
    loc32 = p_ra;
}
#   SUBF32 RdH,ReH,RfH || MOV32 mem32, RaH   LSW: E000 sub 0b0010
:SUBF32 p_rd, p_re_l, p_rf, "||MOV32", loc32, p_ra
        is rpt_phase=1 & op_hi8=0xE0 & loc_hi4=0b0010 & p_rf & p_re_hi=0 ; p_rd & p_ra & p_re_l & loc32 {
    fpu_latch2($(FPK_SUB), p_re_l, p_rf);
    p_rd = p_re_l f- p_rf;
    loc32 = p_ra;
}
:SUBF32 p_rd, p_re_h, p_rf, "||MOV32", loc32, p_ra
        is rpt_phase=1 & op_hi8=0xE0 & loc_hi4=0b0010 & p_rf & p_re_hi=1 ; p_rd & p_ra & p_re_h & loc32 {
    fpu_latch2($(FPK_SUB), p_re_h, p_rf);
    p_rd = p_re_h f- p_rf;
    loc32 = p_ra;
}
#   MPYF32 RdH,ReH,RfH || MOV32 RaH, mem32   LSW: E300 sub 0b0000
:MPYF32 p_rd, p_re_l, p_rf, "||MOV32", p_ra, loc32
        is rpt_phase=1 & op_hi8=0xE3 & loc_hi4=0b0000 & p_rf & p_re_hi=0 ; p_rd & p_ra & p_re_l & loc32 {
    fpu_latch2($(FPK_MPY), p_re_l, p_rf);
    p_rd = p_re_l f* p_rf;
    p_ra = loc32;
}
:MPYF32 p_rd, p_re_h, p_rf, "||MOV32", p_ra, loc32
        is rpt_phase=1 & op_hi8=0xE3 & loc_hi4=0b0000 & p_rf & p_re_hi=1 ; p_rd & p_ra & p_re_h & loc32 {
    fpu_latch2($(FPK_MPY), p_re_h, p_rf);
    p_rd = p_re_h f* p_rf;
    p_ra = loc32;
}
#   ADDF32 RdH,ReH,RfH || MOV32 RaH, mem32   LSW: E300 sub 0b0001
:ADDF32 p_rd, p_re_l, p_rf, "||MOV32", p_ra, loc32
        is rpt_phase=1 & op_hi8=0xE3 & loc_hi4=0b0001 & p_rf & p_re_hi=0 ; p_rd & p_ra & p_re_l & loc32 {
    fpu_latch2($(FPK_ADD), p_re_l, p_rf);
    p_rd = p_re_l f+ p_rf;
    p_ra = loc32;
}
:ADDF32 p_rd, p_re_h, p_rf, "||MOV32", p_ra, loc32
        is rpt_phase=1 & op_hi8=0xE3 & loc_hi4=0b0001 & p_rf & p_re_hi=1 ; p_rd & p_ra & p_re_h & loc32 {
    fpu_latch2($(FPK_ADD), p_re_h, p_rf);
    p_rd = p_re_h f+ p_rf;
    p_ra = loc32;
}
#   SUBF32 RdH,ReH,RfH || MOV32 RaH, mem32   LSW: E300 sub 0b0010
:SUBF32 p_rd, p_re_l, p_rf, "||MOV32", p_ra, loc32
        is rpt_phase=1 & op_hi8=0xE3 & loc_hi4=0b0010 & p_rf & p_re_hi=0 ; p_rd & p_ra & p_re_l & loc32 {
    fpu_latch2($(FPK_SUB), p_re_l, p_rf);
    p_rd = p_re_l f- p_rf;
    p_ra = loc32;
}
:SUBF32 p_rd, p_re_h, p_rf, "||MOV32", p_ra, loc32
        is rpt_phase=1 & op_hi8=0xE3 & loc_hi4=0b0010 & p_rf & p_re_hi=1 ; p_rd & p_ra & p_re_h & loc32 {
    fpu_latch2($(FPK_SUB), p_re_h, p_rf);
    p_rd = p_re_h f- p_rf;
    p_ra = loc32;
}
#   MACF32 R3H,R2H,RdH,ReH,RfH || MOV32 RaH, mem32   LSW: E300 sub 0b0011
:MACF32 "R3H,R2H", p_rd, p_re_l, p_rf, "||MOV32", p_ra, loc32
        is rpt_phase=1 & op_hi8=0xE3 & loc_hi4=0b0011 & p_rf & p_re_hi=0 ; p_rd & p_ra & p_re_l & loc32 {
    fpu_latch2($(FPK_ADD), R3H, R2H);
    R3H = R3H f+ R2H;
    fpu_latch2($(FPK_MPY), p_re_l, p_rf);
    p_rd = p_re_l f* p_rf;
    p_ra = loc32;
}
:MACF32 "R3H,R2H", p_rd, p_re_h, p_rf, "||MOV32", p_ra, loc32
        is rpt_phase=1 & op_hi8=0xE3 & loc_hi4=0b0011 & p_rf & p_re_hi=1 ; p_rd & p_ra & p_re_h & loc32 {
    fpu_latch2($(FPK_ADD), R3H, R2H);
    R3H = R3H f+ R2H;
    fpu_latch2($(FPK_MPY), p_re_h, p_rf);
    p_rd = p_re_h f* p_rf;
    p_ra = loc32;
}
#   MACF32 R7H,R6H,RdH,ReH,RfH || MOV32 RaH, mem32   LSW: E300 sub 0b1100
:MACF32 "R7H,R6H", p_rd, p_re_l, p_rf, "||MOV32", p_ra, loc32
        is rpt_phase=1 & op_hi8=0xE3 & loc_hi4=0b1100 & p_rf & p_re_hi=0 ; p_rd & p_ra & p_re_l & loc32 {
    fpu_latch2($(FPK_ADD), R7H, R6H);
    R7H = R7H f+ R6H;
    fpu_latch2($(FPK_MPY), p_re_l, p_rf);
    p_rd = p_re_l f* p_rf;
    p_ra = loc32;
}
:MACF32 "R7H,R6H", p_rd, p_re_h, p_rf, "||MOV32", p_ra, loc32
        is rpt_phase=1 & op_hi8=0xE3 & loc_hi4=0b1100 & p_rf & p_re_hi=1 ; p_rd & p_ra & p_re_h & loc32 {
    fpu_latch2($(FPK_ADD), R7H, R6H);
    R7H = R7H f+ R6H;
    fpu_latch2($(FPK_MPY), p_re_h, p_rf);
    p_rd = p_re_h f* p_rf;
    p_ra = loc32;
}

# =============================================================================
# Parallel "MPYF32 || ADDF32 / SUBF32" — 2-word, registers only (no memory operand).
#   LSW: 1110 0111 010Y 00ff    MSW: feee dddc ccbb baaa      (Y: 0 = ADDF32, 1 = SUBF32)
#   RaH = RbH * RcH ,  RdH = ReH +/- RfH
# Note the MSW layout differs from the ||MOV32 family above: ddd/eee sit one bit lower
# (p_rd9 / p_re12), and aaa/bbb/ccc are the ordinary f_ra/f_rb/f_rc.
:MPYF32 f_ra, f_rb, f_rc, "||ADDF32", p_rd9, p_re12, p_rf7_0
        is rpt_phase=1 & op_hi8=0xE7 & loc_hi4=0b0100 & p_rf7_0 ; f_ra & f_rb & f_rc & p_rd9 & p_re12 & p_rf_lo1=0 {
    fpu_latch2($(FPK_MPY), f_rb, f_rc);
    local prod:4 = f_rb f* f_rc;
    fpu_latch2($(FPK_ADD), p_re12, p_rf7_0);
    p_rd9 = p_re12 f+ p_rf7_0;
    f_ra = prod;
}
:MPYF32 f_ra, f_rb, f_rc, "||ADDF32", p_rd9, p_re12, p_rf7_1
        is rpt_phase=1 & op_hi8=0xE7 & loc_hi4=0b0100 & p_rf7_1 ; f_ra & f_rb & f_rc & p_rd9 & p_re12 & p_rf_lo1=1 {
    fpu_latch2($(FPK_MPY), f_rb, f_rc);
    local prod:4 = f_rb f* f_rc;
    fpu_latch2($(FPK_ADD), p_re12, p_rf7_1);
    p_rd9 = p_re12 f+ p_rf7_1;
    f_ra = prod;
}
:MPYF32 f_ra, f_rb, f_rc, "||SUBF32", p_rd9, p_re12, p_rf7_0
        is rpt_phase=1 & op_hi8=0xE7 & loc_hi4=0b0101 & p_rf7_0 ; f_ra & f_rb & f_rc & p_rd9 & p_re12 & p_rf_lo1=0 {
    fpu_latch2($(FPK_MPY), f_rb, f_rc);
    local prod:4 = f_rb f* f_rc;
    fpu_latch2($(FPK_SUB), p_re12, p_rf7_0);
    p_rd9 = p_re12 f- p_rf7_0;
    f_ra = prod;
}
:MPYF32 f_ra, f_rb, f_rc, "||SUBF32", p_rd9, p_re12, p_rf7_1
        is rpt_phase=1 & op_hi8=0xE7 & loc_hi4=0b0101 & p_rf7_1 ; f_ra & f_rb & f_rc & p_rd9 & p_re12 & p_rf_lo1=1 {
    fpu_latch2($(FPK_MPY), f_rb, f_rc);
    local prod:4 = f_rb f* f_rc;
    fpu_latch2($(FPK_SUB), p_re12, p_rf7_1);
    p_rd9 = p_re12 f- p_rf7_1;
    f_ra = prod;
}
