# Copyright 2026 Nishanth Samala
# Copyright the mwdmwd/ghidra-c28x contributors (https://github.com/mwdmwd/ghidra-c28x)
#
# Portions adapted from mwdmwd/ghidra-c28x (Apache-2.0): the switch_canonical
# constructor variants of MOV/ADD ACC,loc16<<#shft; the @AH / @AL destination split
# on XPREAD that gives SPRU430F's exact N/Z rule; and most of the C2xLP X* family
# below -- the 0x3F program page, the software-stack XCALL/XRETC model, the
# XB / XBANZ / XCALL / XRETC forms this module was missing, and the &XAR0 + ARP*4
# register indexing XBANZ uses. See THIRD-PARTY.md.
#
# C28x 0x56-prefix 2-word "extended" instruction family.
# Included by tms320c28x.sinc. Encodings from docs/c28x/ch6_instruction_detail.txt.
#
# THIS IS THE BIG MISSING FAMILY (74 instructions). Word1 = 0x5600 | sub-opcode,
# word2 = operand word (0000 | loc for loc-based forms). Their absence was the main
# cause of decode gaps / halt_baddata() in real code (the image is CODE, not data).
#
# Structure: a shared sub-opcode field on word1, then loc16/loc32 in word2.
# Common ALU forms get real semantics; exotic 64-bit/saturate/C2xLP forms are
# decode-only (correct mnemonic, minimal p-code) so disassembly doesn't dead-end.

# word1 low byte = the sub-opcode selector (bits 0..7 of the first word).
# (op_lo8 / loc_full8 already defined on instr16 cover this.)
# word2 carries the loc field in its low byte -> reuse loc16/loc32 AFTER the ';'.

# =============================================================================
# Common ALU forms (real semantics).  word1 = 0x56<sub>, word2 = loc.
# =============================================================================
# ADDL loc32,ACC    0x5601 : 0000 0000 LLLL LLLL
:ADDL loc32, ACCreg  is rpt_phase=1 & op16=0x5601 ; loc32 & ACCreg  { loc32 = loc32 + ACC; }
# SUBL loc32,ACC    0x5641
:SUBL loc32, ACCreg  is rpt_phase=1 & op16=0x5641 ; loc32 & ACCreg  { loc32 = loc32 - ACC; }
# SUBRL loc32,ACC    0x5649  (reverse subtract: loc = ACC - loc)
:SUBRL loc32, ACCreg is rpt_phase=1 & op16=0x5649 ; loc32 & ACCreg  { loc32 = ACC - loc32; }
# ADD ACC,loc16<<T   0x5623  (shift by T(3:0)). SPRU430F: N,Z,C,V per the 32-bit add
# of ACC + (mext(loc16) << sh) -- same as the plain ADD ACC,loc16 sibling.
:ADD ACCreg, loc16^"<<T"  is rpt_phase=1 & op16=0x5623 ; loc16 & ACCreg  {
    local sh:4 = zext(T:2) & 0xf;
    local b:4;
    mext(b, loc16);
    local addend:4 = b << sh;
    $(C) = carry(ACC, addend);
    $(V) = scarry(ACC, addend);
    ACC = ACC + addend;
    setNZ32(ACC);
    applyOvcSigned(ACC);
}
# SUB ACC,loc16<<T   0x5627. SPRU430F: N,Z,C(inverted borrow),V.
:SUB ACCreg, loc16^"<<T"  is rpt_phase=1 & op16=0x5627 ; loc16 & ACCreg  {
    local sh:4 = zext(T:2) & 0xf;
    local b:4;
    mext(b, loc16);
    local subend:4 = b << sh;
    $(C) = !(ACC < subend);
    $(V) = sborrow(ACC, subend);
    ACC = ACC - subend;
    setNZ32(ACC);
    applyOvcSigned(ACC);
}
# MOV ACC,loc16<<T   0x5606
:MOV ACCreg, loc16^"<<T"  is rpt_phase=1 & op16=0x5606 ; loc16 & ACCreg  {
    local sh:4 = zext(T:2) & 0xf;
    mov_acc_mext_shift(loc16, sh);
}
# MOV ACC,loc16<<#1..15   word1=0x5603 ; word2 = 0000 SHFT LLLL LLLL  (2-word; SHFT
# in word2 bits 8-11, loc16 in the low byte). The dominant missing opcode in the
# byte-swapped F28377D production firmware (~1443 sites).
#
# Canonical variant (switch_canonical=1): zero-extend the loc16 selector instead of
# sign-extending. TMS320C28xSwitchAnalyzer sets this context bit on the proven index
# instruction of a validated switch dispatch (see #18). The unsigned-selector semantics
# make ACC exactly bounded by loc16's [0, 0xffff] range, which is what lets the
# decompiler's Decompiler Switch Analysis prove the case-count bound reachable via the
# subsequent CMP/BF and the LB *XAR7. The default form extends per SXM, whose upper half
# is therefore not a constant the range check can see through. Adapted from
# mwdmwd/ghidra-c28x (Apache-2.0); see THIRD-PARTY.md.
:MOV ACCreg, loc16^"<<#"^shft_hi4  is rpt_phase=1 & switch_canonical=1 & op16=0x5603 ; shft_hi4 & loc16 & ACCreg {
    local sh:4 = zext(shft_hi4:1);
    ACC = zext(loc16) << sh;
    setNZ32(ACC);
}
:MOV ACCreg, loc16^"<<#"^shft_hi4  is rpt_phase=1 & op16=0x5603 ; shft_hi4 & loc16 & ACCreg {
    local sh:4 = zext(shft_hi4:1);
    mov_acc_mext_shift(loc16, sh);
}
# ADD ACC,loc16<<#1..15   word1=0x5604 ; word2 = 0000 SHFT LLLL LLLL  (2-word; same
# layout as MOV ACC,loc16<<# above). dis2000-confirmed (RWD image, word 0x5604).
#
# Canonical variant (switch_canonical=1): zero-extend loc16 and clear C, matching the
# unsigned-selector semantics needed for switch table-base + scaled-index arithmetic.
# See the MOV canonical form above for the full rationale. Adapted from mwdmwd/ghidra-c28x.
:ADD ACCreg, loc16^"<<#"^shft_hi4  is rpt_phase=1 & switch_canonical=1 & op16=0x5604 ; shft_hi4 & loc16 & ACCreg {
    local sh:4 = zext(shft_hi4:1);
    local v:4 = zext(loc16) << sh;
    ACC = ACC + v;
    $(C) = 0;
    setNZ32(ACC);
}
:ADD ACCreg, loc16^"<<#"^shft_hi4  is rpt_phase=1 & op16=0x5604 ; shft_hi4 & loc16 & ACCreg {
    local sh:4 = zext(shft_hi4:1);
    local b:4;
    mext(b, loc16);
    local addend:4 = b << sh;
    $(C) = carry(ACC, addend);
    $(V) = scarry(ACC, addend);
    ACC = ACC + addend;
    setNZ32(ACC);
    applyOvcSigned(ACC);
}
# ADDUL ACC,loc32    0x5653  (add unsigned 32). SPRU430F: N,Z,C,V; Table 2-5 groups
# ADDUL under "Unsigned Instructions" -- OVC increments on unsigned carry (C=1), not
# on signed overflow direction. Bounded by OVM.
:ADDUL ACCreg, loc32 is rpt_phase=1 & op16=0x5653 ; loc32 & ACCreg  {
    local b:4 = loc32;
    $(C) = carry(ACC, b);
    $(V) = scarry(ACC, b);
    ACC = ACC + b;
    setNZ32(ACC);
    applyOvcUnsigned();
}
# SUBUL ACC,loc32    0x5655  (subtract unsigned 32). SPRU430F: N,Z,C(inverted borrow),V.
# Table 2-5 lists SUBUL under "Signed Subtraction Instructions" -- OVC is updated on
# SIGNED overflow direction of the result, same as SUBL, not on unsigned borrow.
:SUBUL ACCreg, loc32 is rpt_phase=1 & op16=0x5655 ; loc32 & ACCreg  {
    local b:4 = loc32;
    $(C) = !(ACC < b);
    $(V) = sborrow(ACC, b);
    ACC = ACC - b;
    setNZ32(ACC);
    applyOvcSigned(ACC);
}
# SUBBL ACC,loc32    0x5654  (subtract 32-bit plus inverse borrow: ACC = ACC - loc32 - ~C).
# dis2000-confirmed (word 0x5654); the borrow-chain counterpart of SUBUL. Reached via a
# branch shadow in FUN_0008e3d7 — the fall-through sweep missed it.
:SUBBL ACCreg, loc32 is rpt_phase=1 & op16=0x5654 ; loc32 & ACCreg  {
    local nborrow:4 = zext($(C) == 0);   # ~C as 0/1  (borrow-in)
    local b:4 = loc32 + nborrow;         # combined subtrahend
    $(C) = !(ACC < b);
    $(V) = sborrow(ACC, b);
    ACC = ACC - b;
    setNZ32(ACC);
    applyOvcSigned(ACC);
}
# ADDCL ACC,loc32   0x5640  (add 32-bit value plus carry to ACC). dis2000-confirmed (DIR).
# SPRU430F: N/Z/C/V + OVC. Combined-addend pattern mirrors SUBBL above.
:ADDCL ACCreg, loc32 is rpt_phase=1 & op16=0x5640 ; loc32 & ACCreg  {
    local cin:4 = zext($(C));
    local b:4 = loc32 + cin;
    $(C) = carry(ACC, b);
    $(V) = scarry(ACC, b);
    ACC = ACC + b;
    setNZ32(ACC);
    applyOvcSigned(ACC);
}
# MOVU loc16,OVC    0x5628 : loc16  (STORE the 6-bit OVC into low bits of [loc16];
# upper 10 bits of the target are zeroed). Was writing literal 0 -- fixed to write the
# actual counter now that OVC is modeled. SPRU430F: `[loc16(15:6)]=0; [loc16(5:0)]=OVC`.
:MOVU loc16, "OVC" is rpt_phase=1 & op16=0x5628 ; loc16  {
    loc16 = zext(OVC) & 0x3f;
}
# MOV loc16,OVC     0x5629 : loc16  (STORE OVC into the UPPER 6 bits of [loc16], lower
# 10 bits zeroed). Signed-store counterpart of MOVU above. Missing from prior spec.
# SPRU430F: `[loc16(15:10)]=OVC; [loc16(9:0)]=0`. N/Z on @AX destinations only per
# manual, and the AX loc16 lands here via the shared loc16 sub-table -- setNZ16 is
# safe regardless because @AX writes update the AX view first.
:MOV loc16, "OVC"  is rpt_phase=1 & op16=0x5629 ; loc16  {
    loc16 = (zext(OVC) & 0x3f) << 10;
}
# MOV OVC,loc16     0x5602 : loc16  (LOAD OVC from the UPPER 6 bits of [loc16]).
# SPRU430F: `OVC = [loc16(15:10)]`. Missing from prior spec.
:MOV "OVC", loc16  is rpt_phase=1 & op16=0x5602 ; loc16  {
    local v:2 = loc16 >> 10;
    OVC = v:1;
}
# MOVU OVC,loc16    0x5662 : loc16  (LOAD OVC from the LOWER 6 bits of [loc16]).
# SPRU430F: `OVC = [loc16(5:0)]`. Missing from prior spec.
:MOVU "OVC", loc16 is rpt_phase=1 & op16=0x5662 ; loc16  {
    local v:2 = loc16 & 0x3f;
    OVC = v:1;
}
# MOV TL,#0   0x5656  (clear the lower half of XT; XT high half = T preserved). 1-word.
:MOV "TL", "#0"  is rpt_phase=1 & op16=0x5656  { XT = XT & 0xffff0000; }
# ADDUL P,loc32      0x5657
:ADDUL Preg, loc32   is rpt_phase=1 & op16=0x5657 ; loc32 & Preg  { P = P + loc32; }
# SUBUL P,loc32      0x565d
:SUBUL Preg, loc32   is rpt_phase=1 & op16=0x565d ; loc32 & Preg  { P = P - loc32; }
# MAXL ACC,loc32     0x5661  (ACC = max(ACC, loc32), signed). Sets N/Z from the signed
# compare (N = ACC<loc32, Z = ACC==loc32) so a following MAXCUL P,loc32 can consume them.
:MAXL ACCreg, loc32  is rpt_phase=1 & op16=0x5661 ; loc32 & ACCreg  {
    local v:4 = loc32;
    $(Z) = (ACC == v);
    $(N) = (ACC s< v);
    if (ACC s>= v) goto inst_next;
    ACC = v;
}
# MINL ACC,loc32     0x5650. Sets N/Z from the signed compare so a following MINCUL P,loc32
# can consume them (the 64-bit min idiom).
:MINL ACCreg, loc32  is rpt_phase=1 & op16=0x5650 ; loc32 & ACCreg  {
    local v:4 = loc32;
    $(Z) = (ACC == v);
    $(N) = (ACC s< v);
    if (ACC s<= v) goto inst_next;
    ACC = v;
}
# MAXCUL P,loc32     0x5651  (conditional UNSIGNED max of the low word, using N/Z from the
# preceding MAXL). Manual pseudocode: if(N=1&Z=0) P=loc32; if(N=0&Z=1&P<loc32) P=loc32; else
# unchanged. Pairs with MAXL to form a 64-bit maximum/saturate. WAS MISSING -> decoding 0x5651
# desynced the linear sweep (phantom "FFC" ops); e.g. the MATH sine ramfunc tail @0x881c8.
:MAXCUL Preg, loc32  is rpt_phase=1 & op16=0x5651 ; loc32 & Preg  {
    local v:4 = loc32;
    local doset:1 = ($(N) != 0) | (($(Z) != 0) & (P < v));
    if (doset == 0) goto inst_next;
    P = v;
}
# MINCUL P,loc32     0x5659  (conditional UNSIGNED min of the low word, using N/Z from the
# preceding MINL). Manual pseudocode: if(N=0&Z=0) P=loc32; if(N=0&Z=1&P>loc32) P=loc32; else
# unchanged. Pairs with MINL to form a 64-bit minimum/saturate. WAS MISSING -> decoding 0x5659
# desynced the linear sweep (phantom "FFC" ops); e.g. the MATH sine ramfunc tail @0x881c4.
:MINCUL Preg, loc32  is rpt_phase=1 & op16=0x5659 ; loc32 & Preg  {
    local v:4 = loc32;
    local doset:1 = ($(N) == 0) & (($(Z) == 0) | (P > v));
    if (doset == 0) goto inst_next;
    P = v;
}

# =============================================================================
# 1-word 0x56 forms: SAT64 (saturate the 64-bit ACC:P) + NORM ACC,<indirect>.
# asm2000/dis2000-confirmed single-word encodings. These are SPECIFIC op16 matches
# (NOT a broad op_hi8=0x56 & loc16 fallback -- that would mis-claim SAT64 and every
# other undecoded 0x56xx word). Decode-focused p-code so the linear sweep doesn't
# dead-end (SAT64 = the plan target @ ramfunc 0x9429; NORM appears in the mixed
# code/data math region ~0xb5xxx).
# =============================================================================
# SAT64 ACC:P  0x563e  (signed-saturate the 64-bit ACC:P value into ACC's 32-bit
# range). Modelled as an ACC touch, matching the file's SAT ACC (0xFF57) convention.
# SAT64 ACC:P   0101 0110 0011 1110  (saturate 64-bit ACC:P per OVC; clear OVC).
# SPRU430F 6.x mirrors SAT ACC but on the concatenated 64-bit value:
#   OVC > 0 -> ACC:P = 0x7FFF FFFF FFFF FFFF; V = 1
#   OVC < 0 -> ACC:P = 0x8000 0000 0000 0000; V = 1
#   OVC = 0 -> ACC:P unchanged;                V = 0
#   OVC = 0 in all cases. C cleared. N/Z reflect the combined 64-bit value.
:SAT64 "ACC:P"  is rpt_phase=1 & op16=0x563e {
    local ovc_s:1 = OVC;
    $(V) = (ovc_s != 0);
    $(C) = 0;
    if (ovc_s s<= 0) goto <not_pos>;
    ACC = 0x7FFFFFFF;
    P   = 0xFFFFFFFF;
    goto <done>;
    <not_pos>
    if (ovc_s s>= 0) goto <done>;
    ACC = 0x80000000;
    P   = 0x00000000;
    <done>
    OVC = 0;
    # N reflects bit 31 of ACC (high half sign); Z is the combined 64-bit zero test.
    $(N) = (ACC s< 0);
    $(Z) = (ACC == 0) && (P == 0);
}
# NORM ACC,<ind>  1-word; the low byte is the loc16 addressing selector for the
# indirect forms (*, *++, *--, *0++, *0--). NORM normalizes ACC + adjusts T + modifies
# the AR; decode-only here (the AR post-modify/exponent update is not modelled).
:NORM "ACC,*"     is rpt_phase=1 & op16=0x5624 { }
:NORM "ACC,*++"   is rpt_phase=1 & op16=0x565a { }
:NORM "ACC,*--"   is rpt_phase=1 & op16=0x5620 { }
:NORM "ACC,*0++"  is rpt_phase=1 & op16=0x5677 { }
:NORM "ACC,*0--"  is rpt_phase=1 & op16=0x5630 { }

# =============================================================================
# 32x32 multiplies (IMPYL/QMPYL family) -- real semantics into ACC or P.
# word1=0x56<sub>, word2=loc32 (the 32-bit source); XT is the other operand.
# =============================================================================
:IMPYL ACCreg, XTreg, loc32  is rpt_phase=1 & op16=0x5644 ; loc32 & ACCreg & XTreg {
    local a:8 = sext(XT); local b:8 = sext(loc32); local r:8 = a * b; ACC = r:4;  # low 32
    setNZ32(ACC);  # SPRU430F: N,Z on the ACC-writing form (was missing)
}
:IMPYL Preg, XTreg, loc32    is rpt_phase=1 & op16=0x5605 ; loc32 & Preg & XTreg {
    local a:8 = sext(XT); local b:8 = sext(loc32); local r:8 = a * b; P = r:4;
}
:QMPYL ACCreg, XTreg, loc32  is rpt_phase=1 & op16=0x5663 ; loc32 & ACCreg & XTreg {
    local a:8 = sext(XT); local b:8 = sext(loc32); local r:8 = (a * b) >> 32; ACC = r:4;  # high 32
    setNZ32(ACC);  # SPRU430F: N,Z only (this is the sign/zero of the Q30 high half)
}
:QMPYL Preg, XTreg, loc32    is rpt_phase=1 & op16=0x5667 ; loc32 & Preg & XTreg {
    local a:8 = sext(XT); local b:8 = sext(loc32); local r:8 = (a * b) >> 32; P = r:4;  # high 32 -> P
}
# QMPYUL P,XT,loc32  0x5647  (UNSIGNED 32x32, upper 32 -> P). dis2000-confirmed (DIR image).
:QMPYUL Preg, XTreg, loc32   is rpt_phase=1 & op16=0x5647 ; loc32 & Preg & XTreg {
    local a:8 = zext(XT); local b:8 = zext(loc32); local r:8 = (a * b) >> 32; P = r:4;  # high 32 -> P
}
# QMPYXUL P,XT,loc32  0x5642  (SIGNED XT x UNSIGNED loc32, upper 32 -> P). dis2000-confirmed
# (pmrbl image, word 0x858c4). Mixed-sign: sext(XT) * zext(loc32).
:QMPYXUL Preg, XTreg, loc32  is rpt_phase=1 & op16=0x5642 ; loc32 & Preg & XTreg {
    local a:8 = sext(XT); local b:8 = zext(loc32); local r:8 = (a * b) >> 32; P = r:4;  # high 32 -> P
}
# IMPYXUL P,XT,loc32  0x5665  (SIGNED XT x UNSIGNED loc32, LOWER 32 -> P). dis2000-confirmed
# (PCS411 image, word 0x95a43 — in a QMPYXUL/IMPYL extended-precision multiply). Mixed-sign,
# low half: sext(XT) * zext(loc32).
:IMPYXUL Preg, XTreg, loc32  is rpt_phase=1 & op16=0x5665 ; loc32 & Preg & XTreg {
    local a:8 = sext(XT); local b:8 = zext(loc32); local r:8 = a * b; P = r:4;  # low 32 -> P
}
# =============================================================================
# 32x32 multiply-accumulate forms. Same word1=0x56<sub> / word2=loc32 shape as
# above, but with an ACC ± P step BEFORE the P update. Encodings dis2000-confirmed
# from a cl2000-assembled fixture (tests/mac_ext56.bin). Semantics per SPRU430F:
#   QMPYAL 0x5646  ACC += P;  P = (sXT * s[loc32]) >> 32;   N/Z/C/V + signed OVC
#   QMPYSL 0x5645  ACC -= P;  P = (sXT * s[loc32]) >> 32;   N/Z/C/V + signed OVC
#   IMPYAL 0x564C  ACC += P;  P =  sXT * s[loc32]  (low 32); N/Z/C/V + UNSIGNED OVCU
# IMPYAL adds P as UNSIGNED (ignoring PM) and counts on unsigned carry (OVCU); its
# spec sheet is explicit that OVM does not gate OVCU -- the applyOvcUnsigned macro
# was fixed to match while this batch was in flight.
# =============================================================================
:QMPYAL Preg, XTreg, loc32  is rpt_phase=1 & op16=0x5646 ; loc32 & Preg & XTreg {
    local b:4 = P;
    $(C) = carry(ACC, b);
    $(V) = scarry(ACC, b);
    ACC = ACC + b;
    setNZ32(ACC);
    applyOvcSigned(ACC);
    local a:8 = sext(XT); local m:8 = sext(loc32); local r:8 = (a * m) >> 32; P = r:4;
}
:QMPYSL Preg, XTreg, loc32  is rpt_phase=1 & op16=0x5645 ; loc32 & Preg & XTreg {
    local b:4 = P;
    $(C) = !(ACC < b);
    $(V) = sborrow(ACC, b);
    ACC = ACC - b;
    setNZ32(ACC);
    applyOvcSigned(ACC);
    local a:8 = sext(XT); local m:8 = sext(loc32); local r:8 = (a * m) >> 32; P = r:4;
}
:IMPYAL Preg, XTreg, loc32  is rpt_phase=1 & op16=0x564C ; loc32 & Preg & XTreg {
    local b:4 = P;
    $(C) = carry(ACC, b);
    $(V) = scarry(ACC, b);
    ACC = ACC + b;
    setNZ32(ACC);
    applyOvcUnsigned();
    local a:8 = sext(XT); local m:8 = sext(loc32); local r:8 = a * m; P = r:4;
}
# =============================================================================
# DMAC / QMACL / IMACL — 32-bit MAC forms with two syntax variants each. Word 2
# looks like <mode:8> <loc32:8>: the low byte is the standard loc32 field, while
# the HIGH byte distinguishes *XAR7 (0xC7) from *XAR7++ (0x87). Encodings were
# confirmed by cl2000 -c on a small .asm and dis2000 -a round-trip on the .obj
# across all six variants + several loc32 modes; see tests/mac_ext56.
#
# Word-addressable memory: `*[ram]:4 XAR7` reads 4 bytes = 2 words at word
# address XAR7. Post-increment XAR7 by 2 (two word-addresses) because each
# reads a 32-bit value from program memory. SPRU430F's IMACL page says
# "post-increment ... by 1" (vs "by 2" for DMAC/QMACL) -- appears to be a
# manual typo (all three read the same 32-bit width); modelled uniformly as
# += 2 and flagged for verification if firmware ever exercises the +XAR7++
# form of IMACL specifically.
#
# Flags per SPRU430F on the ACC ± P step:
#   DMAC   0x564B ; word2 mode|loc32  N/Z/C/V + signed OVC (ACC gets high×high)
#   QMACL  0x564F ; word2 mode|loc32  N/Z/C/V + signed OVC
#   IMACL  0x564D ; word2 mode|loc32  N/Z/C/V + UNSIGNED OVCU (adds P as unsigned)
# For DMAC, ACC and P both accumulate; flag effects on ACC only per manual.
# =============================================================================
:DMAC "ACC:P,"loc32",*XAR7"  is rpt_phase=1 & op16=0x564B ; xar7_mode=0xC7 & loc32 {
    local xt:4  = loc32;
    local tmp:4 = *[ram]:4 XAR7;
    local xt_hi:2  = xt(2);   local xt_lo:2  = xt:2;
    local tmp_hi:2 = tmp(2);  local tmp_lo:2 = tmp:2;
    local a:4 = sext(xt_hi);  local mh:4 = sext(tmp_hi);
    local addend:4 = a * mh;
    $(C) = carry(ACC, addend);
    $(V) = scarry(ACC, addend);
    ACC = ACC + addend;
    setNZ32(ACC);
    applyOvcSigned(ACC);
    local b:4 = sext(xt_lo);  local ml:4 = sext(tmp_lo);
    P = P + (b * ml);
}
:DMAC "ACC:P,"loc32",*XAR7++"  is rpt_phase=1 & op16=0x564B ; xar7_mode=0x87 & loc32 {
    local xt:4  = loc32;
    local tmp:4 = *[ram]:4 XAR7;
    local xt_hi:2  = xt(2);   local xt_lo:2  = xt:2;
    local tmp_hi:2 = tmp(2);  local tmp_lo:2 = tmp:2;
    local a:4 = sext(xt_hi);  local mh:4 = sext(tmp_hi);
    local addend:4 = a * mh;
    $(C) = carry(ACC, addend);
    $(V) = scarry(ACC, addend);
    ACC = ACC + addend;
    setNZ32(ACC);
    applyOvcSigned(ACC);
    local b:4 = sext(xt_lo);  local ml:4 = sext(tmp_lo);
    P = P + (b * ml);
    XAR7 = XAR7 + 2;   # post-increment (2 word-addresses = 32 bits)
}
:QMACL "P,"loc32",*XAR7"  is rpt_phase=1 & op16=0x564F ; xar7_mode=0xC7 & loc32 {
    local b:4 = P;
    $(C) = carry(ACC, b);
    $(V) = scarry(ACC, b);
    ACC = ACC + b;
    setNZ32(ACC);
    applyOvcSigned(ACC);
    local a:8   = sext(loc32);
    local tmp:4 = *[ram]:4 XAR7;
    local m:8   = sext(tmp);
    local r:8   = (a * m) >> 32;
    P = r:4;
}
:QMACL "P,"loc32",*XAR7++"  is rpt_phase=1 & op16=0x564F ; xar7_mode=0x87 & loc32 {
    local b:4 = P;
    $(C) = carry(ACC, b);
    $(V) = scarry(ACC, b);
    ACC = ACC + b;
    setNZ32(ACC);
    applyOvcSigned(ACC);
    local a:8   = sext(loc32);
    local tmp:4 = *[ram]:4 XAR7;
    local m:8   = sext(tmp);
    local r:8   = (a * m) >> 32;
    P = r:4;
    XAR7 = XAR7 + 2;
}
:IMACL "P,"loc32",*XAR7"  is rpt_phase=1 & op16=0x564D ; xar7_mode=0xC7 & loc32 {
    local b:4 = P;
    $(C) = carry(ACC, b);
    $(V) = scarry(ACC, b);
    ACC = ACC + b;
    setNZ32(ACC);
    applyOvcUnsigned();
    local a:8   = sext(loc32);
    local tmp:4 = *[ram]:4 XAR7;
    local m:8   = sext(tmp);
    local r:8   = a * m;
    P = r:4;   # low 32 bits (PM=0 modeled)
}
:IMACL "P,"loc32",*XAR7++"  is rpt_phase=1 & op16=0x564D ; xar7_mode=0x87 & loc32 {
    local b:4 = P;
    $(C) = carry(ACC, b);
    $(V) = scarry(ACC, b);
    ACC = ACC + b;
    setNZ32(ACC);
    applyOvcUnsigned();
    local a:8   = sext(loc32);
    local tmp:4 = *[ram]:4 XAR7;
    local m:8   = sext(tmp);
    local r:8   = a * m;
    P = r:4;
    XAR7 = XAR7 + 2;
}
# Square-and-accumulate (MAC-style; 2-word, loc16 in word2). dis2000-confirmed.
# SQRA: ACC += P (PM=0); T=[loc16]; P = T*T.  SQRS: ACC -= P; T=[loc16]; P = T*T.
# SPRU430F: N/Z/C/V + OVC on the ACC += P (SQRA) / ACC -= P (SQRS) step.
:SQRA loc16  is rpt_phase=1 & op16=0x5615 ; loc16 {
    local b:4 = P;
    $(C) = carry(ACC, b);
    $(V) = scarry(ACC, b);
    ACC = ACC + b;
    setNZ32(ACC);
    applyOvcSigned(ACC);
    T = loc16; local t:4 = sext(T); P = t * t;
}
:SQRS loc16  is rpt_phase=1 & op16=0x5611 ; loc16 {
    local b:4 = P;
    $(C) = !(ACC < b);
    $(V) = sborrow(ACC, b);
    ACC = ACC - b;
    setNZ32(ACC);
    applyOvcSigned(ACC);
    T = loc16; local t:4 = sext(T); P = t * t;
}
# ZALR ACC,loc16  0x5613 : loc16  -- AL = 0x8000 (round const), AH = [loc16]. dis2000-confirmed.
# SPRU430F states it as the two halves ("AH = [loc16]; AL = 0x8000;"), but writing it that
# way leaves the decompiler with two 16-bit stores it has to glue back together, so every
# later read of ACC renders as CONCAT22(AH, AL). One full-width store of the same value
# reads as a single 32-bit definition instead. Identical semantics: AH is the high half.
#
# The difference is p-code SHAPE, not behaviour, so it is invisible to emulation and to
# every decode fixture. Measured on the emitted ops for `ZALR ACC,@AR0`:
#   was:  (register,0x0,2) COPY 0x8000   +  (register,0x2,2) COPY AR0    -- AL and AH
#   now:  (register,0x0,4) INT_OR ...                                    -- ACC, once
# EmuZalrTest guards the half assignment and the zero-extension, which a one-store
# rewrite can get wrong; ZALR has no site in either measured image, so nothing else does.
:ZALR ACCreg, loc16  is rpt_phase=1 & op16=0x5613 ; loc16 & ACCreg {
    ACC = (zext(loc16) << 16) | 0x8000;
    setNZ32(ACC);  # SPRU430F: N,Z from ACC after the load
}

# =============================================================================
# Bit-test / square-accumulate (real-ish).
# =============================================================================
# TBIT loc16,T      0x5625
:TBIT loc16, "T"  is rpt_phase=1 & op16=0x5625 ; loc16  {
    local t16:2 = T;
    local sh:2 = t16 & 0xf;
    local v:2 = loc16;
    $(TC) = ((v >> sh) & 1) != 0;
}
# TSET loc16,#16bit 0x560d : loc word ; imm word -- 3-word; decode-only-ish
:TSET loc16, "#16bit"  is rpt_phase=1 & op16=0x560d ; loc16  { }   # decode-only
# TCLR loc16,#bit   0x5609
:TCLR loc16, "#bit"  is rpt_phase=1 & op16=0x5609 ; loc16  { }     # decode-only

# =============================================================================
# Flag / mode set/clear (single-purpose; one constructor per distinct opcode).
# Note: several mnemonics share an opcode (C28ADDR==CLRC AMODE==0x5616, etc.);
# we pick the canonical name per opcode to avoid duplicate-pattern conflicts.
# =============================================================================
# CLRC/SETC AMODE select the addressing-mode decode for everything that FOLLOWS, so they
# must propagate the ctx_AMODE decode context forward (globalset on inst_next), not just
# flip the runtime ST1 bit. Without this the disassembler always decoded as AMODE=0 and
# any AMODE=1 (C2xLP-compatible) run after a SETC AMODE was mis-decoded. The AMODE=1 loc
# rows are added separately (see addr.sinc); this is the flow that activates them.
:CLRC "AMODE"   is rpt_phase=1 & op16=0x5616 [ ctx_AMODE = 0; globalset(inst_next, ctx_AMODE); ]
                { $(AMODE) = 0; }   # = C28ADDR
:SETC "AMODE"   is rpt_phase=1 & op16=0x561e [ ctx_AMODE = 1; globalset(inst_next, ctx_AMODE); ]
                { $(AMODE) = 1; }   # = LPADDR
:SETC "Objmode" is rpt_phase=1 & op16=0x561f { OBJMODE = 1; }    # = C28OBJ
:CLRC "Objmode" is rpt_phase=1 & op16=0x5636 { OBJMODE = 0; }    # = C27OBJ
:SETC "XF"      is rpt_phase=1 & op16=0x5626 { XF = 1; }
:CLRC "XF"      is rpt_phase=1 & op16=0x561b { XF = 0; }
:CLRC "OVC"     is rpt_phase=1 & op16=0x565c { OVC = 0; }        # = ZAP OVC
# ZAPA   0101 0110 0011 0011  (zero ACC, P AND OVC). SPRU430F: "Zero the ACC and P
# registers as well as the overflow counter (OVC)." Prior body cleared ACC and P but
# not OVC -- ran counter to the instruction's purpose (a preamble to saturating loops
# like the QMACL example in the manual). N/Z semantics: the SPRU430F "Flags and Modes
# Affected" table for ZAPA reads N=set, Z=cleared (verbatim); this appears inverted
# vs. what the ACC=0 result would imply, so N/Z are left unset here rather than
# encoded either way -- if a firmware site actually depends on N/Z after ZAPA, wire
# per what real hardware does, not the manual text.
:ZAPA           is rpt_phase=1 & op16=0x5633 { ACC = 0; P = 0; OVC = 0; }
# More 0x56 mode/config bits (dis2000-confirmed; in the PCS reset/init routine at 0x947fc).
:SETC "CNF"     is rpt_phase=1 & op16=0x5612 { }                 # map block B0 to program space (decode-only)
:SETC "M0M1MAP" is rpt_phase=1 & op16=0x561a { M0M1MAP = 1; }    # = C28MAP (boot mode bit)
# CMPR n  0101 0110 0001 NN0N  (compare AR(ARP) with AR(n); set TC). dis2000: 1d=0 19=1 18=2 1c=3.
:CMPR "0"       is rpt_phase=1 & op16=0x561d { }                 # decode-only (TC result not modeled)
:CMPR "1"       is rpt_phase=1 & op16=0x5619 { }
:CMPR "2"       is rpt_phase=1 & op16=0x5618 { }
:CMPR "3"       is rpt_phase=1 & op16=0x561c { }

# =============================================================================
# Conditional store (MOVL loc32,ACC,COND) -- 0x5648, COND in word2.
# =============================================================================
:MOVL loc32, ACCreg, CC  is rpt_phase=1 & op16=0x5648 ; cond4 & CC & loc32 & ACCreg {
    local take:1 = CC;
    if (take == 0) goto inst_next;
    loc32 = ACC;
}

# MOVB loc16,#8bit,COND  0101 0110 1011 COND : CCCC CCCC LLLL LLLL  (2-word).
# COND is in word1's low nibble (cond4); word2 = 8-bit const (high byte, imm8_hi) +
# loc16 (low byte). Conditional byte store: if (COND) [loc16] = 0:8bit. Previously the
# immediate wasn't decoded (rendered literal "#8bit") and the store was never emitted.
:MOVB loc16, "#"imm8_hi, CC  is rpt_phase=1 & op_hi8=0x56 & loc_hi4=0b1011 & cond4 & CC ; loc16 & imm8_hi {
    local take:1 = CC;
    if (take == 0) goto inst_next;
    loc16 = zext(imm8_hi:1);
}

# =============================================================================
# C2xLP source-compatible family (X*)
# =============================================================================
# Every instruction here forces the upper 6 bits of the 22-bit program address to 0x3F -- see the
# xpmadest / xpmaval sub-tables in tms320c28x_flow.sinc for the rule and the trap (the NON-X
# counterparts force 0x00 instead). The `*AL` forms below do the same at runtime.
#
# These exist for hand-ported C2xLP assembly; TI's C compiler does not emit them, and a sweep of
# four production images found none in real code. Modelled anyway so a hand-written routine
# decompiles correctly rather than silently reading the wrong page.
#
# Encodings and rendering verified against TI's own asm2000/dis2000 for all 28 forms.

# XCALL pushes only the LOW 16 bits of the return address onto the SOFTWARE STACK -- SPRU430F:
# "temp(21:0) = PC + 1; [SP] = temp(15:0); SP = SP + 1" -- and XRETC pops it back, re-forcing the
# page: "SP = SP - 1; PC = 0x3F:[SP]". This is NOT the RPC mechanism LCR/LRETR use. An XCALL
# leaves RPC untouched and moves SP; this module previously modelled the exact opposite, which
# was self-consistent (XCALL wrote RPC, XRET read it) and therefore invisible, but left SP
# unchanged across the call and clobbered a register hardware does not touch.
macro xcall_push(retlo) {
    local sp:4 = SP;
    *[ram]:2 sp = retlo;
    SP = SP + 1;
}
macro xret_pop(tgt) {
    SP = SP - 1;
    local sp:4 = SP;
    local lo:2 = *[ram]:2 sp;
    tgt = 0x3f0000 | zext(lo);
}

# XBANZ tests and updates XAR[ARP] -- the auxiliary register selected at RUNTIME by ARP. SLEIGH
# CAN index a register file: take the address of the first register and offset into the register
# space by the runtime index. XAR0..XAR7 are contiguous 4-byte registers (slaspec offset 0x20),
# so `&XAR0 + ARP*4` is the selected one. Technique from mwdmwd/ghidra-c28x.
macro arp_xar_ptr(p) {
    p = &XAR0 + zext(ARP) * 4;
}

# --- program read / write -----------------------------------------------------------------
# XPREAD carries the same destination-conditioned N/Z as PREAD (SPRU430F: flags only when the
# destination is an accumulator half), hence the @AH / @AL split. The page is applied to AL
# BEFORE the destination is written, so the @AL form is not self-clobbering. Repeated forms
# (which shadow the program-side pointer while leaving AL alone) live in tms320c28x_rpt.sinc.
:XPREAD "@AH", "*AL"   is rpt_phase=1 & ctx_AMODE=0 & op16=0x563c ; loc_full8=0b10101000  { local pma:4 = 0x3f0000 | zext(AL); AH = *[ram]:2 pma; setNZ16(AH); }
:XPREAD "@AL", "*AL"   is rpt_phase=1 & ctx_AMODE=0 & op16=0x563c ; loc_full8=0b10101001  { local pma:4 = 0x3f0000 | zext(AL); AL = *[ram]:2 pma; setNZ16(AL); }
:XPREAD loc16, "*AL"   is rpt_phase=1 & op16=0x563c ; loc16  { local pma:4 = 0x3f0000 | zext(AL); loc16 = *[ram]:2 pma; }
# dis2000 renders the destination as `*AL`; this module printed `*A`.
:XPWRITE "*AL", loc16  is rpt_phase=1 & op16=0x563d ; loc16  { local pma:4 = 0x3f0000 | zext(AL); *[ram]:2 pma = loc16; }

# --- branches -----------------------------------------------------------------------------
:XB "*AL"  is rpt_phase=1 & op16=0x5614 { local tgt:4 = 0x3f0000 | zext(AL); goto [tgt]; }
# XB pma,COND   0101 0110 1101 COND : pma
# The UNC row needs its own constructor: `if (UNC) goto` compiles to a CBRANCH that keeps a dead
# fall-through edge. Same reason as the B/SB UNC forms in tms320c28x_flow.sinc.
:XB xpmadest,CC     is rpt_phase=1 & op_hi8=0x56 & loc_hi4=0b1101 & cond4 & CC ; imm16 & xpmadest { if (CC) goto xpmadest; }
:XB xpmadest,"UNC"  is rpt_phase=1 & op_hi8=0x56 & loc_hi4=0b1101 & cond4=0xf ; imm16 & xpmadest { goto xpmadest; }
# XB pma,*,ARPn   0011 1110 0111 0nnn : pma   (unconditional, with ARP reload)
:XB xpmadest,"*,ARP"^loc_arp  is rpt_phase=1 & op_hi8=0x3E & op_lo_hi5=0b01110 & loc_arp ; imm16 & xpmadest {
    ARP = loc_arp:1;
    goto xpmadest;
}

# --- calls --------------------------------------------------------------------------------
:XCALL "*AL"  is rpt_phase=1 & op16=0x5634
        [ ctx_DP_valid = 0; globalset(inst_next, ctx_DP_valid); ]
        {
    local tgt:4 = 0x3f0000 | zext(AL);
    local nxt:4 = inst_next >> 1;
    local retlo:2 = nxt(0);
    xcall_push(retlo);
    call [tgt];
}
# XCALL pma,COND   0101 0110 1110 COND : pma
:XCALL xpmadest,CC  is rpt_phase=1 & op_hi8=0x56 & loc_hi4=0b1110 & cond4 & CC ; imm16 & xpmadest
        [ ctx_DP_valid = 0; globalset(inst_next, ctx_DP_valid); ]
        {
    if (CC == 0) goto <skip>;
    local nxt:4 = inst_next >> 1;
    local retlo:2 = nxt(0);
    xcall_push(retlo);
    call xpmadest;
  <skip>
}
:XCALL xpmadest,"UNC"  is rpt_phase=1 & op_hi8=0x56 & loc_hi4=0b1110 & cond4=0xf ; imm16 & xpmadest
        [ ctx_DP_valid = 0; globalset(inst_next, ctx_DP_valid); ]
        {
    local nxt:4 = inst_next >> 1;
    local retlo:2 = nxt(0);
    xcall_push(retlo);
    call xpmadest;
}
# XCALL pma,*,ARPn   0011 1110 0110 1nnn : pma
:XCALL xpmadest,"*,ARP"^loc_arp  is rpt_phase=1 & op_hi8=0x3E & op_lo_hi5=0b01101 & loc_arp ; imm16 & xpmadest
        [ ctx_DP_valid = 0; globalset(inst_next, ctx_DP_valid); ]
        {
    ARP = loc_arp:1;
    local nxt:4 = inst_next >> 1;
    local retlo:2 = nxt(0);
    xcall_push(retlo);
    call xpmadest;
}

# --- XBANZ pma,*ind{,ARPn} ------------------------------------------------------------------
# Branch if the LOW 16 bits of XAR[ARP] are non-zero, THEN apply the indirect-mode update --
# the update lands on both paths, which is why it is emitted before the branch (same shape as
# the non-X BANZ in tms320c28x_flow.sinc).
:XBANZ xpmadest,"*"  is rpt_phase=1 & op16=0x560c ; imm16 & xpmadest {
    local rp:4;
    arp_xar_ptr(rp);
    local rv:4 = *[register]:4 rp;
    local low:2 = rv(0);
    if (low == 0) goto inst_next;
    goto xpmadest;
}
:XBANZ xpmadest,"*++"  is rpt_phase=1 & op16=0x560a ; imm16 & xpmadest {
    local rp:4;
    arp_xar_ptr(rp);
    local rv:4 = *[register]:4 rp;
    *[register]:4 rp = rv + 1;
    local low:2 = rv(0);
    if (low == 0) goto inst_next;
    goto xpmadest;
}
:XBANZ xpmadest,"*--"  is rpt_phase=1 & op16=0x560b ; imm16 & xpmadest {
    local rp:4;
    arp_xar_ptr(rp);
    local rv:4 = *[register]:4 rp;
    *[register]:4 rp = rv - 1;
    local low:2 = rv(0);
    if (low == 0) goto inst_next;
    goto xpmadest;
}
:XBANZ xpmadest,"*0++"  is rpt_phase=1 & op16=0x560e ; imm16 & xpmadest {
    local rp:4;
    arp_xar_ptr(rp);
    local rv:4 = *[register]:4 rp;
    *[register]:4 rp = rv + zext(AR0);
    local low:2 = rv(0);
    if (low == 0) goto inst_next;
    goto xpmadest;
}
:XBANZ xpmadest,"*0--"  is rpt_phase=1 & op16=0x560f ; imm16 & xpmadest {
    local rp:4;
    arp_xar_ptr(rp);
    local rv:4 = *[register]:4 rp;
    *[register]:4 rp = rv - zext(AR0);
    local low:2 = rv(0);
    if (low == 0) goto inst_next;
    goto xpmadest;
}
:XBANZ xpmadest,"*ARP"^loc_arp  is rpt_phase=1 & op_hi8=0x3E & op_lo_hi5=0b00110 & loc_arp ; imm16 & xpmadest {
    local rp:4;
    arp_xar_ptr(rp);
    local rv:4 = *[register]:4 rp;
    ARP = loc_arp:1;
    local low:2 = rv(0);
    if (low == 0) goto inst_next;
    goto xpmadest;
}
:XBANZ xpmadest,"*++,ARP"^loc_arp  is rpt_phase=1 & op_hi8=0x3E & op_lo_hi5=0b00111 & loc_arp ; imm16 & xpmadest {
    local rp:4;
    arp_xar_ptr(rp);
    local rv:4 = *[register]:4 rp;
    *[register]:4 rp = rv + 1;
    ARP = loc_arp:1;
    local low:2 = rv(0);
    if (low == 0) goto inst_next;
    goto xpmadest;
}
:XBANZ xpmadest,"*--,ARP"^loc_arp  is rpt_phase=1 & op_hi8=0x3E & op_lo_hi5=0b01000 & loc_arp ; imm16 & xpmadest {
    local rp:4;
    arp_xar_ptr(rp);
    local rv:4 = *[register]:4 rp;
    *[register]:4 rp = rv - 1;
    ARP = loc_arp:1;
    local low:2 = rv(0);
    if (low == 0) goto inst_next;
    goto xpmadest;
}
:XBANZ xpmadest,"*0++,ARP"^loc_arp  is rpt_phase=1 & op_hi8=0x3E & op_lo_hi5=0b01001 & loc_arp ; imm16 & xpmadest {
    local rp:4;
    arp_xar_ptr(rp);
    local rv:4 = *[register]:4 rp;
    *[register]:4 rp = rv + zext(AR0);
    ARP = loc_arp:1;
    local low:2 = rv(0);
    if (low == 0) goto inst_next;
    goto xpmadest;
}
:XBANZ xpmadest,"*0--,ARP"^loc_arp  is rpt_phase=1 & op_hi8=0x3E & op_lo_hi5=0b01010 & loc_arp ; imm16 & xpmadest {
    local rp:4;
    arp_xar_ptr(rp);
    local rv:4 = *[register]:4 rp;
    *[register]:4 rp = rv - zext(AR0);
    ARP = loc_arp:1;
    local low:2 = rv(0);
    if (low == 0) goto inst_next;
    goto xpmadest;
}

# --- returns --------------------------------------------------------------------------------
# XRETC COND   0101 0110 1111 COND.  XRET is an alias for the UNC row (SPRU430F), and dis2000
# renders 0x56ff as `XRETC UNC` -- so that is what this prints, where the module used to print
# `XRET` and disagree with TI on the mnemonic itself.
:XRETC CC     is rpt_phase=1 & op_hi8=0x56 & loc_hi4=0b1111 & cond4 & CC {
    if (CC == 0) goto <skip>;
    local tgt:4;
    xret_pop(tgt);
    return [tgt];
  <skip>
}
:XRETC "UNC"  is rpt_phase=1 & op_hi8=0x56 & loc_hi4=0b1111 & cond4=0xf {
    local tgt:4;
    xret_pop(tgt);
    return [tgt];
}

# =============================================================================
# 64-bit ACC:P shifts by #1..16 (single word; SHFT in low nibble). ACC = high 32,
# P = low 32. word1 = 0101 0110 10ss SHFT (ss: ASR64=00 0x568x, LSR64=01 0x569x,
# LSL64=10 0x56Ax). 0x56a3 (LSL64 #3) was the top missing opcode in the F28377D
# production firmware (~1434 sites) — the QMPYL→LSL64 32x32 Q-format multiply idiom.
# shft_cnt = SHFT+1 (range 1..16), reuse the shcount subtable.
:ASR64 "ACC:P,#"shcount  is rpt_phase=1 & op_hi8=0x56 & loc_hi4=0b1000 & shcount {
    local v:8 = (zext(ACC) << 32) | zext(P);
    v = v s>> shcount; ACC = v(4); P = v(0);
}
:LSR64 "ACC:P,#"shcount  is rpt_phase=1 & op_hi8=0x56 & loc_hi4=0b1001 & shcount {
    local v:8 = (zext(ACC) << 32) | zext(P);
    v = v >> shcount; ACC = v(4); P = v(0);
}
:LSL64 "ACC:P,#"shcount  is rpt_phase=1 & op_hi8=0x56 & loc_hi4=0b1010 & shcount {
    local v:8 = (zext(ACC) << 32) | zext(P);
    v = v << shcount; ACC = v(4); P = v(0);
}

# --- 0x56-prefix 64/long shifts (single-word, fixed sub-opcode) --------------
# SPRU430F: N/Z from ACC after; C=0 if T[4:0]==0, else last bit shifted out of ACC.
:LSLL "ACC,T"   is rpt_phase=1 & op16=0x563b {
    local s:4 = zext(T) & 0x1f;
    $(C) = 0;
    if (s == 0) goto <done>;
    $(C) = ((ACC >> (32 - s)) & 1) != 0;
    <done>
    ACC = ACC << s;
    setNZ32(ACC);
}
:LSRL "ACC,T"   is rpt_phase=1 & op16=0x5622 {
    local s:4 = zext(T) & 0x1f;
    $(C) = 0;
    if (s == 0) goto <done>;
    $(C) = ((ACC >> (s - 1)) & 1) != 0;
    <done>
    ACC = ACC >> s;
    setNZ32(ACC);
}
:ASRL "ACC,T"   is rpt_phase=1 & op16=0x5610 {
    local s:4 = zext(T) & 0x1f;
    $(C) = 0;
    if (s == 0) goto <done>;
    $(C) = ((ACC >> (s - 1)) & 1) != 0;
    <done>
    ACC = ACC s>> s;
    setNZ32(ACC);
}

# =============================================================================
# Batch 15 (2026-06-23): 0x56-family gaps from the prologue-seeded truncation
# sweep. word1 = 0x56<sub>; loc16/loc32 (when present) is in word2's low byte.
# =============================================================================
# MIN AX,loc16  0101 0110 0111 010A : 0000 0000 LLLL LLLL  (load smaller of AX,[loc16]).
# MAX AX,loc16  0101 0110 0111 001A : 0000 0000 LLLL LLLL  (load larger). A=bit0 (AL/AH),
# so match the high 15 bits (op_hi8 + op_lo71) and let AXb0 pick the register.
# NOTE: MAX is 0111 001A (op_lo71=0b0111001), NOT 000A — the manual's opcode wraps two
# lines (0101 0110 0111 / 001A 0000...) and reads as one 16-bit LSW. dis2000-confirmed
# (0x5673 = MAX AH); the earlier 0b0111000 was wrong and left 0x5672/0x5673 undecoded.
:MIN AXb0, loc16  is rpt_phase=1 & op_hi8=0x56 & op_lo71=0b0111010 & AXb0 ; loc16  {
    if (AXb0 s<= loc16) goto inst_next;
    AXb0 = loc16;
}
:MAX AXb0, loc16  is rpt_phase=1 & op_hi8=0x56 & op_lo71=0b0111001 & AXb0 ; loc16  {
    if (AXb0 s>= loc16) goto inst_next;
    AXb0 = loc16;
}
# FLIP AX  0101 0110 0111 000A  (bit-reverse AL/AH). dis2000-confirmed (0x5670/0x5671 —
# previously MIS-DECODED as the 2-word MAX, which consumed an extra word and skewed flow).
# 16-bit bit-reversal as a branch-free swap network — pure SLEIGH, so it works in both the
# decompiler and the emulator (no callother needed). 1-word.
:FLIP AXb0  is rpt_phase=1 & op_hi8=0x56 & op_lo71=0b0111000 & AXb0  {
    local x:2 = AXb0;
    x = ((x & 0x5555) << 1) | ((x >> 1) & 0x5555);
    x = ((x & 0x3333) << 2) | ((x >> 2) & 0x3333);
    x = ((x & 0x0f0f) << 4) | ((x >> 4) & 0x0f0f);
    x = (x << 8) | (x >> 8);
    AXb0 = x;
}
# CSB ACC  0101 0110 0011 0101  (count sign bits: T = leading-sign-bit count - 1). 1-word.
# Pure SLEIGH via `lzcount`: for ACC >= 0 the leading zeros ARE the redundant sign bits;
# for ACC < 0 the leading ones are, so `lzcount(~ACC)` gives that count. Subtract one to
# match the hardware definition (SPRU430F 6.5.14): CSB reports "sign-bit count minus one",
# so 0x00000000 and 0xFFFFFFFF both yield T = 31. Retires countSignBits CALLOTHER.
# Ported from mwdmwd/ghidra-c28x (Apache-2.0, tms320c28.sinc); see THIRD-PARTY.md.
# Flags per SPRU430F: N/Z from ACC (unchanged); TC = sign bit after the op (= ACC < 0).
:CSB "ACC"  is rpt_phase=1 & op16=0x5635  {
    local acc:4 = ACC;
    local count:2;
    if (acc s< 0) goto <neg>;
    count = lzcount(acc);
    goto <done>;
  <neg>
    count = lzcount(~acc);
  <done>
    T = count - 1;
    $(N) = (acc s< 0);
    $(Z) = (acc == 0);
    $(TC) = $(N);
}
# ABSTC ACC  0101 0110 0101 1111  (ACC = |ACC|; TC ^= sign bit). dis2000-confirmed (DIR).
:ABSTC "ACC"  is rpt_phase=1 & op16=0x565f  {
    local neg:1 = (ACC s< 0);
    $(TC) = $(TC) ^ neg;
    if (ACC s>= 0) goto inst_next;
    ACC = -ACC;
}
# NEGTC ACC  0101 0110 0011 0010  (if TC==1, negate ACC). Pairs with ABSTC in the
# sign-magnitude idiom. dis2000-confirmed (DIR image).
:NEGTC "ACC"  is rpt_phase=1 & op16=0x5632  {
    if ($(TC) == 0) goto inst_next;
    ACC = -ACC;
    setNZ32(ACC);
}
# ASR64 ACC:P,T  0101 0110 0010 1100  (64-bit ARITHMETIC shift right by T(5:0)).
:ASR64 "ACC:P,T"  is rpt_phase=1 & op16=0x562c  {
    local s:8 = zext(T) & 0x3f;
    local v:8 = (zext(ACC) << 32) | zext(P);
    v = v s>> s; ACC = v(4); P = v(0);
}
# CMP64 ACC:P  0101 0110 0101 1110  (compare 64-bit ACC:P vs 0; set N/Z, Z from both).
:CMP64 "ACC:P"  is rpt_phase=1 & op16=0x565e  {
    local v:8 = (zext(ACC) << 32) | zext(P);
    $(N) = (v s< 0); $(Z) = (v == 0);
}
# NEG64 ACC:P  0101 0110 0101 1000  (negate the 64-bit ACC:P pair). dis2000-confirmed;
# reached only via a branch shadow (after SB ...,GEQ), so the fall-through sweep missed it.
:NEG64 "ACC:P"  is rpt_phase=1 & op16=0x5658  {
    local v:8 = (zext(ACC) << 32) | zext(P);
    v = -v; ACC = v(4); P = v(0);
    $(N) = (v s< 0); $(Z) = (v == 0);
}
# LSR64 ACC:P,T  0101 0110 0101 1011  (64-bit logical shift right by T(5:0)).
:LSR64 "ACC:P,T"  is rpt_phase=1 & op16=0x565b  {
    local s:8 = zext(T) & 0x3f;
    local v:8 = (zext(ACC) << 32) | zext(P);
    v = v >> s; ACC = v(4); P = v(0);
}
# LSL64 ACC:P,T  0101 0110 0101 0010  (64-bit logical shift left by T(5:0)).
:LSL64 "ACC:P,T"  is rpt_phase=1 & op16=0x5652  {
    local s:8 = zext(T) & 0x3f;
    local v:8 = (zext(ACC) << 32) | zext(P);
    v = v << s; ACC = v(4); P = v(0);
}
# SUBCUL ACC,loc32  0101 0110 0001 0111 : loc32  (conditional 32-bit subtract step;
# divide primitive). Modeled as the plain subtract (the conditional-restore detail
# and the P register updates per SPRU430F aren't tracked); keeps dataflow + flow going.
# Flags follow the simplified body: N,Z from ACC after, C inverted-borrow like SUB.
# Full pseudo-code (temp = ACC<<1 + P[31] - [loc32]; ACC:P shift dance) is issue-tracked.
:SUBCUL ACCreg, loc32  is rpt_phase=1 & op16=0x5617 ; loc32 & ACCreg  {
    local b:4 = loc32;
    $(C) = !(ACC < b);
    ACC = ACC - b;
    setNZ32(ACC);
}
# MOVX TL,loc16  0101 0110 0010 0001 : 0000 0000 LLLL LLLL  (sign-extend [loc16] into
# the low half of XT; high half = sign). XT low 16 = loc16, T (high) = sign-extend.
:MOVX "TL", loc16  is rpt_phase=1 & op16=0x5621 ; loc16  { XT = sext(loc16); }
# MOV loc16,AX,COND  0101 0110 0010 101A : 0000 COND LLLL LLLL  (store AX if COND).
# COND in word2 bits 8-11; modeled flow-preserving (store AX unconditionally so the
# def survives — the exact predicate isn't decoded here).
:MOV loc16, AXb0, "COND"  is rpt_phase=1 & op_hi8=0x56 & op_lo71=0b0010101 & AXb0 ; loc16  { loc16 = AXb0; }
# MOV loc16,ACC<<#2..8  0101 0110 0010 1101 : 0000 0SHF LLLL LLLL  (save low word of
# ACC<<SHF). SHF in word2 bits 8-10; store the low word of the shifted ACC.
:MOV loc16, "ACC<<#2..8"  is rpt_phase=1 & op16=0x562d ; loc16 & shft_hi4  {
    local v:4 = ACC << zext(shft_hi4:1); loc16 = v:2;
}
# MOVH loc16,ACC<<#2..8  0101 0110 0010 1111 : 0000 0SHF LLLL LLLL  (save high word).
:MOVH loc16, "ACC<<#2..8"  is rpt_phase=1 & op16=0x562f ; loc16 & shft_hi4  {
    local v:4 = ACC << zext(shft_hi4:1); loc16 = v(2);
}
