#
# Portions adapted from mwdmwd/ghidra-c28x (Apache-2.0): the SXM-governed extension
# macros mext_value / mext / mov_acc_mext_shift below. See THIRD-PARTY.md.
#
# TMS320C28x instruction constructors.
# Included by tms320c28x.slaspec.
#
# SKELETON STAGE: only a handful of fixed-opcode instructions are defined here,
# enough to prove the toolchain compiles and disassembles. The shared loc16/loc32
# addressing sub-tables and the bulk of the ISA follow in later stages.
#
# Encodings verified against SPRU430F (docs/c28x/ch6_instruction_detail.txt).
# Instructions are fetched as 16-bit words, low byte first (little-endian).

# --- 16-bit instruction word token --------------------------------------------
# All sub-fields of the opcode word live here, including the loc-field decode bits
# (loc_* ), which overlay the low byte. Defining them on ONE token keeps byte
# consumption correct (the loc field shares the instruction word, not extra bytes).
define token instr16 (16)
    op16    = (0,15)        # whole 16-bit opcode
    op_hi8  = (8,15)        # high byte (opcode group)
    op_hi7  = (9,15)        # top 7 bits (group when bit 8 is an operand 'A' bit)
    op_hi5  = (11,15)       # top 5 bits (group when bits 8..10 are an AR selector)
    op_lo8  = (0,7)         # low byte (often the loc16 field)
    # loc-field sub-fields (low byte, bits 0..7):
    loc_b7    = (7,7)
    loc_b76   = (6,7)
    loc_mode5 = (3,7)       # mode selector for the 1 0 xxx group
    loc_areg  = (0,2)       # XARn selector (AAA) -> attached to XAR0..XAR7
    loc_areg16= (0,2)       # same bits, attached to AR0..AR7 (16-bit @ARn mode)
    loc_arp   = (0,2)       # ARP number 0..7 for *,ARPn (NOT attached to a register -- it names
                            # one, it does not select an operand). Rendered decimal via
                            # `attach names` in tms320c28x_addr.sinc: it is a register NUMBER, and
                            # the default scalar formatting printed TI's "*,ARP4" as "*,ARP0x4".
                            # The `dec` field attribute does NOT fix this -- Ghidra formats the
                            # scalar operand itself.
    loc_off6  = (0,5)       # 6-bit offset (@6bit, *-SP[6bit])
    loc_imm3  = (3,5)       # 3-bit index III in *+XARn[3bit] (1 1 III AAA) — NOT bits
                            # 0-2 (those are the XARn selector AAA); was a real bug:
                            # the index always mis-printed as the register number.
    loc_full8 = (0,7)       # whole loc field (fixed encodings)
    # operand sub-fields that share the opcode word:
    ax_bit    = (8,8)       # 0 = AL, 1 = AH  (the 'A' bit in 1001 xxxA ....)
    arsel3    = (8,10)      # 3-bit AR selector (the 'nnn' in 0111 1nnn ....) -> AR view
    arsel3x   = (8,10)      # same 3 bits attached to XARn (32-bit) for MOVZ zero-extend
    imm8      = (0,7)       # 8-bit immediate (CCCC CCCC, low byte)
    movst0_flags = (0,7)    # MOVST0's FLAG select mask. Its own field (not imm8) so that
                            # `attach names` can render TI's flag list -- imm8 is shared by
                            # dozens of unrelated instructions and must stay a plain number.
    simm8     = (0,7) signed # 8-bit signed offset (SB)
    cond4     = (0,3)       # 4-bit condition code (COND), low nibble (B/BF)
    cond4hi   = (8,11)      # COND in bits 8..11 (SB: 0110 COND CCCC CCCC)
    sb_grp    = (12,15)     # top nibble = 0110 for SB
    banz_n    = (0,2)       # ARn selector for BANZ (0000 0000 0000 1nnn)
    op_lo_hi5 = (3,7)       # bits 3..7 of low byte (BANZ: 00001 nnn -> this=00001)
    op_lo_76  = (6,7)       # bits 6..7 of the low byte (LCR #22bit group selector)
    op_lo_35  = (3,7)       # bits 3..7 of the low byte (LCR *XARn selector)
    op_lo_hi4 = (4,7)       # bits 4..7 of the low byte (B: 1110 COND -> this=1110)
    op_hi_4   = (12,15)     # top nibble (TBIT: 0100 BBBB ....)
    tbit_b    = (8,11)      # 4-bit bit index (TBIT)
    op_hi_6   = (10,15)     # top 6 bits (MOVZ DP: 1011 10CC ....)
    dp10      = (0,9)       # 10-bit DP immediate (MOVZ DP,#10bit)
    fimm_hi   = (4,7)       # MOVIZ/MOVXI: bits 7..4 (=0000)
    fimm_z    = (3,3)       # MOVIZ(0)/MOVXI(1) selector bit
    fimm_reg  = (0,2)       # FP register III for MOVIZ/MOVXI -> attached to R0H..R7H
    fimm_lo6  = (0,5)       # #16FHi immediate low 6 bits (LSW: 1110 1000 ssII IIII) ADD/SUB/MPY
    fimm_lo3  = (0,2)       # #16FHi immediate low 3 bits (LSW: 1110 1000 mmmm 0III) CMP/MAX/MIN
    op_lo7    = (0,6)       # low 7 bits (sub-opcode where bit0 is NOT an operand)
    op_lo71   = (1,7)       # bits 1..7 (ASR/LSR/LSL AX,T: 1111 1111 0110 0ssA, A=bit0)
    ax_bit0   = (0,0)       # AX selector in bit 0 (the 'A' in ...0110 0ssA)
    sp7       = (0,6)       # 7-bit SP immediate (ADDB SP,#7bit)
    xarn_hi3  = (8,10)      # XARn selector nnn (SUBB XARn,#: 1101 1nnn 1CCC CCCC)
    fcndf     = (0,3)       # FPU CNDF condition (MOV32 RaH,RbH,CNDF etc.)
    loc_hi4   = (4,7)       # high nibble of the low byte (MOV32 RaH,RbH: ...1100 CNDF)
    shft4     = (0,3)       # 4-bit shift count SHFT (AX,#1..16: SHFT, 0->16)
    ax_bit4   = (4,4)       # AX selector in bit 4 (the 'A' in 1111 1111 ssAS SHFT)
    op_lo765  = (5,7)       # bits 5..7 of low byte (AX,#imm shift selector sss)
    p_rf      = (1,3)       # fff  RfH for parallel MPYF32||MOV32 (LSW: 0000 fffe)
    p_ff2     = (0,1)       # ff   HIGH 2 bits of RfH for MPYF32||ADDF32 (LSW: 0100 00ff)
    shft_hi4  = (8,11)      # SHFT in word2 of MOV ACC,loc16<<#1..15 (0000 SHFT LLLLLLLL)
    imm8_hi   = (8,15)      # high byte of word2 (MOVB loc16,#8bit,COND: CCCC CCCC LLLLLLLL)
    xar7_mode = (8,15)      # DMAC / QMACL / IMACL word-2 pointer selector:
                            # 0xC7 = *XAR7, 0x87 = *XAR7++  (SPRU430F ch.6). The low
                            # byte of that same word is the standard loc32 field.
    p_re_hi   = (0,0)       # e    high bit of ReH for that parallel form
    rptb_sel  = (7,7)       # RPTB form select (LSW 1011 0101 Rbbb bbbb): 0=loc16, 1=#RC
    rptb_rsz  = (0,6)       # RPTB block size RSIZE (low 7 bits of the LSW)
    norm_pm   = (3,3)       # NORM ACC,XARn: bit3 selects ++ (1) vs -- (0)
    setflg_m6 = (0,5)       # SETFLG/SAVE FLAG mask, low 6 bits (LSW 1110 0110 0nFF FFFF)
    setflg_f5 = (11,15)     # SETFLG/SAVE FLAG mask, high 5 bits (MSW FFFF FVVV VVVV VVVV)
    setflg_v11 = (0,10)     # SETFLG/SAVE VALUE, all 11 bits (MSW low 11)
    lo_b76    = (6,7)        # top 2 bits of the low byte (SETFLG selector: 00)
    trap5     = (0,4)       # TRAP #VectorNumber: CPU interrupt vector 0..31 (0000 0000 001C CCCC)

    # --- FPU second-word (MSW) fields ----------------------------------------
    # These describe the SECOND word of a 32-bit FPU instruction, not the opcode
    # word, and they live here rather than on an FPU-private token on purpose:
    # SLEIGH will not combine fields from two different tokens at the same word
    # ("Mismatched tokens when combining patterns"), even when both tokens are
    # 16 bits. Every FPU `mem32` form has an MSW of `.... .aaa <loc byte>` -- a
    # register selector alongside a standard C28x addressing-mode byte -- so the
    # register field and the shared `loc16`/`loc32` sub-tables must come from one
    # token or the mem32 operand cannot be decoded at all. A field is just a bit
    # range on a 16-bit word; which word it lands on is decided by where it sits
    # relative to the `;` in a constructor's pattern, so nothing is lost by
    # sharing the token, and the overlap with the loc_* / op_* ranges above is
    # the same kind of aliasing loc_areg / loc_areg16 / fimm_reg already use.
    f_ra   = (0,2)          # aaa  destination RaH
    f_rb   = (3,5)          # bbb  source RbH
    f_rc   = (6,8)          # ccc  source RcH
    f_msw_hi  = (9,15)
    f_msw_mid = (9,14)      # MSW bits 9-14 (the reg-form's must-be-zero middle bits)
    f_msw_rnd = (15,15)     # MSW bit 15 = round-to-nearest variant selector (F32TO*16R)
    fimm_hi10 = (6,15)      # #16FHi immediate high 10 bits (MSW: IIII IIII IIbb baaa) ADD/SUB/MPY
    fimm_hi13 = (3,15)      # #16FHi immediate high 13 bits (MSW: IIII IIII IIII Iaaa) CMP/MAX/MIN
    # parallel "op || MOV32 mem" MSW layout: eedd daaa mem32
    p_rd    = (11,13)       # ddd  MPYF32 dest RdH
    p_ra    = (8,10)        # aaa  MOV32 dest RaH
    p_re_lo = (14,15)       # ee   low 2 bits of ReH (high bit is p_re_hi in the LSW)
    # "MPYF32 RaH,RbH,RcH || ADDF32/SUBF32 RdH,ReH,RfH" (0xE74x/0xE75x) and
    # "MAXF32/MINF32 RaH,RbH || MOV32 RcH,RdH" (0xE69C/D) use a DIFFERENT MSW layout --
    # feee dddc ccbb baaa / 0000 dddc ccbb baaa -- so ddd and eee sit one bit lower than
    # p_rd/p_re_lo above. aaa/bbb/ccc are the ordinary f_ra/f_rb/f_rc.
    p_rd9   = (9,11)        # ddd  in the `dddc ccbb baaa` layout
    p_re12  = (12,14)       # eee  in the `feee dddc ccbb baaa` layout
    p_rf_lo1 = (15,15)      # f    LOW bit of RfH for 0xE74x/0xE75x (high 2 bits are p_ff2)
    # NB: the FPU `mem32` / `mem16` operand is the LOW 8 bits of the MSW and is a standard
    # C28x loc byte, so it needs no fields of its own -- the shared loc16 / loc32 sub-tables
    # decode it directly when placed after the `;` in a constructor's pattern.
    # 0xBD/0xBF register-form MOV32 MSW = 0x0F<reg> : the FP reg index sits in MSW bits[2:5]
    # (dis2000-confirmed: R0H..R7H => MSW byte 0x12,16,1A,1E,22,26,2A,2E = field value 4..11).
    f_movf_reg = (2,5)
    # 0xBD/0xBF are DUAL-form (asm2000/dis2000 verified): the MSW disambiguates the FPU
    # register move (MOV32 loc32,RaH) from the VCU-II absolute-memory move
    # (VMOV32 loc32,*(0:16bitAddr)).  The register form is EXACTLY MSW high byte 0x0F with
    # bits[7:6]=0 and the reg index 4..11 (0x0F12..0x0F2E); every other MSW is a 16-bit data
    # address.  These sub-fields pin the register-form selector so the absolute-memory form
    # can be the catch-all (a real address MSW like 0x7F08 used to fall on an undefined
    # f_movf_reg slot and decode to <UNDEF>).
    f_msw_b8_15 = (8,15)    # MSW high byte -- 0x0F => register form, else absolute-memory form
    f_msw_b76   = (6,7)     # MSW bits 7:6  -- 0 in the register form (nonzero => memory form)
;

# --- trailing 16-bit immediate / extension word -------------------------------
define token imm16w (16)
    imm16   = (0,15)
    simm16  = (0,15) signed
;

# --- helper macros: set NZ for a 16-bit / 32-bit result ----------------------
# Defined here (before all instruction includes) so every .sinc can use them — mov.sinc
# is included before alu.sinc, so these can't live in alu.sinc.
macro setNZ16(r) {
    $(N) = (r s< 0);
    $(Z) = (r == 0);
}
macro setNZ32(r) {
    $(N) = (r s< 0);
    $(Z) = (r == 0);
}

# --- SXM-governed 16->32 extension (SPRU430F) --------------------------------
# The MOV/ADD/SUB ACC,{loc16|#imm16}<<shift family extends its 16-bit operand
# according to ST0.SXM: sign-extend when SXM=1, zero-extend when SXM=0. These
# constructors used to hardcode one or the other -- most sext'd with the comment
# "per SXM=1 (common case)", while the #imm16 forms zext'd -- so each was wrong
# in whichever mode it did not assume. Measured on two production images, the
# SXM=0 case is not the rare one: of the sign-extending instructions reached with
# a known SXM state, 1180 of 2255 in a DIR image and 359 of 587 in a PMR image run
# under CLRC SXM. Adapted from mwdmwd/ghidra-c28x (Apache-2.0); see THIRD-PARTY.md.
#
# Written as (zext | sext & mask) rather than a branch: sign extension only ever
# contributes UPPER bits, so the two forms share their low 16 bits exactly, and
# this shape lets the decompiler fold the whole thing away wherever SXM is known.
macro mext_value(out, source) {
    local sxm_mask:4 = 0 - zext($(SXM));
    local zval:4 = zext(source);
    local sval:4 = sext(source);
    out = zval | (sval & sxm_mask);
}

# Snapshot the operand FIRST, so an architectural operand is evaluated exactly
# once -- loc16 can be a post-increment addressing mode, and reading it twice
# would step the pointer twice.
macro mext(out, in) {
    local source:2 = in;
    mext_value(out, source);
}

# MOV ACC,loc16<<shift has an SXM-dependent upper half but an EXACT, SXM-
# independent low half. Commit the full architectural result, then restate that
# low half so ordinary 16-bit consumers see the invariant directly instead of
# carrying the SXM term through every downstream expression.
# --- the PM product shift (SPRU430F 6.x, ST0.PM) ------------------------------
# P as the product-shift mode leaves it. PM is stored DECODED here (-6..+1, see
# packst0), so a positive mode shifts left and a negative one shifts arithmetically
# right. Only reached under the analyzer-proven pm_shift=1 variants; PM=0 sites keep
# the plain unshifted P, which is both the common case and the cheaper p-code.
#
# Branchless so one instruction stays one basic block. Whichever side is not
# selected shifts by a nonsense count -- SLEIGH gives 0 or a sign fill for a count
# at or past the width -- and is masked off, so only the selected side survives.
# The shift count is the PM register rather than a constant, which lets the
# decompiler fold it wherever the governing SPM is visible.
macro pshift(out) {
    local pm:4 = sext($(PM));
    local neg:4 = 0 - zext(pm s< 0);
    local left:4 = P << pm;
    local right:4 = P s>> (0 - pm);
    out = (right & neg) | (left & ~neg);
}

# SPRU430F p.255 / p.253 (MOV ACC,loc16<<#0..16 and MOV ACC,#16bit<<#0..15): after the
# shift-and-load, N reflects bit 31 of ACC and Z reflects ACC==0. All four callers used
# to leave N/Z untouched -- issue #110. The switch_canonical variant in
# tms320c28x_ext56.sinc already sets N/Z inline, so it is unaffected.
macro mov_acc_mext_shift(in, shift) {
    local source:2 = in;
    local full:4;
    mext_value(full, source);
    ACC = full << shift;
    AL = source << shift;
    setNZ32(ACC);
}

# --- OVC / OVCU accounting (SPRU430F 2.3, Table 2-5) --------------------------
# OVC is the 6-bit signed overflow counter at ST0[15:10]. OVCU is not a separate
# register -- it is the SAME counter named differently for unsigned ops. Range
# -32..+31 (wraps at boundaries); reset value is 0. OVM=1 suppresses updates
# entirely (the OVM path saturates ACC instead, which is a separate hole).
#
# Called AFTER V (signed) or C (unsigned) has been set on the current
# instruction. `res` is the ACC value AFTER the op -- the sign of the wrapped
# result tells the OVERFLOW DIRECTION: negative result = wrapped from +MAX
# (positive overflow, OVC += 1); non-negative result = wrapped from -MIN
# (negative overflow, OVC -= 1). Branchless so the decompiler can constant-fold
# when OVM and V are visible.
macro applyOvcSigned(res) {
    local apply:1 = $(V) & (~$(OVM));           # 1 iff we should update OVC
    local pos_ovf:1 = (res s< 0);                # 1 iff +ve overflow direction
    local delta:1 = (pos_ovf << 1) - 1:1;        # +1 (pos) or -1 (neg), signed 1B
    local apply_mask:1 = 0:1 - apply;            # 0xff or 0
    OVC = OVC + (delta & apply_mask);
}

# Unsigned add variant: OVC += 1 on unsigned carry (C=1). Used by ADDUL /
# ADDUL P / IMPYAL / IMACL per Table 2-5. NOTE: unlike signed OVC, SPRU430F
# is explicit that "The OVM mode does not affect the OVCU counter" (see the
# OVCU row in ADDUL/IMPYAL "Flags and Modes" tables), so this macro does
# NOT gate on $(OVM). The earlier version did -- caught while auditing the
# IMPY*L/QMPY*L multiply family for #97.
macro applyOvcUnsigned() {
    OVC = OVC + $(C);                            # +1 or +0
}

# Unsigned subtract variant: OVC -= 1 on unsigned BORROW. The C flag on
# subtracts follows TI's inverted convention (set on NO borrow, cleared on
# borrow), so borrow-in is `$(C) == 0`. Used by SUBUL ACC and SUBUL P per
# their individual "Flags and Modes" tables in SPRU430F ch. 6, which are
# explicit about OVCU decrementing on unsigned borrow -- resolving the
# ambiguity Table 2-5 introduces by grouping SUBUL under "Signed
# Subtraction" (see #98). OVM does NOT gate OVCU, same as applyOvcUnsigned.
macro applyOvcuBorrow() {
    OVC = OVC - zext($(C) == 0);                 # -1 on borrow, 0 otherwise
}

# --- OVM-driven saturation for NEG/ABS overflow (SPRU430F) --------------------
# NEG/ABS/NEG64 on the signed-minimum input wraps to itself under two's-complement
# arithmetic -- which IS the OVM=0 result SPRU430F specifies. Under OVM=1 the
# result must instead saturate to signed max. Callers must have already set
# $(V) = 1 on the overflow case; these macros read V and OVM to decide whether
# to overwrite the naturally-wrapped result. Branchless masking so the decompiler
# constant-folds where OVM/V are visible.
macro applyOvmSaturate32(acc) {
    local should_sat:1 = $(V) & $(OVM);
    local sat_mask:4 = 0 - zext(should_sat);
    acc = (0x7FFFFFFF & sat_mask) | (acc & ~sat_mask);
}
macro applyOvmSaturate64AccP() {
    local should_sat:1 = $(V) & $(OVM);
    local sat_mask:4 = 0 - zext(should_sat);
    ACC = (0x7FFFFFFF & sat_mask) | (ACC & ~sat_mask);
    P   = (0xFFFFFFFF & sat_mask) | (P   & ~sat_mask);
}

# --- shared loc16 / loc32 addressing sub-tables (Table 5-1) --------------------
# The loc field is the low byte of the opcode word; the locfield token in the
# addr include overlays op_lo8's bits. Included before the instructions that use it.
@include "tms320c28x_addr.sinc"

# =============================================================================
# Fixed-opcode, no-operand instructions (verified single-word encodings).
# =============================================================================

:ABORTI         is rpt_phase=1 & op16=0x0001  { }                 # Abort interrupt (skeleton: no semantics yet)

# =============================================================================
# Traps
# =============================================================================
# ITRAP0 / ITRAP1 are the two words the C28x decodes as ILLEGAL instructions: each
# raises the illegal-instruction trap and vectors through ILLEGAL (interrupt vector
# 19), so neither reaches the following word. They are not in SPRU430F's instruction
# tables -- they are what the hardware does with an unallocated opcode -- but TI's own
# tools name them, which is what makes them worth decoding: asm2000 assembles both
# mnemonics and dis2000 prints them (verified round-trip: ITRAP0 -> 0x0000,
# ITRAP1 -> 0xffff).
#
# Worth decoding because these are the two fill patterns: 0x0000 zero-fill and 0xffff
# erased flash. Leaving them undecodable put a <UNDEF> wherever a listing ran into
# padding -- all 7 of the remaining firmware-parity mismatches over a 16K-word DIR
# range were exactly this, and the full image dis2000 dump has 1019 ITRAP0 + 274
# ITRAP1.
#
# TERMINAL ON PURPOSE. The trap vectors away and never falls through, so `goto` to
# the pcodeop's own address ends the flow. That is also what keeps padding from being
# swallowed as code: disassembly stops at the first fill word exactly as it did when
# the word would not decode at all, instead of running the length of the fill.
define pcodeop illegalInstructionTrap;   # ITRAP0/ITRAP1 -> ILLEGAL vector (19)
define pcodeop softwareTrap;             # TRAP #n       -> CPU interrupt vector n

:ITRAP0         is rpt_phase=1 & op16=0x0000  { illegalInstructionTrap(); goto inst_start; }
:ITRAP1         is rpt_phase=1 & op16=0xFFFF  { illegalInstructionTrap(); goto inst_start; }

# TRAP #VectorNumber   0000 0000 001C CCCC   (SPRU430F p.440)
# Transfers control to the ISR for CPU vector 0..31. Unlike the illegal traps this is a
# deliberate call: the handler returns with IRET to the following instruction, so this
# form DOES fall through. It ignores INTM/IER/DBGIER and leaves IFR/IER untouched.
:TRAP "#"trap5  is rpt_phase=1 & op_hi8=0x00 & op_lo765=0b001 & trap5  { softwareTrap(trap5:1); }

:EALLOW         is rpt_phase=1 & op16=0x7622  { $(EALLOWF) = 1; } # Enable write access to protected space
:EDIS           is rpt_phase=1 & op16=0x761A  { $(EALLOWF) = 0; } # Disable write access to protected space
:IDLE           is rpt_phase=1 & op16=0x7621  { }                 # Put processor in idle mode
:ESTOP0         is rpt_phase=1 & op16=0x7625  { }                 # Emulation stop 0
# Stack-pointer align/unalign (common in prologues/epilogues). ASP: if SP odd, SP++ and
# set SPA; NASP: if SPA, SP-- and clear SPA. SPA = ST1[4]. (0x761b / 0x7617.)
:ASP            is rpt_phase=1 & op16=0x761B  { if ((SP & 1) == 0) goto <even>; SP = SP + 1; $(SPA) = 1; goto inst_next; <even> $(SPA) = 0; }
:NASP           is rpt_phase=1 & op16=0x7617  { if ($(SPA) == 0) goto inst_next; SP = SP - 1; $(SPA) = 0; }
:ESTOP1         is rpt_phase=1 & op16=0x7624  { }                 # Emulation stop 1 (halts only when emulator connected)

# IER/IFR immediate forms (2-word: opcode word + imm16).  SPRU430F encodings:
# OR  IER,#16bit  0111 0110 0010 0011 = 0x7623
# OR  IFR,#16bit  0111 0110 0010 0111 = 0x7627
# AND IER,#16bit  0111 0110 0010 0110 = 0x7626
# AND IFR,#16bit  0111 0110 0010 1111 = 0x762F
:OR  "IER", "#"imm16  is rpt_phase=1 & op16=0x7623 ; imm16  { IER = IER | imm16:2; }
:OR  "IFR", "#"imm16  is rpt_phase=1 & op16=0x7627 ; imm16  { IFR = IFR | imm16:2; }
:AND "IER", "#"imm16  is rpt_phase=1 & op16=0x7626 ; imm16  { IER = IER & imm16:2; }
:AND "IFR", "#"imm16  is rpt_phase=1 & op16=0x762F ; imm16  { IFR = IFR & imm16:2; }

# NOP {*ind}: 0111 0111 LLLL LLLL. The loc field optionally performs an indirect
# address modify (e.g. NOP *XAR0++). Plain NOP is the loc=0 case. One constructor
# covers both: loc=0 renders "@0" (still mnemonic NOP); modify forms show the loc.
:NOP            is rpt_phase=1 & op_hi8=0x77 & op_lo8=0x00  { }              # plain No-operation
:NOP loc16      is rpt_phase=1 & op_hi8=0x77 & op_lo8!=0x00 & loc16  { }     # NOP with indirect modify

# =============================================================================
# Register-display operands.  A bare register name cannot sit in an instruction's
# operand position (SLEIGH treats it as an undefined operand). The idiom (cf. 8051
# `Areg`) is a zero-width subtable that prints the register name and exports the
# register varnode, matched with `epsilon` (no pattern bits). Reused everywhere.
# =============================================================================
ACCreg: "ACC" is epsilon { export ACC; }
IERreg: "IER" is epsilon { export IER; }
Preg:   "P"   is epsilon { export P;   }
XTreg:  "XT"  is epsilon { export XT;  }
Treg:   "T"   is epsilon { export T;   }
PHreg:  "PH"  is epsilon { export PH;  }
PLreg:  "PL"  is epsilon { export PL;  }

# AX register select: the 'A' bit (ax_bit) picks AL (0) or AH (1).
AX: "AL"  is ax_bit=0 { export AL; }
AX: "AH"  is ax_bit=1 { export AH; }

# AX select where the 'A' bit lives in bit 0 of the word (e.g. ASR/LSR/LSL AX,T).
AXb0: "AL"  is ax_bit0=0 { export AL; }
AXb0: "AH"  is ax_bit0=1 { export AH; }

# AX select where the 'A' bit lives in bit 4 (e.g. ASR/LSR/LSL AX,#1..16).
AXb4: "AL"  is ax_bit4=0 { export AL; }
AXb4: "AH"  is ax_bit4=1 { export AH; }

# SHFT count for AX,#1..16.  The field encodes shift-1 (so SHFT=0 -> shift of 16);
# disasm action computes the displayed/used count.
shcount: cnt  is shft4  [ cnt = shft4 + 1; ]  { export *[const]:1 cnt; }

# =============================================================================
# Instruction families (encodings verified against ch6_instruction_detail.txt).
# =============================================================================
@include "tms320c28x_mov.sinc"
@include "tms320c28x_flow.sinc"
@include "tms320c28x_alu.sinc"
@include "tms320c28x_mac.sinc"
@include "tms320c28x_fpu.sinc"
@include "tms320c28x_vcu.sinc"
@include "tms320c28x_more.sinc"
@include "tms320c28x_ext56.sinc"
# The RPT/RPTB `:^instruction` prefix wrappers must be included AFTER every other
# instruction family — SLEIGH resolves the `instruction` root table only once the
# full grammar is in scope, and the wrappers reference it. Practically the include
# order doesn't matter for resolution, but keeping it last documents intent.
@include "tms320c28x_rpt.sinc"
