# The compiled data/languages/tms320c28x.sla is a BUILD ARTIFACT and is not tracked.
# CI (.github/workflows/build.yml) compiles it on every push/PR and publishes it as a
# release artifact alongside the packaged extension zip. To build locally, run:
#     "$GHIDRA_INSTALL_DIR/support/sleigh" data/languages/tms320c28x.slaspec
data/languages/*.sla

# Per-worktree local machine config (Ghidra / TI CGT / JDK paths) loaded by
# tests/_env.{sh,ps1}. Never committed -- it is per-checkout, per-machine. The
# committed template is .c28x.env.example; see docs/WORKTREES.md.
.c28x.env

# Ghidra extension build output
build/
dist/
.gradle/

# TI-authored artifacts (runtime-lib .text extracts, dis2000 listings, our
# side-by-side dumps) generated at test time by the parity harnesses. Not
# redistributable under Apache-2.0 -- never commit these.
tests/ti_*.bin
tests/ti_*.txt
tests/*.sidebyside.txt

# Scratch reference extraction (full instruction detail is large; regenerate from PDF)
docs/c28x/ch6_instruction_detail.txt

# Firmware images + all derived dumps (large, regenerable from the signed bundle via
# bhx.py / dis2000 / sleigh). Blanket-ignore the whole dir — nothing in it is source.
firmware/

# Large extracted reference chapters (regenerate from spruhs1c/spru430f PDFs)
docs/c28x/vcu2_instructions.txt
docs/c28x/vcu1_instructions.txt
docs/c28x/fpu_instructions.txt
docs/c28x/vcrc_instructions.txt

# Scratch firmware-region test bins (keep only the canonical addr_modes/mov/etc.)
tests/code_region.bin
tests/immo_region.bin
tests/all_decode.bin

# Fresh-context handoff plan is kept privately in tm3diag (it references
# target-specific RE material); do not commit it to this public repo.
docs/PICKUP-PLAN.md

# P-code-gap analysis + pickup notes reference target-specific RE material
# (firmware functions, ECU names) — keep private, same as PICKUP-PLAN.md above.
docs/PCODE-GAPS.md
docs/PCODE-GAPS-PICKUP.md
docs/FPU-PCODE-SPEC.md
